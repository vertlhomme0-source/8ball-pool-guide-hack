<roblox version="4">
  <Item class="Folder" referent="0">
    <Properties>
      <string name="Name">WaterWars_Installation</string>
    </Properties>
    <Item class="Folder" referent="1">
      <Properties>
        <string name="Name">WaterWars</string>
      </Properties>
      <Item class="Folder" referent="2">
        <Properties>
          <string name="Name">Config</string>
        </Properties>
        <Item class="ModuleScript" referent="3">
          <Properties>
            <string name="Name">GameConfig</string>
            <string name="Source"><![CDATA[--[[
	GameConfig
	Toutes les constantes de reglage du jeu Water Wars.
	Modifier ce fichier suffit pour re-equilibrer la partie : aucun autre
	module ne contient de valeur "en dur".
]]

local GameConfig = {}

-- ============================ SERVEUR / LOBBY =============================
GameConfig.MaxPlayers = 20
GameConfig.MinPlayersToStart = 1 -- 1 pour pouvoir tester seul, mettre 2 en production

-- ============================== DEROULE DE PARTIE =========================
GameConfig.IntermissionTime = 25 -- secondes entre deux manches (vote de map)
GameConfig.RoundTime = 300 -- duree d'une manche
GameConfig.PostRoundTime = 12 -- ecran de fin de manche
GameConfig.RespawnTime = 5
GameConfig.SpawnProtectionTime = 3 -- invulnerabilite apres apparition

-- Score necessaire pour terminer une manche avant la fin du temps
GameConfig.ScoreLimit = {
	TeamSoak = 60,
	FreeForAll = 25,
	KingOfTheHill = 300, -- points de zone
}

-- ============================== EQUIPES ===================================
GameConfig.Teams = {
	{ id = "Blue", name = "Aqua Blue", color = Color3.fromRGB(45, 135, 255), brickColor = BrickColor.new("Bright blue") },
	{ id = "Red", name = "Splash Red", color = Color3.fromRGB(255, 80, 70), brickColor = BrickColor.new("Bright red") },
}

-- ============================== COMBAT ====================================
GameConfig.MaxHealth = 100
GameConfig.WalkSpeed = 18
GameConfig.SprintSpeed = 26
GameConfig.JumpPower = 52
GameConfig.StaminaMax = 100
GameConfig.StaminaDrain = 22 -- par seconde en sprint
GameConfig.StaminaRegen = 16 -- par seconde au repos
GameConfig.StaminaSprintMin = 12 -- stamina requise pour relancer un sprint

-- Regeneration de vie (comme dans la plupart des shooters arcade)
GameConfig.RegenDelay = 6 -- secondes sans degats avant regen
GameConfig.RegenRate = 9 -- points de vie par seconde

-- Anti-triche : distance max entre le personnage et l'origine du tir declare
GameConfig.MaxFireOriginDistance = 14
GameConfig.FireRateTolerance = 0.85 -- 15 % de marge reseau sur la cadence
GameConfig.MaxActiveProjectiles = 420 -- garde-fou de performance serveur

-- Recompenses
GameConfig.Rewards = {
	Hit = 1,
	Splash = 2, -- points marques par elimination (mode TeamSoak)
	Kill = 12, -- pieces gagnees par elimination
	Assist = 5,
	RoundWin = 60,
	RoundLoss = 25,
	CaptureTick = 2, -- pieces par tick de zone controlee
	StartingCoins = 250,
}

GameConfig.KillstreakBonus = { [3] = 15, [5] = 35, [8] = 70, [12] = 140 }

-- ============================== BIDONS D'EAU ==============================
GameConfig.RefillRadius = 9 -- distance a une station pour se recharger
GameConfig.RefillRate = 45 -- unites d'eau par seconde
GameConfig.RefillHealRate = 12 -- soin par seconde a la station

-- ============================== BONUS AU SOL ==============================
GameConfig.PowerupRespawn = 30
GameConfig.Powerups = {
	{ id = "Speed", name = "Turbo", color = Color3.fromRGB(255, 225, 60), duration = 12 },
	{ id = "Damage", name = "Haute pression", color = Color3.fromRGB(255, 110, 40), duration = 12 },
	{ id = "Shield", name = "Impermeable", color = Color3.fromRGB(120, 230, 255), duration = 10 },
	{ id = "Refill", name = "Citerne", color = Color3.fromRGB(80, 255, 140), duration = 0 },
}
GameConfig.PowerupSpeedMultiplier = 1.35
GameConfig.PowerupDamageMultiplier = 1.5
GameConfig.PowerupShieldReduction = 0.5

-- ============================== VOTE DE MAP ===============================
GameConfig.MapVoteChoices = 3
GameConfig.MapVoteTime = 18

-- ============================== MODES DE JEU ==============================
GameConfig.GameModes = {
	{
		id = "TeamSoak",
		name = "Bataille d'equipes",
		description = "Deux equipes, le premier camp a atteindre le score gagne.",
		teamBased = true,
		friendlyFire = false,
	},
	{
		id = "FreeForAll",
		name = "Chacun pour soi",
		description = "Tout le monde contre tout le monde. Le meilleur trempeur gagne.",
		teamBased = false,
		friendlyFire = true,
	},
	{
		id = "KingOfTheHill",
		name = "Roi de la piscine",
		description = "Controlez la zone centrale pour marquer des points.",
		teamBased = true,
		friendlyFire = false,
	},
}

-- Rotation des modes : un mode est tire au sort dans cette liste chaque manche
GameConfig.ModeRotation = { "TeamSoak", "TeamSoak", "KingOfTheHill", "FreeForAll" }

-- ============================== ZONE DE CONTROLE ==========================
GameConfig.HillRadius = 22
GameConfig.HillTickRate = 1 -- secondes entre deux points
GameConfig.HillPointsPerTick = 2
GameConfig.HillContestedNeeded = 1 -- joueurs necessaires pour capturer

-- ============================== SAUVEGARDE ================================
GameConfig.DataStoreName = "WaterWars_PlayerData_v1"
GameConfig.AutosaveInterval = 120

-- ============================== SONS ======================================
-- Uniquement des sons livres avec le client Roblox (rbxasset://) : aucun
-- upload necessaire, et aucun risque d'ID modere. Mettre "" pour desactiver.
GameConfig.Sounds = {
	Shoot = "rbxasset://sounds/impact_water.mp3",
	Hit = "rbxasset://sounds/impact_water.mp3",
	Splash = "rbxasset://sounds/impact_water.mp3",
	Eliminate = "rbxasset://sounds/electronicpingshort.wav",
	Reload = "rbxasset://sounds/switch3.wav",
	Purchase = "rbxasset://sounds/electronicpingshort.wav",
	RoundStart = "rbxasset://sounds/electronicpingshort.wav",
}

-- ============================== INTERFACE =================================
GameConfig.UI = {
	Accent = Color3.fromRGB(60, 190, 255),
	AccentDark = Color3.fromRGB(20, 90, 150),
	Panel = Color3.fromRGB(18, 24, 34),
	PanelLight = Color3.fromRGB(30, 40, 54),
	Text = Color3.fromRGB(235, 245, 255),
	TextDim = Color3.fromRGB(150, 170, 190),
	Good = Color3.fromRGB(80, 230, 140),
	Bad = Color3.fromRGB(255, 90, 90),
	Warn = Color3.fromRGB(255, 200, 70),
	Font = Enum.Font.GothamMedium,
	FontBold = Enum.Font.GothamBold,
}

-- ============================== TOUCHES ===================================
GameConfig.Keys = {
	Sprint = Enum.KeyCode.LeftShift,
	Reload = Enum.KeyCode.R,
	Shop = Enum.KeyCode.B,
	Scoreboard = Enum.KeyCode.Tab,
	Inspect = Enum.KeyCode.F,
}

table.freeze(GameConfig)
return GameConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="4">
          <Properties>
            <string name="Name">Maps</string>
            <string name="Source"><![CDATA[--[[
	Maps
	Index des 6 terrains. Pour ajouter une map : creer le module a cote de
	celui-ci puis l'ajouter a la liste ci-dessous. Le reste du jeu (vote,
	rotation, construction) s'adapte automatiquement.
]]

local Maps = {}

Maps.List = {
	require(script.Backyard),
	require(script.SplashBay),
	require(script.AquaPark),
	require(script.Rooftops),
	require(script.SunkenTemple),
	require(script.NeonArena),
}

Maps.ById = {}
for index, map in ipairs(Maps.List) do
	assert(Maps.ById[map.id] == nil, "Identifiant de map duplique : " .. tostring(map.id))
	map.order = index
	Maps.ById[map.id] = map
end

Maps.Count = #Maps.List

function Maps.Get(id)
	return Maps.ById[id]
end

--- Renvoie `count` maps au hasard, en excluant si possible `excludeId`.
function Maps.PickRandom(count, excludeId, rng)
	local pool = {}
	for _, map in ipairs(Maps.List) do
		if map.id ~= excludeId then
			table.insert(pool, map)
		end
	end
	if #pool == 0 then
		pool = table.clone(Maps.List)
	end
	for index = #pool, 2, -1 do
		local swap = rng and rng:NextInteger(1, index) or math.random(1, index)
		pool[index], pool[swap] = pool[swap], pool[index]
	end
	local chosen = {}
	for index = 1, math.min(count, #pool) do
		table.insert(chosen, pool[index])
	end
	return chosen
end

return Maps
]]></string>
          </Properties>
          <Item class="ModuleScript" referent="5">
            <Properties>
              <string name="Name">AquaPark</string>
              <string name="Source"><![CDATA[--[[
	Map 3/6 : Aqua Parc
	Un parc aquatique abandonne pour la journee. Deux tours de toboggans
	servent de bases et dominent une piscine a vagues centrale. Map tres
	verticale : les toboggans sont des raccourcis a sens unique vers le centre.
]]

local MAP_WIDTH = 310
local MAP_DEPTH = 250

local PAVEMENT = Color3.fromRGB(206, 202, 192)
local PAVEMENT_DARK = Color3.fromRGB(168, 164, 156)
local WATER = Color3.fromRGB(58, 172, 224)
local SLIDE_BLUE = Color3.fromRGB(64, 148, 238)
local SLIDE_RED = Color3.fromRGB(240, 96, 88)
local TOWER = Color3.fromRGB(236, 232, 222)

local function row(x, zCenter, count, spacing, y)
	local points = {}
	local start = zCenter - (count - 1) * spacing / 2
	for index = 1, count do
		table.insert(points, Vector3.new(x, y or 4, start + (index - 1) * spacing))
	end
	return points
end

local function concat(...)
	local out = {}
	for _, list in ipairs({ ... }) do
		for _, value in ipairs(list) do
			table.insert(out, value)
		end
	end
	return out
end

local Map = {}

Map.id = "aqua_park"
Map.name = "Aqua Parc"
Map.theme = "Parc aquatique"
Map.description = "Toboggans geants, piscine a vagues et passerelles suspendues. La map la plus verticale du jeu."
Map.size = Vector2.new(MAP_WIDTH, MAP_DEPTH)
Map.killY = -30
Map.skyColor = Color3.fromRGB(160, 210, 250)

Map.lighting = {
	ClockTime = 13,
	Brightness = 2.8,
	Ambient = Color3.fromRGB(128, 132, 138),
	OutdoorAmbient = Color3.fromRGB(160, 168, 178),
	FogColor = Color3.fromRGB(205, 228, 245),
	FogStart = 240,
	FogEnd = 780,
	ColorShift_Top = Color3.fromRGB(240, 250, 255),
}

Map.spawns = {
	Blue = concat(row(-132, -34, 6, 15), row(-132, 42, 6, 15)),
	Red = concat(row(132, -34, 6, 15), row(132, 42, 6, 15)),
	FFA = concat(
		row(-116, 0, 5, 24),
		row(116, 0, 5, 24),
		row(-48, -96, 3, 26),
		row(48, 96, 3, 26),
		row(48, -96, 2, 34),
		row(-48, 96, 2, 34)
	),
}

Map.controlPoint = Vector3.new(0, 9, 0)

Map.refillStations = {
	Vector3.new(-112, 0, 0),
	Vector3.new(112, 0, 0),
	Vector3.new(0, 0, -88),
	Vector3.new(0, 0, 88),
}

Map.powerupSpots = {
	Vector3.new(0, 20, 0),
	Vector3.new(-66, 2, -74),
	Vector3.new(66, 2, 74),
	Vector3.new(-66, 2, 74),
	Vector3.new(66, 2, -74),
}

function Map.build(b)
	-- --------------------------------------------------------------- dalles
	b:Ground(MAP_WIDTH, MAP_DEPTH, { color = PAVEMENT, material = Enum.Material.Pebble })
	b:Bounds(MAP_WIDTH, MAP_DEPTH, 200)

	-- Motif de dallage pour lire les distances au sol.
	for x = -6, 6 do
		b:Block(Vector3.new(x * 24, 0.08, 0), Vector3.new(2, 0.3, MAP_DEPTH - 30), {
			name = "Tile", color = PAVEMENT_DARK, material = Enum.Material.Concrete, castShadow = false,
		})
	end

	-- ------------------------------------------------ piscine a vagues
	b:Pool(Vector3.new(0, 1, 0), Vector3.new(120, 1, 76), {
		color = WATER, floorColor = Color3.fromRGB(120, 210, 235),
		rimColor = Color3.fromRGB(246, 244, 236), depth = 5,
	})

	-- Ile centrale : le point de controle, accessible par quatre rampes.
	b:Block(Vector3.new(0, 4, 0), Vector3.new(46, 8, 40), {
		name = "Island", color = Color3.fromRGB(226, 216, 186), material = Enum.Material.Sandstone,
	})
	b:Block(Vector3.new(0, 8.5, 0), Vector3.new(30, 1, 24), {
		name = "IslandTop", color = Color3.fromRGB(240, 232, 206), material = Enum.Material.Sandstone,
	})
	b:Mirror(function(side)
		b:Ramp(Vector3.new(side * 34, 0.5, 0), 16, 24, 8, side > 0 and 90 or 270, {
			color = Color3.fromRGB(216, 206, 178), material = Enum.Material.Sandstone,
		})
		-- Parasol central : bloque les tirs en cloche sur le point.
		b:Block(Vector3.new(side * 12, 13, 0), Vector3.new(1, 8, 1), {
			name = "Pole", color = Color3.fromRGB(220, 220, 215), material = Enum.Material.Metal,
		})
		b:Cylinder(
			CFrame.new(side * 12, 17.5, 0) * CFrame.Angles(0, 0, math.rad(90)),
			Vector3.new(1, 22, 22),
			{ name = "Canopy", color = Color3.fromRGB(80, 200, 220), material = Enum.Material.Fabric, canCollide = false }
		)
	end)

	-- ----------------------------------------- tours de toboggans (bases)
	b:Mirror(function(side)
		local baseX = side * 126
		local slideColor = side < 0 and SLIDE_BLUE or SLIDE_RED

		-- Tour a trois niveaux.
		b:Tower(Vector3.new(baseX, 0, 4), 22, 42, {
			color = TOWER, railColor = Color3.fromRGB(190, 190, 185),
			pillarColor = Color3.fromRGB(150, 150, 148), levels = 3,
		})
		-- Escaliers exterieurs entre les niveaux.
		for level = 1, 3 do
			local y = (42 / 3) * (level - 1)
			b:Stairs(Vector3.new(baseX + side * 26, y, 4), 12, 22, 14, 7, side > 0 and 90 or 270, {
				color = PAVEMENT_DARK, material = Enum.Material.Concrete,
			})
			b:Block(Vector3.new(baseX + side * 26, y + 14.5, 4), Vector3.new(14, 1, 14), {
				name = "Landing", color = TOWER, material = Enum.Material.Concrete,
			})
		end

		-- Deux toboggans qui plongent vers le centre : descente rapide.
		for _, z in ipairs({ -16, 24 }) do
			local segments = 5
			for index = 1, segments do
				local progress = index / segments
				local x = baseX - side * (18 + progress * 62)
				local y = 40 - progress * 34
				b:Cylinder(
					CFrame.new(x, y, z + progress * 8) * CFrame.Angles(0, math.rad(side * 90), math.rad(90)),
					Vector3.new(16, 13, 13),
					{ name = "SlideTube", color = slideColor, material = Enum.Material.Plastic, transparency = 0.25 }
				)
				b:Block(Vector3.new(x, y - 6, z + progress * 8), Vector3.new(2, 12, 2), {
					name = "SlideSupport", color = Color3.fromRGB(170, 170, 168), material = Enum.Material.Metal,
				})
			end
		end

		-- Bassin de reception a la sortie des toboggans.
		b:Pool(Vector3.new(baseX - side * 86, 1, 4), Vector3.new(34, 1, 50), {
			color = WATER, floorColor = Color3.fromRGB(140, 215, 235),
			rimColor = Color3.fromRGB(240, 238, 230), depth = 3,
		})

		-- Kiosque : couverture au sol devant la base.
		b:Building(Vector3.new(baseX - side * 40, 0, -66), Vector3.new(28, 13, 24), {
			color = Color3.fromRGB(240, 226, 180), material = Enum.Material.Concrete,
			roofColor = slideColor, openings = { north = true, south = true },
			doorWidth = 10, doorHeight = 9,
		})
		b:Sign(Vector3.new(baseX - side * 40, 16, -78), side < 0 and "AQUA BLEU" or "AQUA ROUGE", {
			size = Vector3.new(22, 5, 0.8),
			textColor = slideColor,
		})

		-- Transats et bouees.
		for index = 1, 4 do
			b:Block(
				CFrame.new(baseX - side * 62, 1.5, -30 + index * 22) * CFrame.Angles(0, math.rad(side * 15), 0),
				Vector3.new(12, 3, 5),
				{ name = "DeckChair", color = Color3.fromRGB(246, 246, 240), material = Enum.Material.Plastic }
			)
		end
		b:Crates(Vector3.new(baseX - side * 30, 0, 74), 4, 16, { maxStack = 2, color = Color3.fromRGB(200, 200, 195) })
	end)

	-- --------------------------------------------- riviere et passerelles
	b:Mirror(function(side)
		-- Riviere lente : couloir lateral abrite.
		b:Block(Vector3.new(0, 0.1, side * 86), Vector3.new(210, 0.5, 26), {
			name = "RiverBed", color = Color3.fromRGB(120, 200, 220), material = Enum.Material.Pebble, castShadow = false,
		})
		b:Block(Vector3.new(0, 0.7, side * 86), Vector3.new(210, 0.6, 24), {
			name = "River", color = WATER, material = Enum.Material.Glass,
			transparency = 0.4, canCollide = false, castShadow = false, reflectance = 0.2,
		})
		b:Mirror(function(inner)
			b:Block(Vector3.new(inner * 106, 1.5, side * 86), Vector3.new(4, 3, 26), {
				name = "RiverEnd", color = PAVEMENT_DARK, material = Enum.Material.Concrete,
			})
		end)

		-- Passerelle suspendue au-dessus de la riviere.
		b:Bridge(Vector3.new(-92, 20, side * 86), Vector3.new(92, 20, side * 86), 14, {
			color = Color3.fromRGB(200, 198, 190), railColor = Color3.fromRGB(150, 150, 148),
			material = Enum.Material.Metal,
		})
		b:Mirror(function(inner)
			b:Stairs(Vector3.new(inner * 100, 0, side * 86), 12, 30, 20, 8, inner > 0 and 90 or 270, {
				color = PAVEMENT_DARK, material = Enum.Material.Metal,
			})
		end)

		-- Mur d'eau decoratif reliant la passerelle au centre.
		b:Block(Vector3.new(side * 60, 6, side * 46), Vector3.new(30, 12, 3), {
			name = "Screen", color = Color3.fromRGB(180, 225, 240), material = Enum.Material.Glass,
			transparency = 0.5, rotation = Vector3.new(0, side * 35, 0),
		})
	end)

	-- Machinerie centrale : couverture au bord de la piscine.
	b:Mirror(function(side)
		b:Block(Vector3.new(side * 76, 5, 0), Vector3.new(16, 10, 30), {
			name = "PumpHouse", color = Color3.fromRGB(150, 156, 164), material = Enum.Material.DiamondPlate,
		})
		b:Cylinder(
			CFrame.new(side * 76, 12, 0) * CFrame.Angles(0, 0, math.rad(90)),
			Vector3.new(30, 8, 8),
			{ name = "Pipe", color = Color3.fromRGB(120, 128, 138), material = Enum.Material.Metal }
		)
	end)
end

return Map
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="6">
            <Properties>
              <string name="Name">Backyard</string>
              <string name="Source"><![CDATA[--[[
	Map 1/6 : Jardin d'Ete
	Une grande bataille d'arriere-cour : deux maisons face a face, une piscine
	centrale, du mobilier de jardin en guise de couverture. Map d'initiation :
	lisible, ouverte, avec des angles courts et un centre disputable.
]]

local MAP_WIDTH = 320
local MAP_DEPTH = 230

local GRASS = Color3.fromRGB(96, 152, 82)
local GRASS_DARK = Color3.fromRGB(78, 128, 68)
local DECK = Color3.fromRGB(186, 148, 104)
local HOUSE_BLUE = Color3.fromRGB(196, 214, 236)
local HOUSE_RED = Color3.fromRGB(236, 196, 190)
local ROOF = Color3.fromRGB(122, 74, 62)

--- Genere une ligne de points d'apparition alignes sur Z.
local function row(x, zCenter, count, spacing, y)
	local points = {}
	local start = zCenter - (count - 1) * spacing / 2
	for index = 1, count do
		table.insert(points, Vector3.new(x, y or 4, start + (index - 1) * spacing))
	end
	return points
end

local function concat(...)
	local out = {}
	for _, list in ipairs({ ... }) do
		for _, value in ipairs(list) do
			table.insert(out, value)
		end
	end
	return out
end

local Map = {}

Map.id = "backyard"
Map.name = "Jardin d'Ete"
Map.theme = "Banlieue ensoleillee"
Map.description = "Deux maisons, une piscine au milieu et beaucoup de mobilier de jardin. La map parfaite pour apprendre le jeu."
Map.size = Vector2.new(MAP_WIDTH, MAP_DEPTH)
Map.killY = -35
Map.skyColor = Color3.fromRGB(150, 205, 255)

Map.lighting = {
	ClockTime = 14,
	Brightness = 2.6,
	Ambient = Color3.fromRGB(120, 125, 130),
	OutdoorAmbient = Color3.fromRGB(150, 160, 170),
	FogColor = Color3.fromRGB(190, 220, 245),
	FogStart = 220,
	FogEnd = 700,
	ColorShift_Top = Color3.fromRGB(255, 240, 210),
}

Map.spawns = {
	Blue = concat(row(-138, -20, 6, 14), row(-138, 52, 6, 14)),
	Red = concat(row(138, -20, 6, 14), row(138, 52, 6, 14)),
	FFA = concat(
		row(-120, 0, 5, 22),
		row(120, 0, 5, 22),
		row(-45, -85, 3, 26),
		row(45, 85, 3, 26),
		row(0, -95, 2, 40),
		row(0, 95, 2, 40)
	),
}

Map.controlPoint = Vector3.new(0, 3, 0)

Map.refillStations = {
	Vector3.new(-118, 0, 0),
	Vector3.new(118, 0, 0),
	Vector3.new(0, 0, -78),
	Vector3.new(0, 0, 78),
}

Map.powerupSpots = {
	Vector3.new(0, 12, 0),
	Vector3.new(-62, 2, -62),
	Vector3.new(62, 2, 62),
	Vector3.new(-62, 2, 62),
	Vector3.new(62, 2, -62),
}

function Map.build(b)
	-- ----------------------------------------------------------------- sol
	b:Ground(MAP_WIDTH, MAP_DEPTH, { color = GRASS, material = Enum.Material.Grass })
	b:Bounds(MAP_WIDTH, MAP_DEPTH, 160)

	-- Allee centrale en dalles, elle guide le joueur vers le point chaud.
	b:Block(Vector3.new(0, 0.1, 0), Vector3.new(36, 0.4, MAP_DEPTH - 40), {
		name = "Path", color = Color3.fromRGB(205, 200, 185), material = Enum.Material.Concrete, castShadow = false,
	})

	-- ------------------------------------------------------------- piscine
	b:Block(Vector3.new(0, 0.3, 0), Vector3.new(96, 0.6, 62), {
		name = "PoolDeck", color = DECK, material = Enum.Material.WoodPlanks,
	})
	b:Pool(Vector3.new(0, 0.6, 0), Vector3.new(70, 1, 42), {
		color = Color3.fromRGB(64, 176, 226),
		floorColor = Color3.fromRGB(120, 205, 225),
		rimColor = Color3.fromRGB(238, 236, 226),
		depth = 4,
	})

	-- Plongeoir central : le point haut le plus expose de la map.
	b:Block(Vector3.new(0, 5, 0), Vector3.new(22, 1, 14), {
		name = "DivingPlatform", color = Color3.fromRGB(235, 235, 230), material = Enum.Material.Concrete,
	})
	b:Mirror(function(side)
		b:Block(Vector3.new(side * 9, 2.5, 0), Vector3.new(2, 5, 12), {
			name = "PlatformLeg", color = Color3.fromRGB(180, 180, 175), material = Enum.Material.Metal,
		})
		b:Ramp(Vector3.new(side * 20, 0.5, 0), 10, 14, 4.5, side > 0 and 90 or 270, {
			color = Color3.fromRGB(225, 225, 220),
		})
	end)

	-- --------------------------------------------------- maisons (2 bases)
	b:Mirror(function(side)
		local baseX = side * 122
		local houseColor = side < 0 and HOUSE_BLUE or HOUSE_RED

		b:Building(Vector3.new(baseX, 0, 16), Vector3.new(58, 18, 74), {
			color = houseColor,
			material = Enum.Material.Brick,
			roofColor = ROOF,
			floorColor = Color3.fromRGB(150, 122, 96),
			openings = { north = true, south = true, east = side < 0, west = side > 0 },
			doorWidth = 14,
			doorHeight = 11,
			wallThickness = 2,
		})

		-- Terrasse et marches devant la maison, cote terrain.
		local porchX = baseX - side * 38
		b:Block(Vector3.new(porchX, 1, 16), Vector3.new(20, 2, 58), {
			name = "Porch", color = DECK, material = Enum.Material.WoodPlanks,
		})
		b:Stairs(Vector3.new(porchX - side * 13, 0, 16), 24, 8, 2, 4, side > 0 and 90 or 270, {
			color = DECK, material = Enum.Material.WoodPlanks,
		})

		-- Toit accessible : une echelle de caisses puis un poste de tir.
		b:Crates(Vector3.new(baseX - side * 34, 0, -26), 3, 8, { maxStack = 3, size = 6 })
		b:Platform(Vector3.new(baseX, 19.5, 16), Vector3.new(50, 1, 62), {
			name = "RoofDeck", color = ROOF, material = Enum.Material.Slate,
		})
		b:Mirror(function(inner)
			b:Block(Vector3.new(baseX + inner * 24, 21.5, 16), Vector3.new(2, 4, 62), {
				name = "RoofRail", color = Color3.fromRGB(96, 60, 50), material = Enum.Material.Slate,
			})
		end)

		-- Cabane de jardin : couverture avancee sur un flanc.
		b:Building(Vector3.new(baseX - side * 50, 0, -72), Vector3.new(26, 12, 22), {
			color = Color3.fromRGB(150, 118, 88),
			material = Enum.Material.WoodPlanks,
			roofColor = Color3.fromRGB(90, 70, 55),
			openings = { north = true, south = true },
			doorWidth = 8,
			doorHeight = 8,
		})

		-- Trampoline : saut d'attaque vers le centre.
		b:Cylinder(
			CFrame.new(baseX - side * 62, 3, 66) * CFrame.Angles(0, 0, math.rad(90)),
			Vector3.new(3, 26, 26),
			{ name = "Trampoline", color = Color3.fromRGB(40, 44, 58), material = Enum.Material.Fabric }
		)
		b:Cylinder(
			CFrame.new(baseX - side * 62, 1.5, 66) * CFrame.Angles(0, 0, math.rad(90)),
			Vector3.new(3, 30, 30),
			{ name = "TrampolineFrame", color = Color3.fromRGB(70, 130, 200), material = Enum.Material.Metal }
		)

		-- Haies et mobilier pour casser les lignes de tir.
		b:Block(Vector3.new(baseX - side * 62, 2.5, -20), Vector3.new(6, 5, 40), {
			name = "Hedge", color = GRASS_DARK, material = Enum.Material.Grass,
		})
		b:Block(Vector3.new(baseX - side * 72, 2, 34), Vector3.new(5, 4, 30), {
			name = "Hedge", color = GRASS_DARK, material = Enum.Material.Grass,
		})

		-- Table de jardin renversee, couverture basse.
		b:Block(Vector3.new(baseX - side * 80, 2, -48), Vector3.new(14, 4, 8), {
			name = "Table", color = Color3.fromRGB(215, 210, 200), material = Enum.Material.Plastic,
			rotation = Vector3.new(0, 25 * side, 0),
		})
	end)

	-- ------------------------------------------- flancs : jeu exterieur
	b:Mirror(function(side)
		-- Terrasse laterale surelevee reliant les deux moities du terrain.
		b:Platform(Vector3.new(0, 8, side * 84), Vector3.new(120, 1.2, 26), {
			name = "SideDeck", color = DECK, material = Enum.Material.WoodPlanks, legs = true,
		})
		b:Mirror(function(inner)
			b:Ramp(Vector3.new(inner * 70, 0, side * 84), 22, 26, 8, inner > 0 and 90 or 270, {
				color = DECK, material = Enum.Material.WoodPlanks,
			})
			b:Block(Vector3.new(inner * 58, 10.5, side * 84), Vector3.new(4, 4, 26), {
				name = "DeckRail", color = Color3.fromRGB(150, 118, 84), material = Enum.Material.WoodPlanks,
			})
		end)

		-- Barbecue et caisses sous la terrasse.
		b:Block(Vector3.new(side * 26, 2, side * 62), Vector3.new(10, 4, 7), {
			name = "Grill", color = Color3.fromRGB(45, 48, 55), material = Enum.Material.Metal,
		})
		b:Crates(Vector3.new(-side * 34, 0, side * 58), 4, 16, { maxStack = 2 })
		b:Crates(Vector3.new(side * 50, 0, side * 40), 3, 14, { maxStack = 2, color = Color3.fromRGB(150, 110, 60) })
	end)

	-- ------------------------------------------------------- vegetation
	local treeSpots = {
		Vector3.new(-88, 0, -92), Vector3.new(88, 0, 92),
		Vector3.new(-88, 0, 92), Vector3.new(88, 0, -92),
		Vector3.new(-30, 0, -100), Vector3.new(30, 0, 100),
		Vector3.new(-150, 0, -95), Vector3.new(150, 0, 95),
	}
	for index, spot in ipairs(treeSpots) do
		b:Tree(spot, 1 + (index % 3) * 0.18, {
			leafColor = index % 2 == 0 and Color3.fromRGB(74, 146, 74) or Color3.fromRGB(88, 160, 78),
		})
	end

	-- Cloture peripherique, purement visuelle (les limites sont invisibles).
	local halfWidth = MAP_WIDTH / 2 - 8
	local halfDepth = MAP_DEPTH / 2 - 8
	b:Fence(Vector3.new(-halfWidth, 0, -halfDepth), Vector3.new(halfWidth, 0, -halfDepth), 12)
	b:Fence(Vector3.new(-halfWidth, 0, halfDepth), Vector3.new(halfWidth, 0, halfDepth), 12)
	b:Fence(Vector3.new(-halfWidth, 0, -halfDepth), Vector3.new(-halfWidth, 0, halfDepth), 12)
	b:Fence(Vector3.new(halfWidth, 0, -halfDepth), Vector3.new(halfWidth, 0, halfDepth), 12)
end

return Map
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="7">
            <Properties>
              <string name="Name">NeonArena</string>
              <string name="Source"><![CDATA[--[[
	Map 6/6 : Arene Neon
	Arene futuriste parfaitement symetrique, sans decor superflu : plateformes
	flottantes, passerelles de verre et un anneau central sureleve. C'est la map
	competitive du lot, pensee pour les duels et le mode Roi de la piscine.
]]

local MAP_WIDTH = 280
local MAP_DEPTH = 230

local FLOOR = Color3.fromRGB(28, 32, 44)
local FLOOR_LIGHT = Color3.fromRGB(42, 48, 64)
local GLASS = Color3.fromRGB(150, 220, 255)
local NEON_BLUE = Color3.fromRGB(70, 190, 255)
local NEON_RED = Color3.fromRGB(255, 90, 110)
local NEON_CYAN = Color3.fromRGB(90, 255, 230)

local function row(x, zCenter, count, spacing, y)
	local points = {}
	local start = zCenter - (count - 1) * spacing / 2
	for index = 1, count do
		table.insert(points, Vector3.new(x, y or 4, start + (index - 1) * spacing))
	end
	return points
end

local function concat(...)
	local out = {}
	for _, list in ipairs({ ... }) do
		for _, value in ipairs(list) do
			table.insert(out, value)
		end
	end
	return out
end

local Map = {}

Map.id = "neon_arena"
Map.name = "Arene Neon"
Map.theme = "Stade futuriste"
Map.description = "Une arene symetrique en verre et en neon, sans angle mort. Terrain de reference pour les duels et les tournois."
Map.size = Vector2.new(MAP_WIDTH, MAP_DEPTH)
Map.killY = -40
Map.skyColor = Color3.fromRGB(20, 24, 40)

Map.lighting = {
	ClockTime = 0.5,
	Brightness = 1.4,
	Ambient = Color3.fromRGB(70, 78, 98),
	OutdoorAmbient = Color3.fromRGB(58, 66, 88),
	FogColor = Color3.fromRGB(24, 30, 48),
	FogStart = 90,
	FogEnd = 480,
	ColorShift_Top = Color3.fromRGB(120, 160, 255),
}

Map.spawns = {
	Blue = concat(row(-116, -28, 6, 14, 14), row(-116, 40, 6, 14, 14)),
	Red = concat(row(116, -28, 6, 14, 14), row(116, 40, 6, 14, 14)),
	FFA = concat(
		row(-100, 0, 5, 22, 14),
		row(100, 0, 5, 22, 14),
		row(-44, -80, 3, 24, 4),
		row(44, 80, 3, 24, 4),
		row(44, -80, 2, 30, 4),
		row(-44, 80, 2, 30, 4)
	),
}

Map.controlPoint = Vector3.new(0, 18, 0)

Map.refillStations = {
	Vector3.new(-104, 12, 6),
	Vector3.new(104, 12, 6),
	Vector3.new(0, 0, -72),
	Vector3.new(0, 0, 72),
}

Map.powerupSpots = {
	Vector3.new(0, 28, 0),
	Vector3.new(-58, 2, -58),
	Vector3.new(58, 2, 58),
	Vector3.new(-58, 2, 58),
	Vector3.new(58, 2, -58),
}

function Map.build(b)
	-- --------------------------------------------------------------- sol
	b:Ground(MAP_WIDTH, MAP_DEPTH, { color = FLOOR, material = Enum.Material.Metal })
	b:Bounds(MAP_WIDTH, MAP_DEPTH, 220)

	-- Grille lumineuse au sol : repere visuel des distances.
	for index = -6, 6 do
		b:Block(Vector3.new(index * 22, 0.1, 0), Vector3.new(1.2, 0.3, MAP_DEPTH - 30), {
			name = "GridLine", color = NEON_CYAN, material = Enum.Material.Neon,
			canCollide = false, castShadow = false, transparency = 0.3,
		})
	end
	for index = -5, 5 do
		b:Block(Vector3.new(0, 0.1, index * 22), Vector3.new(MAP_WIDTH - 30, 0.3, 1.2), {
			name = "GridLine", color = NEON_CYAN, material = Enum.Material.Neon,
			canCollide = false, castShadow = false, transparency = 0.3,
		})
	end

	-- Mur d'enceinte lumineux.
	b:Mirror(function(side)
		b:Block(Vector3.new(side * (MAP_WIDTH / 2 - 4), 20, 0), Vector3.new(6, 40, MAP_DEPTH), {
			name = "ArenaWall", color = FLOOR_LIGHT, material = Enum.Material.Metal,
		})
		b:Block(Vector3.new(side * (MAP_WIDTH / 2 - 7.5), 30, 0), Vector3.new(1, 3, MAP_DEPTH), {
			name = "WallStrip", color = side < 0 and NEON_BLUE or NEON_RED, material = Enum.Material.Neon,
			canCollide = false, castShadow = false,
		})
		b:Block(Vector3.new(0, 20, side * (MAP_DEPTH / 2 - 4)), Vector3.new(MAP_WIDTH, 40, 6), {
			name = "ArenaWall", color = FLOOR_LIGHT, material = Enum.Material.Metal,
		})
		b:Block(Vector3.new(0, 30, side * (MAP_DEPTH / 2 - 7.5)), Vector3.new(MAP_WIDTH, 3, 1), {
			name = "WallStrip", color = NEON_CYAN, material = Enum.Material.Neon,
			canCollide = false, castShadow = false,
		})
	end)

	-- ------------------------------------------------------ anneau central
	-- Trois niveaux concentriques : plus on monte, plus on est expose.
	b:Cylinder(
		CFrame.new(0, 4, 0) * CFrame.Angles(0, 0, math.rad(90)),
		Vector3.new(8, 96, 96),
		{ name = "RingBase", color = FLOOR_LIGHT, material = Enum.Material.Metal }
	)
	b:Cylinder(
		CFrame.new(0, 11, 0) * CFrame.Angles(0, 0, math.rad(90)),
		Vector3.new(6, 68, 68),
		{ name = "RingMid", color = Color3.fromRGB(52, 58, 76), material = Enum.Material.Metal }
	)
	b:Cylinder(
		CFrame.new(0, 17, 0) * CFrame.Angles(0, 0, math.rad(90)),
		Vector3.new(6, 44, 44),
		{ name = "RingTop", color = Color3.fromRGB(64, 70, 92), material = Enum.Material.DiamondPlate }
	)
	b:Cylinder(
		CFrame.new(0, 20.4, 0) * CFrame.Angles(0, 0, math.rad(90)),
		Vector3.new(0.6, 40, 40),
		{ name = "RingGlow", color = NEON_CYAN, material = Enum.Material.Neon, canCollide = false, castShadow = false }
	)

	-- Quatre rampes d'acces a 45 degres : aucun cote n'est avantage.
	for index = 0, 3 do
		local angle = math.rad(45 + index * 90)
		local distance = 58
		local x = math.cos(angle) * distance
		local z = math.sin(angle) * distance
		b:Ramp(Vector3.new(x, 0, z), 18, 40, 8, math.deg(-angle) + 90, {
			color = Color3.fromRGB(60, 66, 86), material = Enum.Material.DiamondPlate,
		})
		b:Block(Vector3.new(x * 0.62, 12, z * 0.62), Vector3.new(14, 0.8, 14), {
			name = "RingStep", color = Color3.fromRGB(70, 78, 100), material = Enum.Material.DiamondPlate,
			rotation = Vector3.new(0, math.deg(-angle), 0),
		})
	end

	-- Colonne centrale : couverture au coeur du point.
	b:Cylinder(
		CFrame.new(0, 26, 0) * CFrame.Angles(0, 0, math.rad(90)),
		Vector3.new(14, 12, 12),
		{ name = "CorePillar", color = Color3.fromRGB(40, 46, 62), material = Enum.Material.Metal }
	)
	b:Sphere(Vector3.new(0, 34, 0), 10, {
		name = "Core", color = NEON_CYAN, material = Enum.Material.Neon, canCollide = false,
	})

	-- -------------------------------------------------- bases surelevees
	b:Mirror(function(side)
		local baseX = side * 108
		local accent = side < 0 and NEON_BLUE or NEON_RED

		-- Plateforme de depart en surplomb.
		b:Platform(Vector3.new(baseX, 12, 6), Vector3.new(56, 2, 110), {
			name = "BasePlatform", color = Color3.fromRGB(46, 52, 70), material = Enum.Material.DiamondPlate, legs = true,
		})
		b:Block(Vector3.new(baseX + side * 27, 16, 6), Vector3.new(2, 6, 110), {
			name = "BaseRail", color = accent, material = Enum.Material.Neon, castShadow = false,
		})
		b:Mirror(function(inner)
			b:Block(Vector3.new(baseX, 16, 6 + inner * 54), Vector3.new(56, 6, 2), {
				name = "BaseRail", color = accent, material = Enum.Material.Neon, castShadow = false,
			})
			-- Rampes de sortie vers le sol.
			b:Ramp(Vector3.new(baseX - side * 40, 0, 6 + inner * 40), 16, 32, 13, side > 0 and 90 or 270, {
				color = Color3.fromRGB(56, 62, 82), material = Enum.Material.DiamondPlate,
			})
		end)

		-- Auvent : protege la base des tirs en cloche.
		b:Block(Vector3.new(baseX, 30, 6), Vector3.new(60, 1.5, 114), {
			name = "BaseCanopy", color = Color3.fromRGB(36, 42, 58), material = Enum.Material.Metal,
		})
		for index = -2, 2 do
			b:Block(Vector3.new(baseX + side * 24, 21, 6 + index * 26), Vector3.new(2, 18, 2), {
				name = "CanopyPost", color = Color3.fromRGB(60, 66, 86), material = Enum.Material.Metal,
			})
		end

		-- Blocs de couverture sur la plateforme.
		for index = -1, 1 do
			b:Block(Vector3.new(baseX - side * 14, 15.5, 6 + index * 34), Vector3.new(10, 5, 14), {
				name = "Cover", color = Color3.fromRGB(58, 64, 84), material = Enum.Material.Metal,
			})
		end

		-- Piliers lumineux de flanc, couverture verticale au sol.
		for index = -2, 2 do
			if index ~= 0 then
				b:Block(Vector3.new(side * 66, 9, index * 34), Vector3.new(9, 18, 9), {
					name = "Pylon", color = FLOOR_LIGHT, material = Enum.Material.Metal,
				})
				b:Block(Vector3.new(side * 66, 19, index * 34), Vector3.new(6, 3, 6), {
					name = "PylonLight", color = NEON_CYAN, material = Enum.Material.Neon, castShadow = false,
				})
			end
		end
	end)

	-- ----------------------------------------------- passerelles de verre
	b:Mirror(function(side)
		-- Deux longues passerelles laterales reliant les bases par l'exterieur.
		b:Block(Vector3.new(0, 22, side * 76), Vector3.new(190, 1, 16), {
			name = "GlassWalk", color = GLASS, material = Enum.Material.Glass,
			transparency = 0.45, reflectance = 0.2,
		})
		b:Mirror(function(inner)
			b:Block(Vector3.new(inner * 95, 24.5, side * 76), Vector3.new(6, 6, 16), {
				name = "WalkAnchor", color = FLOOR_LIGHT, material = Enum.Material.Metal,
			})
			b:Ramp(Vector3.new(inner * 78, 14, side * 76), 14, 26, 8, inner > 0 and 90 or 270, {
				color = Color3.fromRGB(56, 62, 82), material = Enum.Material.DiamondPlate,
			})
		end)
		b:Block(Vector3.new(0, 25, side * 83.5), Vector3.new(190, 5, 1), {
			name = "WalkRail", color = NEON_CYAN, material = Enum.Material.Neon, castShadow = false,
		})

		-- Plateformes flottantes intermediaires : chemin vertical vers le centre.
		for index = -1, 1, 2 do
			b:Platform(Vector3.new(index * 46, 15, side * 44), Vector3.new(24, 1.2, 24), {
				name = "FloatPad", color = Color3.fromRGB(50, 56, 74), material = Enum.Material.DiamondPlate,
			})
			b:Block(Vector3.new(index * 46, 14.2, side * 44), Vector3.new(20, 0.5, 20), {
				name = "PadGlow", color = index < 0 and NEON_BLUE or NEON_RED, material = Enum.Material.Neon,
				canCollide = false, castShadow = false,
			})
		end

		-- Blocs de couverture bas repartis symetriquement.
		for index = -1, 1 do
			b:Block(Vector3.new(index * 34, 3, side * 30), Vector3.new(14, 6, 10), {
				name = "Cover", color = FLOOR_LIGHT, material = Enum.Material.Metal,
			})
		end
	end)
end

return Map
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="8">
            <Properties>
              <string name="Name">Rooftops</string>
              <string name="Source"><![CDATA[--[[
	Map 4/6 : Toits de la Ville
	Combat sur deux etages : des ruelles etroites au niveau de la rue et un
	reseau de toits relies par des planches. Chaque base possede son propre
	acces au toit, mais le centre ne se tient qu'en hauteur.
]]

local MAP_WIDTH = 300
local MAP_DEPTH = 240

local ASPHALT = Color3.fromRGB(62, 64, 70)
local ROOF = Color3.fromRGB(96, 98, 106)
local BRICK_A = Color3.fromRGB(152, 96, 82)
local BRICK_B = Color3.fromRGB(122, 124, 132)
local METAL = Color3.fromRGB(138, 142, 150)
local NEON_BLUE = Color3.fromRGB(70, 180, 255)
local NEON_RED = Color3.fromRGB(255, 96, 90)

local ROOF_Y = 46

local function row(x, zCenter, count, spacing, y)
	local points = {}
	local start = zCenter - (count - 1) * spacing / 2
	for index = 1, count do
		table.insert(points, Vector3.new(x, y or 4, start + (index - 1) * spacing))
	end
	return points
end

local function concat(...)
	local out = {}
	for _, list in ipairs({ ... }) do
		for _, value in ipairs(list) do
			table.insert(out, value)
		end
	end
	return out
end

local Map = {}

Map.id = "rooftops"
Map.name = "Toits de la Ville"
Map.theme = "Ville au crepuscule"
Map.description = "Ruelles sombres au sol, passerelles et chateaux d'eau sur les toits. Deux etages de jeu totalement differents."
Map.size = Vector2.new(MAP_WIDTH, MAP_DEPTH)
Map.killY = -25
Map.skyColor = Color3.fromRGB(70, 90, 130)

Map.lighting = {
	ClockTime = 18.6,
	Brightness = 1.9,
	Ambient = Color3.fromRGB(88, 92, 108),
	OutdoorAmbient = Color3.fromRGB(110, 118, 140),
	FogColor = Color3.fromRGB(90, 105, 135),
	FogStart = 140,
	FogEnd = 560,
	ColorShift_Top = Color3.fromRGB(255, 180, 140),
}

Map.spawns = {
	Blue = concat(row(-126, -40, 6, 16, 4), row(-126, 40, 6, 16, ROOF_Y + 4)),
	Red = concat(row(126, -40, 6, 16, 4), row(126, 40, 6, 16, ROOF_Y + 4)),
	FFA = concat(
		row(-110, 0, 4, 26, 4),
		row(110, 0, 4, 26, 4),
		row(-58, -70, 3, 28, ROOF_Y + 4),
		row(58, 70, 3, 28, ROOF_Y + 4),
		row(-58, 70, 3, 28, 4),
		row(58, -70, 3, 28, 4)
	),
}

Map.controlPoint = Vector3.new(0, ROOF_Y + 6, 0)

Map.refillStations = {
	Vector3.new(-118, 0, 0),
	Vector3.new(118, 0, 0),
	Vector3.new(-40, ROOF_Y, 0),
	Vector3.new(40, ROOF_Y, 0),
}

Map.powerupSpots = {
	Vector3.new(0, ROOF_Y + 14, 0),
	Vector3.new(0, 3, -76),
	Vector3.new(0, 3, 76),
	Vector3.new(-78, ROOF_Y + 3, -60),
	Vector3.new(78, ROOF_Y + 3, 60),
}

function Map.build(b)
	-- ------------------------------------------------------------- la rue
	b:Ground(MAP_WIDTH, MAP_DEPTH, { color = ASPHALT, material = Enum.Material.Asphalt })
	b:Bounds(MAP_WIDTH, MAP_DEPTH, 220)

	-- Marquage au sol de l'avenue centrale.
	for index = -7, 7 do
		b:Block(Vector3.new(index * 20, 0.06, 0), Vector3.new(12, 0.2, 2), {
			name = "RoadLine", color = Color3.fromRGB(226, 216, 150), material = Enum.Material.Concrete, castShadow = false,
		})
	end

	-- ------------------------------------------------- immeubles centraux
	-- Quatre blocs d'immeubles forment une croix de ruelles au sol
	-- et une plateforme continue sur les toits.
	local blocks = {
		{ x = -46, z = -52, sx = 72, sz = 62, color = BRICK_A },
		{ x = 46, z = -52, sx = 72, sz = 62, color = BRICK_B },
		{ x = -46, z = 52, sx = 72, sz = 62, color = BRICK_B },
		{ x = 46, z = 52, sx = 72, sz = 62, color = BRICK_A },
	}
	for _, block in ipairs(blocks) do
		b:Block(Vector3.new(block.x, ROOF_Y / 2, block.z), Vector3.new(block.sx, ROOF_Y, block.sz), {
			name = "Building", color = block.color, material = Enum.Material.Brick,
		})
		-- Corniche et toit.
		b:Block(Vector3.new(block.x, ROOF_Y + 0.5, block.z), Vector3.new(block.sx + 3, 1, block.sz + 3), {
			name = "RoofSlab", color = ROOF, material = Enum.Material.Concrete,
		})
		-- Parapet ajoure : couverture a hauteur de taille sur le toit.
		local halfX, halfZ = block.sx / 2, block.sz / 2
		for _, edge in ipairs({
			{ Vector3.new(0, 0, halfZ), Vector3.new(block.sx + 3, 4, 1.5) },
			{ Vector3.new(0, 0, -halfZ), Vector3.new(block.sx + 3, 4, 1.5) },
			{ Vector3.new(halfX, 0, 0), Vector3.new(1.5, 4, block.sz + 3) },
			{ Vector3.new(-halfX, 0, 0), Vector3.new(1.5, 4, block.sz + 3) },
		}) do
			b:Block(Vector3.new(block.x + edge[1].X, ROOF_Y + 3, block.z + edge[1].Z), edge[2], {
				name = "Parapet", color = ROOF, material = Enum.Material.Concrete,
			})
		end
		-- Fenetres eclairees pour donner de la profondeur.
		for level = 1, 4 do
			for column = -1, 1 do
				b:Block(Vector3.new(block.x + column * 20, level * 9, block.z + halfZ + 0.4), Vector3.new(8, 5, 0.4), {
					name = "Window", color = Color3.fromRGB(255, 226, 160), material = Enum.Material.Neon,
					canCollide = false, castShadow = false,
				})
			end
		end
	end

	-- Passerelles reliant les quatre toits : le coeur du jeu en hauteur.
	b:Mirror(function(side)
		b:Bridge(Vector3.new(side * 10, ROOF_Y + 1, -21), Vector3.new(side * 10, ROOF_Y + 1, 21), 12, {
			color = Color3.fromRGB(140, 120, 90), railColor = Color3.fromRGB(100, 84, 62),
		})
		b:Bridge(Vector3.new(-21, ROOF_Y + 1, side * 10), Vector3.new(21, ROOF_Y + 1, side * 10), 12, {
			color = Color3.fromRGB(140, 120, 90), railColor = Color3.fromRGB(100, 84, 62),
		})
	end)

	-- Plateforme centrale suspendue : le point de controle.
	b:Platform(Vector3.new(0, ROOF_Y + 5, 0), Vector3.new(34, 1.2, 34), {
		name = "CentralDeck", color = METAL, material = Enum.Material.DiamondPlate,
	})
	b:Mirror(function(side)
		b:Block(Vector3.new(side * 16, ROOF_Y + 8, 0), Vector3.new(1.5, 5, 34), {
			name = "DeckRail", color = METAL, material = Enum.Material.Metal,
		})
		b:Ramp(Vector3.new(side * 24, ROOF_Y + 1, 0), 12, 14, 4, side > 0 and 90 or 270, {
			color = METAL, material = Enum.Material.DiamondPlate,
		})
	end)

	-- ------------------------------------------------------- deux bases
	b:Mirror(function(side)
		local baseX = side * 122
		local accent = side < 0 and NEON_BLUE or NEON_RED

		-- Immeuble de base, plus large, avec un toit de depart degage.
		b:Block(Vector3.new(baseX, ROOF_Y / 2, 0), Vector3.new(56, ROOF_Y, 150), {
			name = "BaseBuilding", color = Color3.fromRGB(104, 106, 116), material = Enum.Material.Concrete,
		})
		b:Block(Vector3.new(baseX, ROOF_Y + 0.5, 0), Vector3.new(60, 1, 154), {
			name = "BaseRoof", color = ROOF, material = Enum.Material.Concrete,
		})
		b:Mirror(function(inner)
			b:Block(Vector3.new(baseX, ROOF_Y + 3, inner * 76), Vector3.new(60, 4, 1.5), {
				name = "Parapet", color = ROOF, material = Enum.Material.Concrete,
			})
		end)
		b:Block(Vector3.new(baseX + side * 29, ROOF_Y + 3, 0), Vector3.new(1.5, 4, 154), {
			name = "Parapet", color = ROOF, material = Enum.Material.Concrete,
		})

		-- Escalier de secours exterieur : seule liaison rue <-> toit de la base.
		b:Stairs(Vector3.new(baseX - side * 34, 0, 60), 12, 40, ROOF_Y, 14, side > 0 and 90 or 270, {
			color = METAL, material = Enum.Material.Metal,
		})
		b:Platform(Vector3.new(baseX - side * 34, ROOF_Y + 1, 60), Vector3.new(18, 1, 18), {
			name = "FireEscapeTop", color = METAL, material = Enum.Material.DiamondPlate,
		})
		b:Bridge(Vector3.new(baseX - side * 34, ROOF_Y + 1, 60), Vector3.new(baseX, ROOF_Y + 1, 60), 12, {
			color = METAL, railColor = Color3.fromRGB(110, 114, 122), material = Enum.Material.Metal,
		})

		-- Chateau d'eau : point haut de la base et station de recharge naturelle.
		b:Cylinder(
			CFrame.new(baseX, ROOF_Y + 16, -54) * CFrame.Angles(0, 0, math.rad(90)),
			Vector3.new(22, 26, 26),
			{ name = "WaterTower", color = Color3.fromRGB(150, 130, 100), material = Enum.Material.WoodPlanks }
		)
		for _, offset in ipairs({
			Vector3.new(9, 0, 9), Vector3.new(-9, 0, 9), Vector3.new(9, 0, -9), Vector3.new(-9, 0, -9),
		}) do
			b:Block(Vector3.new(baseX + offset.X, ROOF_Y + 3, -54 + offset.Z), Vector3.new(1.4, 6, 1.4), {
				name = "TowerLeg", color = METAL, material = Enum.Material.Metal,
			})
		end

		-- Enseigne neon aux couleurs de l'equipe.
		b:Block(Vector3.new(baseX - side * 29, 32, 0), Vector3.new(1, 18, 60), {
			name = "NeonSign", color = accent, material = Enum.Material.Neon, canCollide = false, castShadow = false,
		})

		-- Climatiseurs sur le toit : couverture basse.
		for index = -2, 2 do
			b:Block(Vector3.new(baseX + side * 14, ROOF_Y + 3.5, index * 26), Vector3.new(12, 5, 10), {
				name = "AirConditioner", color = Color3.fromRGB(176, 180, 188), material = Enum.Material.Metal,
			})
		end

		-- Rue : bennes et camionnettes en couverture.
		b:Block(Vector3.new(baseX - side * 46, 3.5, -30), Vector3.new(20, 7, 12), {
			name = "Dumpster", color = Color3.fromRGB(60, 120, 80), material = Enum.Material.Metal,
		})
		b:Block(Vector3.new(baseX - side * 46, 4.5, 34), Vector3.new(26, 9, 13), {
			name = "Truck", color = Color3.fromRGB(180, 180, 176), material = Enum.Material.Metal,
		})
		b:Crates(Vector3.new(baseX - side * 60, 0, 0), 4, 20, { maxStack = 2 })
	end)

	-- ---------------------------------------------------- ruelles au sol
	b:Mirror(function(side)
		-- Conteneurs dans l'avenue centrale.
		b:Block(
			CFrame.new(side * 62, 6, 0) * CFrame.Angles(0, math.rad(side * 8), 0),
			Vector3.new(34, 12, 16),
			{ name = "Container", color = side > 0 and Color3.fromRGB(190, 110, 60) or Color3.fromRGB(70, 130, 170), material = Enum.Material.Metal }
		)
		b:Block(Vector3.new(side * 62, 13.5, 0), Vector3.new(34, 3, 16), {
			name = "ContainerTop", color = Color3.fromRGB(90, 94, 100), material = Enum.Material.Metal,
		})
		b:Ramp(Vector3.new(side * 84, 0, 0), 14, 18, 12, side > 0 and 270 or 90, {
			color = METAL, material = Enum.Material.Metal,
		})

		-- Echafaudage : acces rue -> toit au milieu du terrain.
		b:Stairs(Vector3.new(0, 0, side * 96), 14, 44, ROOF_Y, 15, side > 0 and 180 or 0, {
			color = Color3.fromRGB(196, 160, 90), material = Enum.Material.Metal,
		})
		b:Platform(Vector3.new(0, ROOF_Y + 1, side * 96), Vector3.new(26, 1, 20), {
			name = "ScaffoldTop", color = Color3.fromRGB(196, 160, 90), material = Enum.Material.Metal,
		})
		b:Bridge(Vector3.new(0, ROOF_Y + 1, side * 96), Vector3.new(0, ROOF_Y + 1, side * 84), 14, {
			color = Color3.fromRGB(196, 160, 90), rails = false,
		})
		-- Liaison echafaudage -> toits des immeubles centraux.
		b:Mirror(function(inner)
			b:Bridge(Vector3.new(0, ROOF_Y + 1, side * 84), Vector3.new(inner * 46, ROOF_Y + 1, side * 84), 12, {
				color = Color3.fromRGB(140, 120, 90), railColor = Color3.fromRGB(100, 84, 62),
			})
		end)
	end)
end

return Map
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="9">
            <Properties>
              <string name="Name">SplashBay</string>
              <string name="Source"><![CDATA[--[[
	Map 2/6 : Baie des Eclaboussures
	Plage ouverte bordee par la mer. Deux pontons de bois servent de bases, un
	chateau de sable geant tient le centre. Les rochers et les barques offrent
	une couverture basse : c'est la map des duels a moyenne distance.
]]

local MAP_WIDTH = 340
local MAP_DEPTH = 250

local SAND = Color3.fromRGB(232, 214, 168)
local SAND_WET = Color3.fromRGB(206, 186, 140)
local WOOD = Color3.fromRGB(162, 122, 82)
local WOOD_DARK = Color3.fromRGB(118, 88, 60)
local ROCK = Color3.fromRGB(128, 126, 122)
local SEA = Color3.fromRGB(46, 152, 210)

local function row(x, zCenter, count, spacing, y)
	local points = {}
	local start = zCenter - (count - 1) * spacing / 2
	for index = 1, count do
		table.insert(points, Vector3.new(x, y or 4, start + (index - 1) * spacing))
	end
	return points
end

local function concat(...)
	local out = {}
	for _, list in ipairs({ ... }) do
		for _, value in ipairs(list) do
			table.insert(out, value)
		end
	end
	return out
end

local Map = {}

Map.id = "splash_bay"
Map.name = "Baie des Eclaboussures"
Map.theme = "Plage de sable fin"
Map.description = "Une plage immense, deux pontons de bois et un chateau de sable au centre. Terrain ouvert qui recompense la precision."
Map.size = Vector2.new(MAP_WIDTH, MAP_DEPTH)
Map.killY = -30
Map.skyColor = Color3.fromRGB(170, 220, 255)

Map.lighting = {
	ClockTime = 16.5,
	Brightness = 3,
	Ambient = Color3.fromRGB(135, 130, 120),
	OutdoorAmbient = Color3.fromRGB(175, 170, 155),
	FogColor = Color3.fromRGB(225, 235, 245),
	FogStart = 260,
	FogEnd = 850,
	ColorShift_Top = Color3.fromRGB(255, 225, 180),
}

Map.spawns = {
	Blue = concat(row(-146, -30, 6, 15), row(-146, 46, 6, 15)),
	Red = concat(row(146, -30, 6, 15), row(146, 46, 6, 15)),
	FFA = concat(
		row(-128, 0, 5, 24),
		row(128, 0, 5, 24),
		row(-56, -92, 3, 28),
		row(56, 92, 3, 28),
		row(-56, 92, 2, 34),
		row(56, -92, 2, 34)
	),
}

Map.controlPoint = Vector3.new(0, 8, 0)

Map.refillStations = {
	Vector3.new(-126, 0, 8),
	Vector3.new(126, 0, 8),
	Vector3.new(0, 0, -86),
	Vector3.new(0, 0, 86),
}

Map.powerupSpots = {
	Vector3.new(0, 19, 0),
	Vector3.new(-74, 2, -70),
	Vector3.new(74, 2, 70),
	Vector3.new(-74, 2, 70),
	Vector3.new(74, 2, -70),
}

function Map.build(b)
	-- ---------------------------------------------------------------- sable
	b:Ground(MAP_WIDTH, MAP_DEPTH, { color = SAND, material = Enum.Material.Sand })
	b:Bounds(MAP_WIDTH, MAP_DEPTH, 170)

	-- Bande de sable mouille pres du rivage, puis la mer.
	b:Block(Vector3.new(0, 0.12, -108), Vector3.new(MAP_WIDTH, 0.4, 36), {
		name = "WetSand", color = SAND_WET, material = Enum.Material.Sand, castShadow = false,
	})
	b:Block(Vector3.new(0, -0.6, -190), Vector3.new(MAP_WIDTH + 400, 2, 200), {
		name = "Sea", color = SEA, material = Enum.Material.Glass,
		transparency = 0.35, canCollide = false, castShadow = false, reflectance = 0.3,
	})
	b:Block(Vector3.new(0, -0.6, 190), Vector3.new(MAP_WIDTH + 400, 2, 200), {
		name = "Sea", color = SEA, material = Enum.Material.Glass,
		transparency = 0.35, canCollide = false, castShadow = false, reflectance = 0.3,
	})

	-- ------------------------------------------------- chateau de sable
	-- Trois etages en escalier : le sommet est le meilleur poste de tir.
	local tiers = {
		{ size = Vector3.new(76, 6, 76), y = 3 },
		{ size = Vector3.new(54, 6, 54), y = 9 },
		{ size = Vector3.new(34, 6, 34), y = 15 },
	}
	for _, tier in ipairs(tiers) do
		b:Block(Vector3.new(0, tier.y, 0), tier.size, {
			name = "CastleTier", color = SAND_WET, material = Enum.Material.Sandstone,
		})
	end
	-- Tourelles d'angle
	for _, corner in ipairs({
		Vector3.new(1, 0, 1), Vector3.new(-1, 0, 1), Vector3.new(1, 0, -1), Vector3.new(-1, 0, -1),
	}) do
		b:Cylinder(
			CFrame.new(corner.X * 32, 11, corner.Z * 32) * CFrame.Angles(0, 0, math.rad(90)),
			Vector3.new(22, 12, 12),
			{ name = "CastleTurret", color = SAND, material = Enum.Material.Sandstone }
		)
		b:Block(Vector3.new(corner.X * 14, 19.5, corner.Z * 14), Vector3.new(4, 3, 4), {
			name = "Merlon", color = SAND_WET, material = Enum.Material.Sandstone,
		})
	end
	-- Quatre rampes d'acces, une par direction : le centre reste prenable.
	b:Mirror(function(side)
		b:Ramp(Vector3.new(side * 46, 0, 0), 18, 20, 6, side > 0 and 90 or 270, {
			color = SAND_WET, material = Enum.Material.Sandstone,
		})
		b:Ramp(Vector3.new(0, 0, side * 46), 18, 20, 6, side > 0 and 180 or 0, {
			color = SAND_WET, material = Enum.Material.Sandstone,
		})
		b:Stairs(Vector3.new(side * 22, 6, 0), 12, 14, 9, 5, side > 0 and 90 or 270, {
			color = SAND, material = Enum.Material.Sandstone,
		})
	end)

	-- ------------------------------------------------- pontons (2 bases)
	b:Mirror(function(side)
		local baseX = side * 134

		-- Ponton sur pilotis, legerement sureleve.
		b:Platform(Vector3.new(baseX, 6, 8), Vector3.new(58, 1.5, 96), {
			name = "Pier", color = WOOD, material = Enum.Material.WoodPlanks, legs = true, legColor = WOOD_DARK,
		})
		for offset = -44, 44, 22 do
			b:Block(Vector3.new(baseX, 8, 8 + offset), Vector3.new(58, 3, 1), {
				name = "PierPlank", color = WOOD_DARK, material = Enum.Material.WoodPlanks, castShadow = false,
			})
		end
		b:Ramp(Vector3.new(baseX - side * 34, 0, 8), 26, 18, 6, side > 0 and 90 or 270, {
			color = WOOD, material = Enum.Material.WoodPlanks,
		})

		-- Cabane du maitre nageur : point haut de la base.
		b:Tower(Vector3.new(baseX + side * 12, 6, -52), 11, 20, {
			color = WOOD, railColor = WOOD_DARK, pillarColor = WOOD_DARK, levels = 2,
		})
		b:Block(Vector3.new(baseX + side * 12, 29, -52), Vector3.new(26, 1, 26), {
			name = "TowerRoof", color = side < 0 and Color3.fromRGB(70, 140, 220) or Color3.fromRGB(220, 90, 80),
			material = Enum.Material.Fabric,
		})
		b:Stairs(Vector3.new(baseX + side * 12, 6, -34), 10, 16, 10, 6, 180, {
			color = WOOD_DARK, material = Enum.Material.WoodPlanks,
		})

		-- Barques retournees : couverture avancee.
		b:Mirror(function(inner)
			b:Block(
				CFrame.new(baseX - side * 46, 2.2, inner * 56) * CFrame.Angles(0, math.rad(inner * 22), math.rad(8)),
				Vector3.new(30, 4.5, 11),
				{ name = "Boat", color = Color3.fromRGB(205, 205, 200), material = Enum.Material.Plastic }
			)
		end)

		-- Parasols : couverture haute qui bloque les tirs en cloche.
		for _, z in ipairs({ -78, 74 }) do
			b:Block(Vector3.new(baseX - side * 62, 5, z), Vector3.new(1, 10, 1), {
				name = "UmbrellaPole", color = Color3.fromRGB(230, 230, 225), material = Enum.Material.Metal,
			})
			b:Cylinder(
				CFrame.new(baseX - side * 62, 10.5, z) * CFrame.Angles(0, 0, math.rad(90)),
				Vector3.new(1, 24, 24),
				{ name = "Umbrella", color = Color3.fromRGB(240, 120, 110), material = Enum.Material.Fabric }
			)
		end

		-- Recifs rocheux : le seul relief naturel des flancs.
		for index = 1, 4 do
			local scale = 10 + index * 3
			b:Sphere(
				Vector3.new(baseX - side * (30 + index * 18), scale * 0.22, 96 - index * 8),
				scale,
				{ name = "Rock", color = ROCK, material = Enum.Material.Slate }
			)
		end
	end)

	-- ------------------------------------------------ couloirs lateraux
	b:Mirror(function(side)
		-- Digue de rochers qui casse la ligne de vue d'un bout a l'autre.
		for index = -3, 3 do
			b:Block(
				CFrame.new(index * 26, 3.5, side * 74) * CFrame.Angles(0, math.rad(index * 12), 0),
				Vector3.new(18, 7, 12),
				{ name = "Breakwater", color = ROCK, material = Enum.Material.Slate }
			)
		end
		-- Passerelle en bois au-dessus de la digue.
		b:Bridge(Vector3.new(-56, 11, side * 74), Vector3.new(56, 11, side * 74), 12, {
			color = WOOD, railColor = WOOD_DARK,
		})
		b:Ramp(Vector3.new(-70, 0, side * 74), 14, 22, 11, 270, { color = WOOD, material = Enum.Material.WoodPlanks })
		b:Ramp(Vector3.new(70, 0, side * 74), 14, 22, 11, 90, { color = WOOD, material = Enum.Material.WoodPlanks })

		b:Crates(Vector3.new(side * 84, 0, -side * 28), 4, 18, { maxStack = 2, color = WOOD })
	end)

	-- ------------------------------------------------------------ palmiers
	local palmSpots = {
		Vector3.new(-100, 0, 104), Vector3.new(100, 0, 104),
		Vector3.new(-40, 0, 110), Vector3.new(40, 0, 110),
		Vector3.new(-158, 0, 98), Vector3.new(158, 0, 98),
		Vector3.new(-158, 0, -66), Vector3.new(158, 0, -66),
	}
	for index, spot in ipairs(palmSpots) do
		b:Tree(spot, 1.1 + (index % 3) * 0.15, {
			trunkColor = Color3.fromRGB(150, 118, 80),
			leafColor = Color3.fromRGB(86, 168, 92),
		})
	end
end

return Map
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="10">
            <Properties>
              <string name="Name">SunkenTemple</string>
              <string name="Source"><![CDATA[--[[
	Map 5/6 : Temple Englouti
	Des ruines envahies par la jungle autour d'un bassin sacre. Pyramide
	centrale a gradins, galeries couvertes sur les flancs, cascades en fond.
	Map de controle : celui qui tient les gradins tient la partie.
]]

local MAP_WIDTH = 320
local MAP_DEPTH = 250

local STONE = Color3.fromRGB(148, 144, 132)
local STONE_DARK = Color3.fromRGB(112, 110, 100)
local MOSS = Color3.fromRGB(92, 128, 74)
local JUNGLE = Color3.fromRGB(64, 104, 58)
local WATER = Color3.fromRGB(60, 168, 186)
local GOLD = Color3.fromRGB(222, 186, 96)

local function row(x, zCenter, count, spacing, y)
	local points = {}
	local start = zCenter - (count - 1) * spacing / 2
	for index = 1, count do
		table.insert(points, Vector3.new(x, y or 4, start + (index - 1) * spacing))
	end
	return points
end

local function concat(...)
	local out = {}
	for _, list in ipairs({ ... }) do
		for _, value in ipairs(list) do
			table.insert(out, value)
		end
	end
	return out
end

local Map = {}

Map.id = "sunken_temple"
Map.name = "Temple Englouti"
Map.theme = "Ruines dans la jungle"
Map.description = "Une pyramide a gradins au milieu d'un bassin sacre, entouree de galeries de pierre et de cascades."
Map.size = Vector2.new(MAP_WIDTH, MAP_DEPTH)
Map.killY = -35
Map.skyColor = Color3.fromRGB(120, 170, 160)

Map.lighting = {
	ClockTime = 9.5,
	Brightness = 2.2,
	Ambient = Color3.fromRGB(104, 112, 100),
	OutdoorAmbient = Color3.fromRGB(128, 142, 126),
	FogColor = Color3.fromRGB(150, 180, 160),
	FogStart = 120,
	FogEnd = 620,
	ColorShift_Top = Color3.fromRGB(220, 240, 210),
}

Map.spawns = {
	Blue = concat(row(-140, -30, 6, 15), row(-140, 44, 6, 15)),
	Red = concat(row(140, -30, 6, 15), row(140, 44, 6, 15)),
	FFA = concat(
		row(-122, 0, 5, 24),
		row(122, 0, 5, 24),
		row(-52, -94, 3, 26),
		row(52, 94, 3, 26),
		row(52, -94, 2, 34),
		row(-52, 94, 2, 34)
	),
}

Map.controlPoint = Vector3.new(0, 24, 0)

Map.refillStations = {
	Vector3.new(-120, 0, 0),
	Vector3.new(120, 0, 0),
	Vector3.new(0, 0, -84),
	Vector3.new(0, 0, 84),
}

Map.powerupSpots = {
	Vector3.new(0, 34, 0),
	Vector3.new(-70, 2, -68),
	Vector3.new(70, 2, 68),
	Vector3.new(-70, 2, 68),
	Vector3.new(70, 2, -68),
}

function Map.build(b)
	-- ------------------------------------------------------------ jungle
	b:Ground(MAP_WIDTH, MAP_DEPTH, { color = JUNGLE, material = Enum.Material.Grass })
	b:Bounds(MAP_WIDTH, MAP_DEPTH, 200)

	-- Dallage antique autour du temple.
	b:Block(Vector3.new(0, 0.15, 0), Vector3.new(190, 0.5, 170), {
		name = "Plaza", color = STONE, material = Enum.Material.Slate, castShadow = false,
	})
	for index = -4, 4 do
		b:Block(Vector3.new(index * 22, 0.25, 0), Vector3.new(1.5, 0.5, 168), {
			name = "PlazaLine", color = STONE_DARK, material = Enum.Material.Slate, castShadow = false,
		})
	end

	-- ------------------------------------------------- bassin et pyramide
	b:Pool(Vector3.new(0, 1.2, 0), Vector3.new(120, 1, 100), {
		color = WATER, floorColor = Color3.fromRGB(110, 190, 190),
		rimColor = STONE, depth = 4,
	})

	-- Pyramide a quatre gradins.
	local tiers = {
		{ size = 92, y = 4 },
		{ size = 72, y = 10 },
		{ size = 52, y = 16 },
		{ size = 34, y = 22 },
	}
	for index, tier in ipairs(tiers) do
		b:Block(Vector3.new(0, tier.y, 0), Vector3.new(tier.size, 6, tier.size * 0.85), {
			name = "TempleTier",
			color = index % 2 == 0 and STONE or STONE_DARK,
			material = Enum.Material.Slate,
		})
		-- Mousse sur les aretes.
		b:Block(Vector3.new(0, tier.y + 3.2, 0), Vector3.new(tier.size - 4, 0.6, tier.size * 0.85 - 4), {
			name = "Moss", color = MOSS, material = Enum.Material.Grass, castShadow = false, canCollide = false,
		})
	end

	-- Sanctuaire au sommet : le point de controle, abrite par quatre piliers.
	b:Block(Vector3.new(0, 25.5, 0), Vector3.new(26, 1, 22), {
		name = "Shrine", color = GOLD, material = Enum.Material.Sandstone,
	})
	for _, corner in ipairs({
		Vector3.new(11, 0, 9), Vector3.new(-11, 0, 9), Vector3.new(11, 0, -9), Vector3.new(-11, 0, -9),
	}) do
		b:Cylinder(
			CFrame.new(corner.X, 31, corner.Z) * CFrame.Angles(0, 0, math.rad(90)),
			Vector3.new(11, 3.2, 3.2),
			{ name = "ShrinePillar", color = STONE, material = Enum.Material.Sandstone }
		)
	end
	b:Block(Vector3.new(0, 37, 0), Vector3.new(30, 1.5, 26), {
		name = "ShrineRoof", color = STONE_DARK, material = Enum.Material.Slate,
	})

	-- Escaliers monumentaux sur les quatre faces.
	b:Mirror(function(side)
		b:Stairs(Vector3.new(side * 60, 0, 0), 26, 32, 25, 10, side > 0 and 90 or 270, {
			color = STONE, material = Enum.Material.Slate,
		})
		b:Stairs(Vector3.new(0, 0, side * 56), 26, 30, 25, 10, side > 0 and 180 or 0, {
			color = STONE, material = Enum.Material.Slate,
		})
	end)

	-- ------------------------------------------------ galeries (2 bases)
	b:Mirror(function(side)
		local baseX = side * 130
		local accent = side < 0 and Color3.fromRGB(70, 150, 230) or Color3.fromRGB(230, 100, 80)

		-- Grande salle couverte a colonnes.
		b:Building(Vector3.new(baseX, 0, 8), Vector3.new(62, 22, 96), {
			color = STONE, material = Enum.Material.Sandstone,
			roofColor = STONE_DARK, roofMaterial = Enum.Material.Slate,
			floorColor = Color3.fromRGB(132, 128, 118), floorMaterial = Enum.Material.Slate,
			openings = { north = true, south = true, east = side < 0, west = side > 0 },
			doorWidth = 18, doorHeight = 14, wallThickness = 3,
		})
		-- Colonnes interieures.
		for index = -1, 1 do
			b:Mirror(function(inner)
				b:Cylinder(
					CFrame.new(baseX + inner * 20, 11, 8 + index * 30) * CFrame.Angles(0, 0, math.rad(90)),
					Vector3.new(22, 5, 5),
					{ name = "Column", color = STONE, material = Enum.Material.Sandstone }
				)
			end)
		end
		-- Terrasse sur le toit de la galerie.
		b:Platform(Vector3.new(baseX, 23.5, 8), Vector3.new(58, 1, 92), {
			name = "GalleryRoof", color = STONE_DARK, material = Enum.Material.Slate,
		})
		b:Mirror(function(inner)
			b:Block(Vector3.new(baseX + inner * 28, 26, 8), Vector3.new(2, 5, 92), {
				name = "RoofEdge", color = STONE, material = Enum.Material.Sandstone,
			})
		end)
		b:Stairs(Vector3.new(baseX + side * 36, 0, 8), 14, 26, 23, 9, side > 0 and 90 or 270, {
			color = STONE_DARK, material = Enum.Material.Slate,
		})

		-- Statue gardienne devant la base.
		b:Block(Vector3.new(baseX - side * 44, 5, -56), Vector3.new(12, 10, 12), {
			name = "StatueBase", color = STONE_DARK, material = Enum.Material.Slate,
		})
		b:Block(Vector3.new(baseX - side * 44, 15, -56), Vector3.new(8, 10, 8), {
			name = "Statue", color = GOLD, material = Enum.Material.Sandstone,
		})
		b:Sphere(Vector3.new(baseX - side * 44, 23, -56), 8, {
			name = "StatueHead", color = GOLD, material = Enum.Material.Sandstone,
		})
		b:Block(Vector3.new(baseX - side * 44, 28, -56), Vector3.new(10, 3, 10), {
			name = "StatueCrown", color = accent, material = Enum.Material.Neon, canCollide = false,
		})

		-- Cascade en fond de base.
		b:Block(Vector3.new(baseX + side * 26, 30, 70), Vector3.new(4, 60, 34), {
			name = "Waterfall", color = Color3.fromRGB(180, 230, 240), material = Enum.Material.Glass,
			transparency = 0.35, canCollide = false, castShadow = false,
			rotation = Vector3.new(0, side * 20, 0),
		})
		b:Block(Vector3.new(baseX + side * 26, 1.2, 70), Vector3.new(30, 1, 30), {
			name = "WaterfallPool", color = WATER, material = Enum.Material.Glass,
			transparency = 0.4, canCollide = false, castShadow = false,
		})

		-- Colonnes brisees : couverture de milieu de terrain.
		for index = 1, 5 do
			local height = 8 + (index % 3) * 7
			b:Cylinder(
				CFrame.new(baseX - side * (58 + index * 12), height / 2, -70 + index * 30) * CFrame.Angles(0, 0, math.rad(90)),
				Vector3.new(height, 7, 7),
				{ name = "BrokenColumn", color = index % 2 == 0 and STONE or STONE_DARK, material = Enum.Material.Sandstone }
			)
		end
	end)

	-- --------------------------------------------- galeries transversales
	b:Mirror(function(side)
		-- Mur de ruines qui borde le terrain au nord et au sud.
		for index = -3, 3 do
			local height = 12 + (index % 2) * 6
			b:Block(Vector3.new(index * 30, height / 2, side * 96), Vector3.new(24, height, 6), {
				name = "RuinWall", color = STONE, material = Enum.Material.Sandstone,
			})
		end
		-- Passerelle de lianes reliant les deux cotes par l'exterieur.
		b:Bridge(Vector3.new(-70, 16, side * 88), Vector3.new(70, 16, side * 88), 12, {
			color = Color3.fromRGB(122, 96, 62), railColor = MOSS,
		})
		b:Mirror(function(inner)
			b:Stairs(Vector3.new(inner * 80, 0, side * 88), 12, 24, 16, 8, inner > 0 and 90 or 270, {
				color = STONE_DARK, material = Enum.Material.Slate,
			})
		end)
	end)

	-- ---------------------------------------------------------- vegetation
	local treeSpots = {
		Vector3.new(-104, 0, -104), Vector3.new(104, 0, 104),
		Vector3.new(-104, 0, 104), Vector3.new(104, 0, -104),
		Vector3.new(-152, 0, -40), Vector3.new(152, 0, 40),
		Vector3.new(-152, 0, 74), Vector3.new(152, 0, -74),
		Vector3.new(-24, 0, -112), Vector3.new(24, 0, 112),
	}
	for index, spot in ipairs(treeSpots) do
		b:Tree(spot, 1.3 + (index % 3) * 0.2, {
			trunkColor = Color3.fromRGB(96, 74, 54),
			leafColor = index % 2 == 0 and Color3.fromRGB(56, 116, 56) or MOSS,
		})
	end
end

return Map
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="ModuleScript" referent="11">
          <Properties>
            <string name="Name">Weapons</string>
            <string name="Source"><![CDATA[--[[
	Weapons
	Catalogue des 25 armes a eau du jeu.

	Chaque arme herite des valeurs par defaut de sa categorie (CATEGORY_DEFAULTS)
	puis applique ses propres reglages. Toutes les armes exposent donc exactement
	le meme jeu de champs, ce qui evite les "nil" cote serveur comme cote client.

	Champs :
	  damage           degats par goutte touchee
	  fireRate         tirs par seconde
	  autoFire         true = maintenir le clic tire en rafale
	  burst            nombre de gouttes tirees par appui (rafale)
	  tankSize         capacite du reservoir
	  tankCost         eau consommee par tir
	  reloadTime       duree du rechargement
	  speed            vitesse du projectile en studs/seconde
	  gravity          multiplicateur de gravite applique au projectile
	  lifetime         duree de vie max du projectile
	  spread           dispersion en degres
	  pellets          nombre de gouttes par tir
	  radius           rayon visuel de la goutte
	  splashRadius     rayon des degats de zone (0 = aucun)
	  splashDamage     degats de zone au centre
	  slow             ralentissement inflige (0..1)
	  slowTime         duree du ralentissement
	  heal             soin applique a un coequipier touche
	  chargeTime       temps de charge max (0 = pas de charge)
	  chargeBonus      multiplicateur de degats a pleine charge
	  headshot         multiplicateur de degats a la tete
	  walkSpeedMul     multiplicateur de vitesse quand l'arme est equipee
	  zoom             champ de vision en vise (0 = pas de vise)
	  model            dimensions du modele procedural
]]

local Weapons = {}

local RARITY = {
