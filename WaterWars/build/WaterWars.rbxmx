	Launcher = "Lanceurs",
	Special = "Speciales",
}

Weapons.CategoryOrder = { "Pistol", "SMG", "Rifle", "Shotgun", "Sniper", "Heavy", "Launcher", "Special" }

-- Valeurs communes a toutes les armes, appliquees en dernier recours.
local BASE = {
	damage = 10, fireRate = 3, autoFire = false, burst = 1,
