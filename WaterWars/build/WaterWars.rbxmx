		trail = Color3.fromRGB(150, 255, 240),
		model = { barrel = 3.6, thick = 1.0, tank = 2.0 },
	},

	-- -------------------------------- LANCEURS ---------------------------
	{
		id = "balloon_launcher", name = "Lance-Ballons", category = "Launcher",
		rarity = "Common", price = 1300,
		desc = "Envoie des ballons d'eau en cloche. Ideal derriere un mur.",
		color = Color3.fromRGB(255, 100, 140), accent = Color3.fromRGB(255, 235, 245),
	},
	{
		id = "bucket_bomb", name = "Bombe-Seau", category = "Launcher",
		rarity = "Rare", price = 2400,
		desc = "Un seau piege qui inonde toute la zone d'impact.",
		damage = 22, splashRadius = 17, splashDamage = 62, fireRate = 0.7,
		speed = 95, gravity = 1.9, tankSize = 18, tankCost = 6, reloadTime = 3.2,
		color = Color3.fromRGB(150, 90, 40), accent = Color3.fromRGB(230, 200, 150),
	},
	{
		id = "geyser_mortar", name = "Mortier Geyser", category = "Launcher",
		rarity = "Legendary", price = 6000,
		desc = "Tir en cloche tres haut : un geyser jaillit au point de chute.",
		damage = 20, splashRadius = 22, splashDamage = 70, fireRate = 0.5,
		speed = 130, gravity = 2.4, lifetime = 6, tankSize = 12, tankCost = 4,
		reloadTime = 4.0, radius = 1.0, walkSpeedMul = 0.88,
		color = Color3.fromRGB(60, 70, 60), accent = Color3.fromRGB(140, 255, 180),
		trail = Color3.fromRGB(160, 255, 200),
		model = { barrel = 3.4, thick = 1.1, tank = 1.4 },
	},

	-- ------------------------------- SPECIALES ---------------------------
	{
		id = "frost_ray", name = "Rayon Glace", category = "Special",
		rarity = "Legendary", price = 6500,
		desc = "De l'eau glacee qui ralentit fortement les adversaires touches.",
		damage = 9, fireRate = 9, speed = 260, gravity = 0.1,
		slow = 0.55, slowTime = 2.0, tankSize = 140, tankCost = 3, reloadTime = 2.6,
		color = Color3.fromRGB(180, 240, 255), accent = Color3.fromRGB(40, 90, 120),
		trail = Color3.fromRGB(210, 250, 255),
	},
	{
		id = "rainbow_sprayer", name = "Pulverisateur Arc-en-Ciel", category = "Special",
		rarity = "Epic", price = 3900,
		desc = "Blesse les adversaires et soigne les coequipiers touches.",
		damage = 11, fireRate = 8, heal = 9, tankSize = 130, tankCost = 3,
		splashRadius = 4, splashDamage = 4,
		color = Color3.fromRGB(255, 120, 255), accent = Color3.fromRGB(255, 255, 160),
		trail = Color3.fromRGB(255, 180, 255),
	},
	{
		id = "steam_vent", name = "Souffleur de Vapeur", category = "Special",
		rarity = "Rare", price = 2300,
		desc = "Cone de vapeur brulante, redoutable au corps a corps.",
		damage = 6, fireRate = 14, pellets = 3, spread = 11, speed = 95,
		gravity = 0.15, lifetime = 0.35, tankSize = 180, tankCost = 3,
		reloadTime = 2.4, radius = 0.55, walkSpeedMul = 1.04,
		color = Color3.fromRGB(200, 205, 215), accent = Color3.fromRGB(255, 120, 60),
		trail = Color3.fromRGB(240, 240, 240),
		model = { barrel = 1.8, thick = 0.75, tank = 1.4 },
	},
}

-- ------------------------- CONSTRUCTION DU CATALOGUE ----------------------

local function merge(target, source)
	for key, value in pairs(source) do
		if target[key] == nil then
			target[key] = value
		end
	end
end

Weapons.List = {}
Weapons.ById = {}

for index, raw in ipairs(RAW) do
	local weapon = table.clone(raw)
	local categoryDefaults = CATEGORY_DEFAULTS[raw.category]
	assert(categoryDefaults, "Categorie inconnue pour l'arme " .. tostring(raw.id))

	-- Le modele est un sous-tableau : on le fusionne separement.
	local model = table.clone(weapon.model or {})
	merge(model, categoryDefaults.model)
	merge(model, { barrel = 2.2, thick = 0.5, tank = 1.0 })
	weapon.model = model

	merge(weapon, categoryDefaults)
	merge(weapon, BASE)

	weapon.order = index
	weapon.rarityColor = RARITY[weapon.rarity].color
	weapon.rarityName = RARITY[weapon.rarity].name
	-- Degats theoriques par seconde, affiches dans la boutique.
	weapon.dps = math.floor(weapon.damage * weapon.pellets * weapon.fireRate * weapon.burst + 0.5)

	assert(Weapons.ById[weapon.id] == nil, "Identifiant d'arme duplique : " .. weapon.id)
	Weapons.ById[weapon.id] = weapon
	table.insert(Weapons.List, weapon)
end

-- Armes possedees des la premiere connexion.
Weapons.StarterIds = { "squirt_pistol", "stream_rifle" }
Weapons.DefaultPrimary = "stream_rifle"
Weapons.DefaultSecondary = "squirt_pistol"

function Weapons.Get(id)
	return Weapons.ById[id]
end

function Weapons.Exists(id)
	return Weapons.ById[id] ~= nil
end

function Weapons.IsStarter(id)
	return table.find(Weapons.StarterIds, id) ~= nil
end

function Weapons.ByCategory(category)
	local result = {}
	for _, weapon in ipairs(Weapons.List) do
		if weapon.category == category then
			table.insert(result, weapon)
		end
	end
	return result
end

Weapons.Count = #Weapons.List

return Weapons
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="12">
        <Properties>
          <string name="Name">Shared</string>
        </Properties>
        <Item class="ModuleScript" referent="13">
          <Properties>
            <string name="Name">MapBuilder</string>
            <string name="Source"><![CDATA[--[[
	MapBuilder
	Petite bibliotheque de construction utilisee par les 6 maps.

	Chaque map recoit un "builder" et decrit son terrain avec des primitives
	lisibles (bloc, mur, rampe, batiment, piscine, pont, caisses...). Tout est
	genere au demarrage de la manche : aucun asset externe, aucun ID a uploader.

	Toutes les pieces sont ancrees et regroupees dans un Model unique, ce qui
	rend le nettoyage de fin de manche instantane (Model:Destroy()).
]]

local MapBuilder = {}
MapBuilder.__index = MapBuilder

local DEFAULT_MATERIAL = Enum.Material.SmoothPlastic

--- Cree un builder qui depose ses pieces dans `container`.
function MapBuilder.new(container, seed)
	local self = setmetatable({}, MapBuilder)
	self.container = container
	self.rng = Random.new(seed or 1337)
	self.count = 0
	return self
end

local function toCFrame(position, rotation)
	local cf
	if typeof(position) == "CFrame" then
		cf = position
	else
		cf = CFrame.new(position)
	end
	if rotation then
		cf = cf * CFrame.Angles(math.rad(rotation.X), math.rad(rotation.Y), math.rad(rotation.Z))
	end
	return cf
end

--- Primitive de base : un BasePart ancre, place et colore.
function MapBuilder:Part(className, position, size, options)
	options = options or {}
	-- className vaut toujours "Part" ou "WedgePart" : les deux sont des BasePart.
	local part = Instance.new(className) :: BasePart
	part.Name = options.name or "Part"
	part.Size = size
	part.CFrame = toCFrame(position, options.rotation)
	part.Anchored = true
	local canCollide = options.canCollide ~= false
	part.CanCollide = canCollide
	-- Le decor traversable ne doit pas non plus arreter les projectiles.
	if options.canQuery ~= nil then
		part.CanQuery = options.canQuery
	else
		part.CanQuery = canCollide
	end
	part.CanTouch = false
	part.CastShadow = options.castShadow ~= false
	part.Material = options.material or DEFAULT_MATERIAL
	part.Color = options.color or Color3.fromRGB(180, 180, 180)
	part.Transparency = options.transparency or 0
	part.Reflectance = options.reflectance or 0
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth

	if options.shape and part:IsA("Part") then
		part.Shape = options.shape
	end
	if options.collisionGroup then
		part.CollisionGroup = options.collisionGroup
	end
	part.Parent = self.container
	self.count = self.count + 1
	return part
end

--- Bloc rectangulaire (le pain quotidien des maps).
function MapBuilder:Block(position, size, options)
	return self:Part("Part", position, size, options)
end

--- Rampe (WedgePart). `rotation.Y` oriente la pente.
function MapBuilder:Wedge(position, size, options)
	return self:Part("WedgePart", position, size, options)
end

--- Cylindre couche ou debout selon la rotation fournie.
function MapBuilder:Cylinder(position, size, options)
	options = options or {}
	local merged = table.clone(options)
	merged.shape = Enum.PartType.Cylinder
	return self:Part("Part", position, size, merged)
end

--- Sphere.
function MapBuilder:Sphere(position, diameter, options)
	options = options or {}
	local merged = table.clone(options)
	merged.shape = Enum.PartType.Ball
	return self:Part("Part", position, Vector3.new(diameter, diameter, diameter), merged)
end

--- Sol principal de la map, centre sur l'origine.
function MapBuilder:Ground(width, depth, options)
	options = options or {}
	local thickness = options.thickness or 4
	local ground = self:Block(Vector3.new(0, -thickness / 2, 0), Vector3.new(width, thickness, depth), {
		name = "Ground",
		color = options.color or Color3.fromRGB(90, 140, 80),
		material = options.material or Enum.Material.Grass,
	})
	return ground
end

--- Plateforme surelevee : dalle + support optionnel.
function MapBuilder:Platform(position, size, options)
	options = options or {}
	local slab = self:Block(position, size, {
		name = options.name or "Platform",
		color = options.color or Color3.fromRGB(150, 150, 155),
		material = options.material or Enum.Material.Concrete,
		rotation = options.rotation,
	})
	if options.legs then
		local legSize = Vector3.new(1.2, position.Y - size.Y / 2, 1.2)
		if legSize.Y > 0.5 then
			local dx = size.X / 2 - 1.5
			local dz = size.Z / 2 - 1.5
			for _, offset in ipairs({
				Vector3.new(dx, 0, dz), Vector3.new(-dx, 0, dz),
				Vector3.new(dx, 0, -dz), Vector3.new(-dx, 0, -dz),
			}) do
				self:Block(
					Vector3.new(position.X + offset.X, legSize.Y / 2, position.Z + offset.Z),
					legSize,
					{ name = "Leg", color = options.legColor or Color3.fromRGB(110, 110, 115), material = Enum.Material.Metal }
				)
			end
		end
	end
	return slab
end

--- Mur droit entre deux points, avec hauteur et epaisseur.
function MapBuilder:Wall(fromPosition, toPosition, height, thickness, options)
	options = options or {}
	local delta = toPosition - fromPosition
	local length = delta.Magnitude
	if length < 0.05 then
		return nil
	end
	local center = fromPosition + delta * 0.5 + Vector3.new(0, height / 2, 0)
	local angle = math.atan2(-delta.Z, delta.X)
	local part = self:Block(
		CFrame.new(center) * CFrame.Angles(0, angle, 0),
		Vector3.new(length, height, thickness),
		{
			name = options.name or "Wall",
			color = options.color or Color3.fromRGB(160, 160, 165),
			material = options.material or Enum.Material.Concrete,
			transparency = options.transparency or 0,
			canCollide = options.canCollide,
		}
	)
	return part
end

--- Rampe praticable entre deux hauteurs.
function MapBuilder:Ramp(position, width, length, height, rotationY, options)
	options = options or {}
	return self:Wedge(
		CFrame.new(position + Vector3.new(0, height / 2, 0)) * CFrame.Angles(0, math.rad(rotationY), 0),
		Vector3.new(width, height, length),
		{
			name = options.name or "Ramp",
			color = options.color or Color3.fromRGB(150, 150, 155),
			material = options.material or Enum.Material.Concrete,
		}
	)
end

--- Escalier a marches.
function MapBuilder:Stairs(position, width, totalRun, totalRise, steps, rotationY, options)
	options = options or {}
	local stepRun = totalRun / steps
	local stepRise = totalRise / steps
	local yaw = math.rad(rotationY or 0)
	for index = 1, steps do
		local along = -totalRun / 2 + stepRun * (index - 0.5)
		local height = stepRise * index
		-- Chaque marche part du sol : sa hauteur augmente a mesure qu'on avance.
		local cf = CFrame.new(position)
			* CFrame.Angles(0, yaw, 0)
			* CFrame.new(0, height / 2, along)
		self:Block(cf, Vector3.new(width, height, stepRun), {
			name = "Step",
			color = options.color or Color3.fromRGB(150, 150, 155),
			material = options.material or Enum.Material.Concrete,
		})
	end
end

--- Bassin d'eau decoratif (non bloquant, legerement transparent).
function MapBuilder:Pool(position, size, options)
	options = options or {}
	local depth = options.depth or 3
	-- Cuvette
	self:Block(position - Vector3.new(0, depth + 0.5, 0), Vector3.new(size.X, 1, size.Z), {
		name = "PoolFloor",
		color = options.floorColor or Color3.fromRGB(90, 190, 210),
		material = Enum.Material.Pebble,
	})
	local rim = options.rim
	if rim ~= false then
		local rimColor = options.rimColor or Color3.fromRGB(230, 230, 220)
		local halfX, halfZ = size.X / 2, size.Z / 2
		self:Block(position + Vector3.new(0, 0.2, halfZ + 1), Vector3.new(size.X + 4, 1.4, 2), { color = rimColor, material = Enum.Material.Concrete, name = "PoolRim" })
		self:Block(position + Vector3.new(0, 0.2, -halfZ - 1), Vector3.new(size.X + 4, 1.4, 2), { color = rimColor, material = Enum.Material.Concrete, name = "PoolRim" })
		self:Block(position + Vector3.new(halfX + 1, 0.2, 0), Vector3.new(2, 1.4, size.Z), { color = rimColor, material = Enum.Material.Concrete, name = "PoolRim" })
		self:Block(position + Vector3.new(-halfX - 1, 0.2, 0), Vector3.new(2, 1.4, size.Z), { color = rimColor, material = Enum.Material.Concrete, name = "PoolRim" })
	end
	-- Surface
	local water = self:Block(position, Vector3.new(size.X, 0.6, size.Z), {
		name = "Water",
		color = options.color or Color3.fromRGB(70, 180, 230),
		material = Enum.Material.Glass,
		transparency = 0.45,
		canCollide = false,
		castShadow = false,
		reflectance = 0.25,
	})
	return water
end

--- Batiment creux avec ouvertures : la base des zones de combat interieures.
function MapBuilder:Building(position, size, options)
	options = options or {}
	local wallThickness = options.wallThickness or 1.5
	local color = options.color or Color3.fromRGB(190, 180, 165)
	local material = options.material or Enum.Material.Brick
	local halfX, halfZ = size.X / 2, size.Z / 2
	local centerY = position.Y + size.Y / 2
	local openings = options.openings or { north = true, south = true }
	local doorWidth = options.doorWidth or 10
	local doorHeight = options.doorHeight or 9

	local function buildSide(axis, sign)
		local isX = axis == "x"
		local sideLength = isX and size.Z or size.X
		local key
		if isX then
			key = sign > 0 and "east" or "west"
		else
			key = sign > 0 and "north" or "south"
		end
		local hasDoor = openings[key] == true
		local wallCenter = isX
			and Vector3.new(position.X + sign * halfX, centerY, position.Z)
			or Vector3.new(position.X, centerY, position.Z + sign * halfZ)
		local wallSize = isX
			and Vector3.new(wallThickness, size.Y, sideLength)
			or Vector3.new(sideLength, size.Y, wallThickness)

		if not hasDoor then
			self:Block(wallCenter, wallSize, { name = "BuildingWall", color = color, material = material })
			return
		end

		-- Deux pans + un linteau au-dessus de la porte.
		local sidePanel = (sideLength - doorWidth) / 2
		if sidePanel > 0.2 then
			for _, direction in ipairs({ 1, -1 }) do
				local offset = direction * (doorWidth / 2 + sidePanel / 2)
				local panelCenter = isX
					and Vector3.new(wallCenter.X, centerY, position.Z + offset)
					or Vector3.new(position.X + offset, centerY, wallCenter.Z)
				local panelSize = isX
					and Vector3.new(wallThickness, size.Y, sidePanel)
					or Vector3.new(sidePanel, size.Y, wallThickness)
				self:Block(panelCenter, panelSize, { name = "BuildingWall", color = color, material = material })
			end
		end
		local lintelHeight = size.Y - doorHeight
		if lintelHeight > 0.2 then
			local lintelCenter = isX
				and Vector3.new(wallCenter.X, position.Y + doorHeight + lintelHeight / 2, position.Z)
				or Vector3.new(position.X, position.Y + doorHeight + lintelHeight / 2, wallCenter.Z)
			local lintelSize = isX
				and Vector3.new(wallThickness, lintelHeight, doorWidth)
				or Vector3.new(doorWidth, lintelHeight, wallThickness)
			self:Block(lintelCenter, lintelSize, { name = "BuildingWall", color = color, material = material })
		end
	end

	buildSide("x", 1)
	buildSide("x", -1)
	buildSide("z", 1)
	buildSide("z", -1)

	if options.floor ~= false then
		self:Block(Vector3.new(position.X, position.Y + 0.25, position.Z), Vector3.new(size.X, 0.5, size.Z), {
			name = "BuildingFloor",
			color = options.floorColor or Color3.fromRGB(120, 105, 90),
			material = options.floorMaterial or Enum.Material.WoodPlanks,
		})
	end
	if options.roof ~= false then
		self:Block(Vector3.new(position.X, position.Y + size.Y + 0.5, position.Z), Vector3.new(size.X + 2, 1, size.Z + 2), {
			name = "Roof",
			color = options.roofColor or Color3.fromRGB(120, 70, 60),
			material = options.roofMaterial or Enum.Material.Slate,
		})
	end
end

--- Tas de caisses : couverture rapide et lisible pour le joueur.
function MapBuilder:Crates(position, count, spread, options)
	options = options or {}
	local size = options.size or 5
	for _ = 1, count do
		local offsetX = (self.rng:NextNumber() - 0.5) * spread
		local offsetZ = (self.rng:NextNumber() - 0.5) * spread
		local stack = self.rng:NextInteger(1, options.maxStack or 2)
		for level = 1, stack do
			local jitter = (self.rng:NextNumber() - 0.5) * 0.6
			self:Block(
				CFrame.new(position + Vector3.new(offsetX + jitter, size / 2 + size * (level - 1), offsetZ + jitter))
					* CFrame.Angles(0, self.rng:NextNumber() * math.pi, 0),
				Vector3.new(size, size, size),
				{
					name = "Crate",
					color = options.color or Color3.fromRGB(170, 125, 70),
					material = options.material or Enum.Material.WoodPlanks,
				}
			)
		end
	end
end

--- Barriere ajouree entre deux points.
function MapBuilder:Fence(fromPosition, toPosition, height, options)
	options = options or {}
	local delta = toPosition - fromPosition
	local length = delta.Magnitude
	if length < 0.05 then
		return
	end
	local direction = delta.Unit
	local color = options.color or Color3.fromRGB(190, 170, 140)
	local postSpacing = options.spacing or 8
	local postCount = math.max(2, math.floor(length / postSpacing) + 1)
	for index = 0, postCount - 1 do
		local position = fromPosition + direction * (length * index / (postCount - 1))
		self:Block(position + Vector3.new(0, height / 2, 0), Vector3.new(1, height, 1), {
			name = "FencePost",
			color = color,
			material = options.material or Enum.Material.WoodPlanks,
		})
	end
	-- Lisses horizontales
	local angle = math.atan2(-delta.Z, delta.X)
	for _, ratio in ipairs(options.rails or { 0.35, 0.85 }) do
		local center = fromPosition + delta * 0.5 + Vector3.new(0, height * ratio, 0)
		self:Block(CFrame.new(center) * CFrame.Angles(0, angle, 0), Vector3.new(length, height * 0.18, 0.6), {
			name = "FenceRail",
			color = color,
			material = options.material or Enum.Material.WoodPlanks,
		})
	end
end

--- Pont plat avec garde-corps.
function MapBuilder:Bridge(fromPosition, toPosition, width, options)
	options = options or {}
	local delta = toPosition - fromPosition
	local length = delta.Magnitude
	local center = fromPosition + delta * 0.5
	local angle = math.atan2(-delta.Z, delta.X)
	local baseCFrame = CFrame.new(center) * CFrame.Angles(0, angle, 0)
	self:Block(baseCFrame, Vector3.new(length, 1, width), {
		name = "BridgeDeck",
		color = options.color or Color3.fromRGB(140, 105, 70),
		material = options.material or Enum.Material.WoodPlanks,
	})
	if options.rails ~= false then
		for _, side in ipairs({ 1, -1 }) do
			self:Block(baseCFrame * CFrame.new(0, 2, side * width / 2), Vector3.new(length, 3, 0.5), {
				name = "BridgeRail",
				color = options.railColor or Color3.fromRGB(110, 80, 55),
				material = Enum.Material.WoodPlanks,
			})
		end
	end
end

--- Tour d'observation avec rampe d'acces en spirale simplifiee.
function MapBuilder:Tower(position, radius, height, options)
	options = options or {}
	local color = options.color or Color3.fromRGB(160, 155, 150)
	local levels = options.levels or 2
	for level = 1, levels do
		local y = position.Y + (height / levels) * level
		self:Block(Vector3.new(position.X, y, position.Z), Vector3.new(radius * 2, 1, radius * 2), {
			name = "TowerFloor",
			color = color,
			material = options.material or Enum.Material.Concrete,
		})
		-- Garde-corps ajoure
		for _, offset in ipairs({
			Vector3.new(radius, 0, 0), Vector3.new(-radius, 0, 0),
			Vector3.new(0, 0, radius), Vector3.new(0, 0, -radius),
		}) do
			local size = offset.X ~= 0 and Vector3.new(0.6, 3, radius * 2) or Vector3.new(radius * 2, 3, 0.6)
			self:Block(Vector3.new(position.X + offset.X, y + 2, position.Z + offset.Z), size, {
				name = "TowerRail",
				color = options.railColor or color,
				material = Enum.Material.Metal,
			})
		end
	end
	-- Piliers d'angle
	for _, offset in ipairs({
		Vector3.new(radius - 0.8, 0, radius - 0.8), Vector3.new(-radius + 0.8, 0, radius - 0.8),
		Vector3.new(radius - 0.8, 0, -radius + 0.8), Vector3.new(-radius + 0.8, 0, -radius + 0.8),
	}) do
		self:Block(Vector3.new(position.X + offset.X, position.Y + height / 2, position.Z + offset.Z), Vector3.new(1.4, height, 1.4), {
			name = "TowerPillar",
			color = options.pillarColor or Color3.fromRGB(120, 115, 110),
			material = Enum.Material.Metal,
		})
	end
end

--- Grand panneau decoratif avec du texte (habille les maps sans asset).
function MapBuilder:Sign(position, text, options)
	options = options or {}
	local board = self:Block(position, options.size or Vector3.new(16, 6, 0.6), {
		name = "Sign",
		color = options.color or Color3.fromRGB(35, 45, 60),
		material = Enum.Material.SmoothPlastic,
		rotation = options.rotation,
	})
	for _, face in ipairs({ Enum.NormalId.Front, Enum.NormalId.Back }) do
		local gui = Instance.new("SurfaceGui")
		gui.Face = face
		gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		gui.PixelsPerStud = 30
		gui.Parent = board
		local label = Instance.new("TextLabel")
		label.Size = UDim2.fromScale(1, 1)
		label.BackgroundTransparency = 1
		label.Text = text
		label.TextColor3 = options.textColor or Color3.fromRGB(120, 220, 255)
		label.Font = Enum.Font.GothamBold
		label.TextScaled = true
		label.Parent = gui
	end
	return board
end

--- Arbre stylise (tronc + houppier).
function MapBuilder:Tree(position, scale, options)
	options = options or {}
	scale = scale or 1
	self:Cylinder(
		CFrame.new(position + Vector3.new(0, 5 * scale, 0)) * CFrame.Angles(0, 0, math.rad(90)),
		Vector3.new(10 * scale, 2.2 * scale, 2.2 * scale),
		{ name = "Trunk", color = options.trunkColor or Color3.fromRGB(105, 75, 50), material = Enum.Material.Wood }
	)
	for index = 1, 3 do
		local y = 10 * scale + index * 2.2 * scale
		local diameter = (11 - index * 2.2) * scale
		self:Sphere(position + Vector3.new(0, y, 0), diameter, {
			name = "Leaves",
			color = options.leafColor or Color3.fromRGB(70, 140, 70),
			material = Enum.Material.Grass,
			canCollide = false,
		})
	end
end

--- Murs invisibles qui empechent de sortir de la map.
function MapBuilder:Bounds(width, depth, height)
	local thickness = 6
	local halfWidth = width / 2 + thickness / 2
	local halfDepth = depth / 2 + thickness / 2
	local options = {
		name = "Boundary",
		transparency = 1,
		material = Enum.Material.SmoothPlastic,
		color = Color3.fromRGB(255, 255, 255),
		castShadow = false,
	}
	self:Block(Vector3.new(0, height / 2, halfDepth), Vector3.new(width + thickness * 2, height, thickness), options)
	self:Block(Vector3.new(0, height / 2, -halfDepth), Vector3.new(width + thickness * 2, height, thickness), options)
	self:Block(Vector3.new(halfWidth, height / 2, 0), Vector3.new(thickness, height, depth + thickness * 2), options)
	self:Block(Vector3.new(-halfWidth, height / 2, 0), Vector3.new(thickness, height, depth + thickness * 2), options)
end

--- Execute `callback` deux fois : une fois par cote (1 puis -1).
--- Permet d'ecrire une moitie de map et d'obtenir une arene parfaitement symetrique.
function MapBuilder:Mirror(callback)
	callback(1)
	callback(-1)
end

return MapBuilder
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="14">
          <Properties>
            <string name="Name">Net</string>
            <string name="Source"><![CDATA[--[[
	Net
	Point d'acces unique aux RemoteEvent / RemoteFunction du jeu.

	Le serveur appelle Net.Init() une seule fois au demarrage : tous les remotes
	declares ci-dessous sont crees dans ReplicatedStorage.WaterWarsRemotes.
	Le client les recupere avec Net.Event(nom) / Net.Function(nom).

	Toute faute de frappe sur un nom de remote leve immediatement une erreur
	claire au lieu de produire un "attempt to index nil".
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local FOLDER_NAME = "WaterWarsRemotes"

local Net = {}

-- Evenements client -> serveur et serveur -> client.
Net.EVENTS = {
	-- client -> serveur
	"FireWeapon",
	"RequestReload",
	"RequestEquip",
	"RequestPurchase",
	"CastMapVote",
	"SetSprint",
	-- serveur -> client
	"ProjectileSpawned",
	"ImpactEffect",
	"MatchState",
	"ProfileUpdate",
	"Scoreboard",
	"KillFeed",
	"Notify",
	"MapVote",
	"HitMarker",
	"Damaged",
	"AmmoUpdate",
	"EffectState",
	"MapReady",
}

-- Appels client -> serveur avec valeur de retour.
Net.FUNCTIONS = {
	"GetProfile",
}

local eventSet = {}
for _, name in ipairs(Net.EVENTS) do
	eventSet[name] = true
end

local functionSet = {}
for _, name in ipairs(Net.FUNCTIONS) do
	functionSet[name] = true
end

local isServer = RunService:IsServer()
local cache = {}

local function getFolder()
	local folder = ReplicatedStorage:FindFirstChild(FOLDER_NAME)
	if folder then
		return folder
	end
	if isServer then
		local created = Instance.new("Folder")
		created.Name = FOLDER_NAME
		created.Parent = ReplicatedStorage
		return created
	end
	return ReplicatedStorage:WaitForChild(FOLDER_NAME)
end

local function resolve(name, className, set, label)
	if not set[name] then
		error(string.format("Net : %s inconnu '%s' (verifiez Shared/Net.luau)", label, tostring(name)), 3)
	end
	local cached = cache[name]
	if cached and cached.Parent then
		return cached
	end
	local folder = getFolder()
	local instance = folder:FindFirstChild(name)
	if not instance then
		if not isServer then
			instance = folder:WaitForChild(name)
		else
			local created = Instance.new(className)
			created.Name = name
			created.Parent = folder
			instance = created
		end
	end
	cache[name] = instance
	return instance
end

--- Cree tous les remotes. A appeler une seule fois, cote serveur.
function Net.Init()
	assert(isServer, "Net.Init() ne peut etre appele que depuis le serveur")
	local folder = getFolder()
	for _, name in ipairs(Net.EVENTS) do
		if not folder:FindFirstChild(name) then
			local remote = Instance.new("RemoteEvent")
			remote.Name = name
			remote.Parent = folder
		end
	end
	for _, name in ipairs(Net.FUNCTIONS) do
		if not folder:FindFirstChild(name) then
			local remote = Instance.new("RemoteFunction")
			remote.Name = name
			remote.Parent = folder
		end
	end
	return folder
end

--- Renvoie le RemoteEvent portant ce nom.
function Net.Event(name): RemoteEvent
	return resolve(name, "RemoteEvent", eventSet, "evenement") :: RemoteEvent
end

--- Renvoie la RemoteFunction portant ce nom.
function Net.Function(name): RemoteFunction
	return resolve(name, "RemoteFunction", functionSet, "fonction") :: RemoteFunction
end

return Net
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="15">
          <Properties>
            <string name="Name">Signal</string>
            <string name="Source"><![CDATA[--[[
	Signal
	Mini implementation d'evenement, plus legere qu'un BindableEvent et qui
	conserve les references d'instances (un BindableEvent serialise ses
	arguments, ce qui casserait le passage d'objets Player).
]]

local Signal = {}
Signal.__index = Signal

local Connection = {}
Connection.__index = Connection

function Connection:Disconnect()
	if self._disconnected then
		return
	end
	self._disconnected = true
	local handlers = self._signal._handlers
	local index = table.find(handlers, self)
	if index then
		table.remove(handlers, index)
	end
end

function Signal.new(name)
	return setmetatable({ _handlers = {}, _name = name or "Signal" }, Signal)
end

function Signal:Connect(callback)
	assert(type(callback) == "function", "Signal:Connect attend une fonction")
	local connection = setmetatable({ _signal = self, _callback = callback, _disconnected = false }, Connection)
	table.insert(self._handlers, connection)
	return connection
end

function Signal:Fire(...)
	-- Copie : un handler peut se deconnecter pendant l'iteration.
	local snapshot = table.clone(self._handlers)
	for _, connection in ipairs(snapshot) do
		if not connection._disconnected then
			local ok, err = pcall(connection._callback, ...)
			if not ok then
				warn(string.format("[WaterWars] Erreur dans un handler de %s : %s", self._name, tostring(err)))
			end
		end
	end
end

function Signal:DisconnectAll()
	for _, connection in ipairs(table.clone(self._handlers)) do
		connection:Disconnect()
	end
end

return Signal
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="16">
          <Properties>
            <string name="Name">Util</string>
            <string name="Source"><![CDATA[--[[
	Util
	Petites fonctions partagees entre le serveur et le client.
]]

local Util = {}

function Util.Clamp(value, minimum, maximum)
	if value < minimum then
		return minimum
	elseif value > maximum then
		return maximum
	end
	return value
end

function Util.Lerp(a, b, alpha)
	return a + (b - a) * alpha
end

--- Formate un nombre de secondes en "M:SS".
function Util.FormatTime(seconds)
	local total = math.max(0, math.floor(seconds + 0.5))
	return string.format("%d:%02d", math.floor(total / 60), total % 60)
end

--- Formate un entier avec des espaces tous les 3 chiffres (1 234 567).
function Util.FormatNumber(value)
	local text = tostring(math.floor(value))
	local sign = ""
	if string.sub(text, 1, 1) == "-" then
		sign = "-"
		text = string.sub(text, 2)
	end
	local out = ""
	local count = 0
	for index = #text, 1, -1 do
		out = string.sub(text, index, index) .. out
		count = count + 1
		if count % 3 == 0 and index > 1 then
			out = " " .. out
		end
	end
	return sign .. out
end

--- Melange un tableau sur place (Fisher-Yates) et le renvoie.
function Util.Shuffle(list, rng)
	for index = #list, 2, -1 do
		local swap
		if rng then
			swap = rng:NextInteger(1, index)
		else
			swap = math.random(1, index)
		end
		list[index], list[swap] = list[swap], list[index]
	end
	return list
end

--- Renvoie un element au hasard, ou nil si la liste est vide.
function Util.Pick(list, rng)
	if #list == 0 then
		return nil
	end
	if rng then
		return list[rng:NextInteger(1, #list)]
	end
	return list[math.random(1, #list)]
end

--- Applique une dispersion conique (en degres) a une direction unitaire.
function Util.ApplySpread(direction, spreadDegrees, rng)
	if spreadDegrees <= 0 then
		return direction.Unit
	end
	local unit = direction.Unit
	-- Base orthonormee autour de la direction de tir.
	local reference = Vector3.new(0, 1, 0)
	if math.abs(unit:Dot(reference)) > 0.99 then
		reference = Vector3.new(1, 0, 0)
	end
	local right = unit:Cross(reference).Unit
	local up = right:Cross(unit).Unit

	local angle, radius
	if rng then
		angle = rng:NextNumber() * math.pi * 2
		radius = math.sqrt(rng:NextNumber()) * math.rad(spreadDegrees)
	else
		angle = math.random() * math.pi * 2
		radius = math.sqrt(math.random()) * math.rad(spreadDegrees)
	end
	local offset = (right * math.cos(angle) + up * math.sin(angle)) * math.tan(radius)
	return (unit + offset).Unit
end

--- Renvoie le Humanoid et le Model d'une piece touchee, ou nil.
function Util.GetCharacterFromPart(part)
	local current = part
	while current and current ~= workspace do
		if current:IsA("Model") then
			local humanoid = current:FindFirstChildOfClass("Humanoid")
			if humanoid then
				return current, humanoid
			end
		end
		current = current.Parent
	end
	return nil, nil
end

--- Cree une instance et applique un dictionnaire de proprietes.
function Util.Create(className, properties, children)
	local instance = Instance.new(className)
	if properties then
		for key, value in pairs(properties) do
			if key ~= "Parent" then
				(instance :: any)[key] = value
			end
		end
	end
	if children then
		for _, child in ipairs(children) do
			child.Parent = instance
		end
	end
	if properties and properties.Parent then
		instance.Parent = properties.Parent
	end
	return instance
end

--- Detruit une instance apres un delai, sans bloquer l'appelant.
function Util.DestroyAfter(instance, delaySeconds)
	task.delay(delaySeconds, function()
		if instance and instance.Parent then
			instance:Destroy()
		end
	end)
end

--- Somme des valeurs d'un dictionnaire numerique.
function Util.Sum(dictionary)
	local total = 0
	for _, value in pairs(dictionary) do
		total = total + value
	end
	return total
end

--- Copie profonde d'une table de donnees simples.
function Util.DeepCopy(original)
	if type(original) ~= "table" then
		return original
	end
	local copy = {}
	for key, value in pairs(original) do
		copy[key] = Util.DeepCopy(value)
	end
	return copy
end

--- Nombre d'entrees d'un dictionnaire.
function Util.CountKeys(dictionary)
	local count = 0
	for _ in pairs(dictionary) do
		count = count + 1
	end
	return count
end

return Util
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
    <Item class="LocalScript" referent="17">
      <Properties>
        <string name="Name">WaterWarsClient</string>
        <string name="Source"><![CDATA[--[[
	Water Wars - point d'entree client
	Demarre les controleurs dans l'ordre. Chaque controleur est isole : si
	l'un d'eux echoue, les autres continuent de fonctionner et l'erreur est
	affichee clairement dans la console.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

--- Attend une instance, mais previent au lieu de bloquer indefiniment en
--- silence : un client qui attend un dossier absent est impossible a
--- diagnostiquer sans ce message.
local function waitFor(parent, name, timeout)
	local found = parent:WaitForChild(name, timeout or 15)
	if found then
		return found
	end
	warn(string.format(
		"[WaterWars] '%s' n'est toujours pas apparu dans %s apres %d s."
			.. " Le serveur n'a probablement pas demarre : regardez la console du serveur.",
		name,
		parent:GetFullName(),
		timeout or 15
	))
	return parent:WaitForChild(name)
end

-- On attend que le serveur ait publie les remotes avant de brancher quoi que ce soit.
waitFor(ReplicatedStorage, "WaterWars")
waitFor(ReplicatedStorage, "WaterWarsRemotes")

local ClientState = require(script:WaitForChild("ClientState"))
local EffectsController = require(script:WaitForChild("EffectsController"))
local HudController = require(script:WaitForChild("HudController"))
local ScoreboardController = require(script:WaitForChild("ScoreboardController"))
local ShopController = require(script:WaitForChild("ShopController"))
local SoundController = require(script:WaitForChild("SoundController"))
local VoteController = require(script:WaitForChild("VoteController"))
local WeaponController = require(script:WaitForChild("WeaponController"))

local CONTROLLERS = {
	{ name = "EffectsController", controller = EffectsController },
	{ name = "WeaponController", controller = WeaponController },
	{ name = "HudController", controller = HudController },
	{ name = "ScoreboardController", controller = ScoreboardController },
	{ name = "VoteController", controller = VoteController },
	{ name = "ShopController", controller = ShopController },
	{ name = "SoundController", controller = SoundController },
}

for _, entry in ipairs(CONTROLLERS) do
	local ok, err = pcall(entry.controller.Start)
	if not ok then
		warn(string.format("[WaterWars] Echec du demarrage de %s : %s", entry.name, tostring(err)))
	end
end

-- Etat initial : evite un HUD vide tant que le serveur n'a rien envoye.
ClientState.MatchChanged:Fire(ClientState.match)

print(string.format("[WaterWars] Client pret pour %s.", Players.LocalPlayer.DisplayName))
]]></string>
      </Properties>
      <Item class="ModuleScript" referent="18">
        <Properties>
          <string name="Name">ClientState</string>
          <string name="Source"><![CDATA[--[[
	ClientState
	Etat local partage entre les controleurs du client (match en cours, profil,
	munitions, equipe...). Chaque changement emet un signal : le HUD, la
	boutique et le tableau des scores s'y abonnent sans se connaitre.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local WaterWars = ReplicatedStorage:WaitForChild("WaterWars")
local Shared = WaterWars:WaitForChild("Shared")
local Config = WaterWars:WaitForChild("Config")

local Signal = require(Shared:WaitForChild("Signal"))
local Weapons = require(Config:WaitForChild("Weapons"))

local ClientState = {}

ClientState.match = {
	state = "Waiting",
	timeLeft = 0,
	mode = { id = "TeamSoak", name = "Bataille d'equipes", teamBased = true },
	map = nil,
	scores = { Blue = 0, Red = 0 },
	scoreLimit = 50,
	playerCount = 0,
	minPlayers = 1,
	result = nil,
}

ClientState.profile = {
	coins = 0,
	owned = {},
	loadout = { primary = Weapons.DefaultPrimary, secondary = Weapons.DefaultSecondary },
	stats = {},
}

ClientState.ammo = { weaponId = nil, current = 0, max = 0, reloading = false }
ClientState.scoreboard = {}
ClientState.vote = { options = {}, votes = {}, open = false, choice = nil, revision = 0 }

ClientState.MatchChanged = Signal.new("MatchChanged")
ClientState.ProfileChanged = Signal.new("ProfileChanged")
ClientState.AmmoChanged = Signal.new("AmmoChanged")
ClientState.ScoreboardChanged = Signal.new("ScoreboardChanged")
ClientState.VoteChanged = Signal.new("VoteChanged")

function ClientState.SetMatch(payload)
	if type(payload) ~= "table" then
		return
	end
	ClientState.match = payload
	ClientState.MatchChanged:Fire(payload)
end

function ClientState.SetProfile(payload)
	if type(payload) ~= "table" then
		return
	end
	ClientState.profile = payload
	ClientState.ProfileChanged:Fire(payload)
end

function ClientState.SetAmmo(weaponId, current, max, reloading)
	ClientState.ammo = {
		weaponId = weaponId,
		current = current or 0,
		max = max or 0,
		reloading = reloading == true,
	}
	ClientState.AmmoChanged:Fire(ClientState.ammo)
end

function ClientState.SetScoreboard(rows)
	if type(rows) ~= "table" then
		return
	end
	ClientState.scoreboard = rows
	ClientState.ScoreboardChanged:Fire(rows)
end

function ClientState.SetVote(payload)
	if type(payload) ~= "table" then
		return
	end
	if payload.phase == "open" then
		local revision = (ClientState.vote.revision or 0) + 1
		ClientState.vote = {
			options = payload.options or {},
			votes = {},
			open = true,
			choice = nil,
			revision = revision,
		}
	elseif payload.phase == "update" then
		ClientState.vote.votes = payload.votes or {}
	elseif payload.phase == "closed" then
		ClientState.vote.open = false
		ClientState.vote.chosen = payload.chosen
	end
	ClientState.VoteChanged:Fire(ClientState.vote)
end

--- Arme actuellement tenue (d'apres l'outil equipe), ou nil.
function ClientState.GetEquippedWeapon()
	local player = game:GetService("Players").LocalPlayer
	local character = player.Character
	if not character then
		return nil
	end
	local tool = character:FindFirstChildOfClass("Tool")
	if not tool then
		return nil
	end
	local id = tool:GetAttribute("WeaponId")
	if type(id) ~= "string" then
		return nil
	end
	return Weapons.Get(id), tool
end

return ClientState
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="19">
        <Properties>
          <string name="Name">EffectsController</string>
          <string name="Source"><![CDATA[--[[
	EffectsController
	Tout le visuel du combat cote client : gouttes d'eau, gerbes d'impact,
	flaques au sol et lueur de canon.

	Les projectiles affiches ici sont purement decoratifs (le serveur fait
	autorite sur les degats), mais ils suivent exactement la meme physique, ce
	qui donne une visee coherente.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local WaterWars = ReplicatedStorage:WaitForChild("WaterWars")
local Config = WaterWars:WaitForChild("Config")
local Shared = WaterWars:WaitForChild("Shared")

local Weapons = require(Config:WaitForChild("Weapons"))
local Net = require(Shared:WaitForChild("Net"))
local Util = require(Shared:WaitForChild("Util"))

local EffectsController = {}

local GRAVITY = 196.2
local MAX_DROPLETS = 260
local SMOKE_TEXTURE = "rbxasset://textures/particles/smoke_main.dds"

local localPlayer = Players.LocalPlayer
local rng = Random.new()

local container = nil
local pool = {}
local active = {}
local raycastParams = RaycastParams.new()

-- ----------------------------------------------------------------- gouttes

local function newDroplet()
	local part = Instance.new("Part")
	part.Name = "Droplet"
	part.Shape = Enum.PartType.Ball
	part.Material = Enum.Material.Neon
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	return part
end

local function acquire()
	local part = table.remove(pool)
	if not part then
		part = newDroplet()
	end
	part.Parent = container
	return part
end

local function release(part)
	part.Parent = nil
	if #pool < MAX_DROPLETS then
		table.insert(pool, part)
	else
		part:Destroy()
	end
end

-- ---------------------------------------------------------------- impacts

--- Gerbe d'eau + flaque a l'endroit de l'impact.
function EffectsController.Impact(position, normal, weapon, hitCharacter)
	if not container then
		return
	end
	local anchor = Instance.new("Part")
	anchor.Name = "Impact"
	anchor.Size = Vector3.new(0.2, 0.2, 0.2)
	anchor.CFrame = CFrame.new(position)
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanQuery = false
	anchor.CanTouch = false
	anchor.CastShadow = false
	anchor.Transparency = 1
	anchor.Parent = container

	local attachment = Instance.new("Attachment")
	attachment.Parent = anchor

	local emitter = Instance.new("ParticleEmitter")
	emitter.Texture = SMOKE_TEXTURE
	emitter.Color = ColorSequence.new(weapon.trail, weapon.color)
	emitter.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, hitCharacter and 1.8 or 1.2),
		NumberSequenceKeypoint.new(1, 0),
	})
	emitter.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.25),
		NumberSequenceKeypoint.new(1, 1),
	})
	emitter.Lifetime = NumberRange.new(0.25, 0.5)
	emitter.Speed = NumberRange.new(9, 18)
	emitter.SpreadAngle = Vector2.new(45, 45)
	emitter.Rate = 0
	emitter.Rotation = NumberRange.new(0, 360)
	emitter.LightEmission = 0.35
	emitter.Enabled = false
	emitter.Parent = attachment
	emitter:Emit(hitCharacter and 22 or 14)

	Debris:AddItem(anchor, 1.4)

	-- Flaque plaquee sur la surface touchee, qui s'estompe.
	if not hitCharacter then
		local puddle = Instance.new("Part")
		puddle.Name = "Puddle"
		puddle.Shape = Enum.PartType.Cylinder
		local radius = math.max(1.4, weapon.radius * 4 + weapon.splashRadius * 0.12)
		puddle.Size = Vector3.new(0.12, radius, radius)
		puddle.CFrame = CFrame.lookAt(position + normal * 0.06, position + normal * 1.06)
			* CFrame.Angles(0, math.rad(90), 0)
		puddle.Anchored = true
		puddle.CanCollide = false
		puddle.CanQuery = false
		puddle.CanTouch = false
		puddle.CastShadow = false
		puddle.Material = Enum.Material.SmoothPlastic
		puddle.Color = weapon.color
		puddle.Transparency = 0.35
		puddle.Parent = container

		TweenService:Create(puddle, TweenInfo.new(2.2, Enum.EasingStyle.Quad), {
			Transparency = 1,
			Size = Vector3.new(0.12, radius * 1.6, radius * 1.6),
		}):Play()
		Debris:AddItem(puddle, 2.4)
	end
end

--- Eclair lumineux a la sortie du canon.
function EffectsController.MuzzleFlash(tool, weapon)
	local handle = tool and tool:FindFirstChild("Handle")
	if not handle then
		return
	end
	local muzzle = handle:FindFirstChild("Muzzle")
	if not muzzle or not muzzle:IsA("Attachment") then
		return
	end
	local flash = Instance.new("PointLight")
	flash.Color = weapon.trail
	flash.Brightness = 4
	flash.Range = 12
	flash.Parent = handle
	Debris:AddItem(flash, 0.08)
end

-- ------------------------------------------------------------ projectiles

--- Cree les gouttes visibles d'un tir.
function EffectsController.SpawnVolley(weapon, origin, direction, chargeRatio)
	if not container then
		return
	end
	local scale = 1 + (weapon.chargeBonus - 1) * (chargeRatio or 0) * 0.3
	for _ = 1, weapon.pellets do
		if #active >= MAX_DROPLETS then
			break
		end
		local unit = Util.ApplySpread(direction, weapon.spread, rng)
		local part = acquire()
		local size = weapon.radius * 2 * scale
		part.Size = Vector3.new(size, size, size)
		part.Color = weapon.trail
		part.Transparency = 0.15
		part.CFrame = CFrame.new(origin)
		table.insert(active, {
			part = part,
			position = origin,
			velocity = unit * weapon.speed,
			gravity = weapon.gravity,
			expires = os.clock() + weapon.lifetime,
		})
	end
end

local function stepDroplets(deltaTime)
	if #active == 0 then
		return
	end
	local character = localPlayer.Character
	raycastParams.FilterType = Enum.RaycastFilterType.Exclude
	raycastParams.FilterDescendantsInstances = { container, character }
	raycastParams.IgnoreWater = true

	local currentTime = os.clock()
	local index = 1
	while index <= #active do
		local droplet = active[index]
		droplet.velocity = droplet.velocity - Vector3.new(0, GRAVITY * droplet.gravity * deltaTime, 0)
		local nextPosition = droplet.position + droplet.velocity * deltaTime

		local remove = false
		local hit = workspace:Raycast(droplet.position, nextPosition - droplet.position, raycastParams)
		if hit then
			remove = true
		else
			droplet.position = nextPosition
			droplet.part.CFrame = CFrame.new(nextPosition)
			if currentTime >= droplet.expires then
				remove = true
			end
		end

		if remove then
			release(droplet.part)
			active[index] = active[#active]
			active[#active] = nil
		else
			index = index + 1
		end
	end
end

function EffectsController.Start()
	container = Instance.new("Folder")
	container.Name = "WaterWarsEffects"
	container.Parent = workspace

	Net.Event("ProjectileSpawned").OnClientEvent:Connect(function(shooter, weaponId, origin, direction, charge)
		-- Le tireur a deja vu ses propres gouttes au moment du clic.
		if shooter == localPlayer then
			return
		end
		local weapon = Weapons.Get(weaponId)
		if weapon and typeof(origin) == "Vector3" and typeof(direction) == "Vector3" then
			EffectsController.SpawnVolley(weapon, origin, direction, charge)
		end
	end)

	Net.Event("ImpactEffect").OnClientEvent:Connect(function(position, normal, weaponId, hitCharacter)
		local weapon = Weapons.Get(weaponId)
		if not weapon or typeof(position) ~= "Vector3" then
			return
		end
		-- On n'affiche pas les impacts hors de vue : c'est du calcul gratuit.
		local camera = workspace.CurrentCamera
		if camera and (camera.CFrame.Position - position).Magnitude > 320 then
			return
		end
		EffectsController.Impact(position, typeof(normal) == "Vector3" and normal or Vector3.new(0, 1, 0), weapon, hitCharacter == true)
	end)

	RunService.RenderStepped:Connect(function(deltaTime)
		local ok, err = pcall(stepDroplets, math.min(deltaTime, 0.1))
		if not ok then
			warn("[WaterWars] Erreur d'affichage des gouttes : " .. tostring(err))
		end
	end)
end

return EffectsController
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="20">
        <Properties>
          <string name="Name">HudController</string>
          <string name="Source"><![CDATA[--[[
	HudController
	Interface de jeu : vie, endurance, reservoir d'eau, viseur dynamique,
	chronometre, scores d'equipe, journal des eliminations, notifications,
	indicateurs de bonus et ecran de reapparition.

	Tout est construit en code, sans aucune image : le HUD s'affiche donc
	correctement des la premiere execution, sans asset a importer.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local WaterWars = ReplicatedStorage:WaitForChild("WaterWars")
local Config = WaterWars:WaitForChild("Config")
local Shared = WaterWars:WaitForChild("Shared")

local GameConfig = require(Config:WaitForChild("GameConfig"))
local Net = require(Shared:WaitForChild("Net"))
local Util = require(Shared:WaitForChild("Util"))

local ClientState = require(script.Parent:WaitForChild("ClientState"))
local UIKit = require(script.Parent:WaitForChild("UIKit"))
local WeaponController = require(script.Parent:WaitForChild("WeaponController"))

local HudController = {}

local Theme = UIKit.Theme
local localPlayer = Players.LocalPlayer

-- Références vers les éléments d'interface, remplies à la construction.
local ui: { [string]: any } = {}
local killFeedEntries = {}
local notifications = {}
local hitMarkerUntil = 0
local damageFlashUntil = 0
local crosshairSpread = 0
local respawnAt = 0

local NOTIFICATION_COLORS = {
	good = Theme.Good,
	bad = Theme.Bad,
	info = Theme.Accent,
}

-- ----------------------------------------------------------- construction

local function buildTopBar(screen)
	local bar = UIKit.Panel(screen, UDim2.fromOffset(430, 74), UDim2.new(0.5, 0, 0, 12), Vector2.new(0.5, 0))
	ui.topBar = bar

	ui.timer = UIKit.Label(bar, "0:00", UDim2.fromOffset(150, 40), UDim2.new(0.5, 0, 0, 4), {
		anchor = Vector2.new(0.5, 0),
		align = Enum.TextXAlignment.Center,
		font = Theme.FontBold,
		textSize = 34,
	})
	ui.modeLabel = UIKit.Label(bar, "", UDim2.fromOffset(410, 20), UDim2.new(0.5, 0, 0, 46), {
		anchor = Vector2.new(0.5, 0),
		align = Enum.TextXAlignment.Center,
		color = Theme.TextDim,
		textSize = 14,
	})

	ui.scoreBlue = UIKit.Label(bar, "0", UDim2.fromOffset(90, 46), UDim2.new(0, 10, 0, 6), {
		align = Enum.TextXAlignment.Center,
		font = Theme.FontBold,
		textSize = 30,
		color = GameConfig.Teams[1].color,
	})
	ui.scoreRed = UIKit.Label(bar, "0", UDim2.fromOffset(90, 46), UDim2.new(1, -100, 0, 6), {
		align = Enum.TextXAlignment.Center,
		font = Theme.FontBold,
		textSize = 30,
		color = GameConfig.Teams[2].color,
	})
end

local function buildVitals(screen)
	local panel = UIKit.Panel(screen, UDim2.fromOffset(300, 96), UDim2.new(0, 18, 1, -18), Vector2.new(0, 1))
	ui.vitals = panel

	UIKit.Label(panel, "SOAK", UDim2.fromOffset(60, 16), UDim2.fromOffset(12, 8), {
		color = Theme.TextDim, textSize = 12, font = Theme.FontBold,
	})
	ui.healthText = UIKit.Label(panel, "100", UDim2.fromOffset(70, 16), UDim2.new(1, -82, 0, 8), {
		color = Theme.TextDim, textSize = 12, align = Enum.TextXAlignment.Right, font = Theme.FontBold,
	})
	local _, healthFill = UIKit.Bar(panel, UDim2.new(1, -24, 0, 18), UDim2.fromOffset(12, 26), Theme.Good)
	ui.healthFill = healthFill

	UIKit.Label(panel, "ENDURANCE", UDim2.fromOffset(110, 14), UDim2.fromOffset(12, 50), {
		color = Theme.TextDim, textSize = 11, font = Theme.FontBold,
	})
	local _, staminaFill = UIKit.Bar(panel, UDim2.new(1, -24, 0, 10), UDim2.fromOffset(12, 66), Theme.Warn, { radius = 4 })
	ui.staminaFill = staminaFill

	ui.effects = Instance.new("Frame")
	ui.effects.Size = UDim2.fromOffset(300, 28)
	ui.effects.Position = UDim2.new(0, 18, 1, -124)
	ui.effects.AnchorPoint = Vector2.new(0, 1)
	ui.effects.BackgroundTransparency = 1
	ui.effects.Parent = screen
	UIKit.ListLayout(ui.effects, 6, Enum.FillDirection.Horizontal)
end

local function buildWeaponPanel(screen)
	local panel = UIKit.Panel(screen, UDim2.fromOffset(300, 96), UDim2.new(1, -18, 1, -18), Vector2.new(1, 1))
	ui.weaponPanel = panel

	ui.weaponName = UIKit.Label(panel, "Aucune arme", UDim2.new(1, -24, 0, 22), UDim2.fromOffset(12, 8), {
		font = Theme.FontBold, textSize = 18, align = Enum.TextXAlignment.Right,
	})
	ui.weaponCategory = UIKit.Label(panel, "", UDim2.new(1, -24, 0, 14), UDim2.fromOffset(12, 30), {
		color = Theme.TextDim, textSize = 12, align = Enum.TextXAlignment.Right,
	})
	local _, waterFill = UIKit.Bar(panel, UDim2.new(1, -24, 0, 16), UDim2.fromOffset(12, 50), Theme.Accent)
	ui.waterFill = waterFill
	ui.ammoText = UIKit.Label(panel, "0 / 0", UDim2.new(1, -24, 0, 18), UDim2.fromOffset(12, 70), {
		color = Theme.TextDim, textSize = 14, align = Enum.TextXAlignment.Right, font = Theme.FontBold,
	})
end

local function buildCrosshair(screen)
	local holder = Instance.new("Frame")
	holder.Name = "Crosshair"
	holder.Size = UDim2.fromOffset(120, 120)
	holder.Position = UDim2.fromScale(0.5, 0.5)
	holder.AnchorPoint = Vector2.new(0.5, 0.5)
	holder.BackgroundTransparency = 1
	holder.Parent = screen
	ui.crosshair = holder

	ui.crossLines = {}
	local directions = {
		{ anchor = Vector2.new(0.5, 1), pos = UDim2.new(0.5, 0, 0.5, 0), size = UDim2.fromOffset(2, 10), axis = "y", sign = -1 },
		{ anchor = Vector2.new(0.5, 0), pos = UDim2.new(0.5, 0, 0.5, 0), size = UDim2.fromOffset(2, 10), axis = "y", sign = 1 },
		{ anchor = Vector2.new(1, 0.5), pos = UDim2.new(0.5, 0, 0.5, 0), size = UDim2.fromOffset(10, 2), axis = "x", sign = -1 },
		{ anchor = Vector2.new(0, 0.5), pos = UDim2.new(0.5, 0, 0.5, 0), size = UDim2.fromOffset(10, 2), axis = "x", sign = 1 },
	}
	for _, definition in ipairs(directions) do
		local line = Instance.new("Frame")
		line.Size = definition.size
		line.AnchorPoint = definition.anchor
		line.Position = definition.pos
		line.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
		line.BorderSizePixel = 0
		line.Parent = holder
		table.insert(ui.crossLines, { frame = line, axis = definition.axis, sign = definition.sign })
	end

	local dot = Instance.new("Frame")
	dot.Size = UDim2.fromOffset(2, 2)
	dot.AnchorPoint = Vector2.new(0.5, 0.5)
	dot.Position = UDim2.fromScale(0.5, 0.5)
	dot.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	dot.BorderSizePixel = 0
	dot.Parent = holder

	-- Marqueur de touche : quatre traits en croix qui apparaissent brievement.
	ui.hitMarker = Instance.new("Frame")
	ui.hitMarker.Size = UDim2.fromOffset(28, 28)
	ui.hitMarker.AnchorPoint = Vector2.new(0.5, 0.5)
	ui.hitMarker.Position = UDim2.fromScale(0.5, 0.5)
	ui.hitMarker.BackgroundTransparency = 1
	ui.hitMarker.Visible = false
	ui.hitMarker.Parent = holder
	for _, rotation in ipairs({ 45, 135, 225, 315 }) do
		local tick = Instance.new("Frame")
		tick.Size = UDim2.fromOffset(2, 9)
		tick.AnchorPoint = Vector2.new(0.5, 0.5)
		tick.Position = UDim2.new(0.5, math.cos(math.rad(rotation)) * 11, 0.5, math.sin(math.rad(rotation)) * 11)
		tick.Rotation = rotation + 90
		tick.BackgroundColor3 = Color3.fromRGB(255, 90, 90)
		tick.BorderSizePixel = 0
		tick.Parent = ui.hitMarker
	end

	-- Barre de charge des armes a charge.
	local chargeBack = Instance.new("Frame")
	chargeBack.Size = UDim2.fromOffset(120, 6)
	chargeBack.AnchorPoint = Vector2.new(0.5, 0)
	chargeBack.Position = UDim2.new(0.5, 0, 0.5, 40)
	chargeBack.BackgroundColor3 = Color3.fromRGB(10, 14, 20)
	chargeBack.BackgroundTransparency = 0.3
	chargeBack.BorderSizePixel = 0
	chargeBack.Visible = false
	chargeBack.Parent = screen
	UIKit.Corner(chargeBack, 3)
	local chargeFill = Instance.new("Frame")
	chargeFill.Size = UDim2.fromScale(0, 1)
	chargeFill.BackgroundColor3 = Theme.Warn
	chargeFill.BorderSizePixel = 0
	chargeFill.Parent = chargeBack
	UIKit.Corner(chargeFill, 3)
	ui.chargeBack = chargeBack
	ui.chargeFill = chargeFill
end

local function buildFeeds(screen)
	ui.killFeed = Instance.new("Frame")
	ui.killFeed.Size = UDim2.fromOffset(360, 200)
	ui.killFeed.Position = UDim2.new(1, -18, 0, 100)
	ui.killFeed.AnchorPoint = Vector2.new(1, 0)
	ui.killFeed.BackgroundTransparency = 1
	ui.killFeed.Parent = screen
	local layout = UIKit.ListLayout(ui.killFeed, 4)
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Right

	ui.notifications = Instance.new("Frame")
	ui.notifications.Size = UDim2.fromOffset(460, 160)
	ui.notifications.Position = UDim2.new(0.5, 0, 0, 100)
	ui.notifications.AnchorPoint = Vector2.new(0.5, 0)
	ui.notifications.BackgroundTransparency = 1
	ui.notifications.Parent = screen
	local notificationLayout = UIKit.ListLayout(ui.notifications, 6)
	notificationLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center

	-- Vignette rouge quand on prend des degats.
	ui.damageFlash = Instance.new("Frame")
	ui.damageFlash.Size = UDim2.fromScale(1, 1)
	ui.damageFlash.BackgroundColor3 = Color3.fromRGB(180, 20, 30)
	ui.damageFlash.BackgroundTransparency = 1
	ui.damageFlash.BorderSizePixel = 0
	ui.damageFlash.ZIndex = 0
	ui.damageFlash.Parent = screen
end

local function buildOverlay(screen)
	ui.overlay = Instance.new("Frame")
	ui.overlay.Size = UDim2.fromScale(1, 1)
	ui.overlay.BackgroundColor3 = Color3.fromRGB(4, 8, 14)
	ui.overlay.BackgroundTransparency = 0.45
	ui.overlay.BorderSizePixel = 0
	ui.overlay.Visible = false
	ui.overlay.ZIndex = 5
	ui.overlay.Parent = screen

	ui.overlayTitle = UIKit.Label(ui.overlay, "", UDim2.new(1, 0, 0, 56), UDim2.new(0.5, 0, 0.42, 0), {
		anchor = Vector2.new(0.5, 0.5),
		align = Enum.TextXAlignment.Center,
		font = Theme.FontBold,
		textSize = 46,
	})
	ui.overlayTitle.ZIndex = 6
	ui.overlaySubtitle = UIKit.Label(ui.overlay, "", UDim2.new(1, 0, 0, 30), UDim2.new(0.5, 0, 0.42, 42), {
		anchor = Vector2.new(0.5, 0.5),
		align = Enum.TextXAlignment.Center,
		color = Theme.TextDim,
		textSize = 20,
	})
	ui.overlaySubtitle.ZIndex = 6
end

-- ----------------------------------------------------------- alimentation

local function pushNotification(message, kind)
	if type(message) ~= "string" or #message == 0 then
		return
	end
	local label = UIKit.Label(ui.notifications, message, UDim2.fromOffset(460, 26), nil, {
		align = Enum.TextXAlignment.Center,
		color = NOTIFICATION_COLORS[kind] or Theme.Text,
		font = Theme.FontBold,
		textSize = 18,
		stroke = true,
	})
	label.LayoutOrder = -math.floor(os.clock() * 100)
	table.insert(notifications, label)
	if #notifications > 5 then
		local oldest = table.remove(notifications, 1)
		if oldest then
			oldest:Destroy()
		end
	end
	task.delay(4, function()
		if label.Parent then
			TweenService:Create(label, TweenInfo.new(0.5), { TextTransparency = 1 }):Play()
			task.wait(0.5)
			local index = table.find(notifications, label)
			if index then
				table.remove(notifications, index)
			end
			label:Destroy()
		end
	end)
end

local function teamColor(teamId)
	for _, definition in ipairs(GameConfig.Teams) do
		if definition.id == teamId then
			return definition.color
		end
	end
	return Theme.Text
end

local function pushKillFeed(entry)
	if type(entry) ~= "table" then
		return
	end
	local killerText = entry.killer or "L'environnement"
	local weaponText = entry.weapon and (" [" .. entry.weapon .. "] ") or " a trempe "
	local frame = Instance.new("Frame")
	frame.Size = UDim2.fromOffset(360, 24)
	frame.BackgroundColor3 = Theme.Panel
	frame.BackgroundTransparency = 0.3
	frame.BorderSizePixel = 0
	frame.LayoutOrder = -math.floor(os.clock() * 100)
	frame.Parent = ui.killFeed
	UIKit.Corner(frame, 6)

	local label = UIKit.Label(frame, "", UDim2.new(1, -16, 1, 0), UDim2.fromOffset(8, 0), {
		align = Enum.TextXAlignment.Right,
		textSize = 14,
		richText = true,
	})
	local killerColor = teamColor(entry.killerTeam)
	local victimColor = teamColor(entry.victimTeam)
	label.Text = string.format(
		'<font color="#%s">%s</font>%s<font color="#%s">%s</font>',
		killerColor:ToHex(),
		killerText,
		weaponText,
		victimColor:ToHex(),
		entry.victim or "?"
	)

	table.insert(killFeedEntries, frame)
	if #killFeedEntries > 6 then
		local oldest = table.remove(killFeedEntries, 1)
		if oldest then
			oldest:Destroy()
		end
	end
	task.delay(7, function()
		local index = table.find(killFeedEntries, frame)
		if index then
			table.remove(killFeedEntries, index)
		end
		if frame.Parent then
			frame:Destroy()
		end
	end)
end

local function refreshMatch()
	local match = ClientState.match
	ui.timer.Text = Util.FormatTime(match.timeLeft or 0)
	ui.scoreBlue.Text = tostring((match.scores and match.scores.Blue) or 0)
	ui.scoreRed.Text = tostring((match.scores and match.scores.Red) or 0)

	local teamBased = match.mode and match.mode.teamBased
	ui.scoreBlue.Visible = teamBased == true
	ui.scoreRed.Visible = teamBased == true

	local pieces = {}
	if match.mode then
		table.insert(pieces, match.mode.name)
	end
	if match.map then
		table.insert(pieces, match.map.name)
	end
	ui.modeLabel.Text = table.concat(pieces, "  -  ")

	-- Bandeau plein ecran entre les manches.
	local state = match.state
	if state == "Active" then
		ui.overlay.Visible = false
	elseif state == "Waiting" then
		ui.overlay.Visible = true
		ui.overlayTitle.Text = "En attente de joueurs"
		ui.overlaySubtitle.Text = string.format(
			"%d / %d joueurs connectes",
			match.playerCount or 0,
			match.minPlayers or 1
		)
	elseif state == "Vote" then
		ui.overlay.Visible = false
	elseif state == "Loading" then
		ui.overlay.Visible = true
		ui.overlayTitle.Text = "Chargement du terrain"
		ui.overlaySubtitle.Text = match.map and match.map.name or ""
	elseif state == "Results" then
		ui.overlay.Visible = true
		local result = match.result
		ui.overlayTitle.Text = result and result.message or "Manche terminee"
		ui.overlaySubtitle.Text = result
			and string.format("%s  -  %d contre %d", result.mapName or "", result.scores.Blue, result.scores.Red)
			or ""
	end
end

local function refreshAmmo()
	local ammo = ClientState.ammo
	local weapon = ClientState.GetEquippedWeapon()
	if weapon then
		ui.weaponName.Text = weapon.name
		ui.weaponCategory.Text = string.format("%s  -  %s", weapon.rarityName, weapon.desc)
		ui.weaponName.TextColor3 = weapon.rarityColor
	else
		ui.weaponName.Text = "Aucune arme"
		ui.weaponCategory.Text = ""
		ui.weaponName.TextColor3 = Theme.TextDim
	end

	local ratio = 0
	if ammo.max > 0 then
		ratio = ammo.current / ammo.max
	end
	ui.waterFill.Size = UDim2.fromScale(math.clamp(ratio, 0, 1), 1)
	ui.waterFill.BackgroundColor3 = ratio < 0.25 and Theme.Bad or Theme.Accent
	if ammo.reloading then
		ui.ammoText.Text = "RECHARGEMENT..."
		ui.ammoText.TextColor3 = Theme.Warn
	else
		ui.ammoText.Text = string.format("%d / %d", math.floor(ammo.current), math.floor(ammo.max))
		ui.ammoText.TextColor3 = Theme.TextDim
	end
end

local function refreshEffects()
	for _, child in ipairs(ui.effects:GetChildren()) do
		if child:IsA("TextLabel") then
			child:Destroy()
		end
	end
	local character = localPlayer.Character
	if not character then
		return
	end
	local now = os.clock()
	local badges = {
		{ attribute = "SpeedBoostUntil", name = "TURBO", color = Color3.fromRGB(255, 225, 60) },
		{ attribute = "DamageBoostUntil", name = "PRESSION", color = Color3.fromRGB(255, 130, 60) },
		{ attribute = "ShieldUntil", name = "BOUCLIER", color = Color3.fromRGB(120, 230, 255) },
		{ attribute = "ProtectedUntil", name = "PROTEGE", color = Color3.fromRGB(160, 255, 170) },
		{ attribute = "SlowUntil", name = "GELE", color = Color3.fromRGB(150, 200, 255) },
	}
	for index, badge in ipairs(badges) do
		local value = character:GetAttribute(badge.attribute)
		if type(value) == "number" and value > now then
			local label = UIKit.Label(ui.effects, string.format("%s %.0fs", badge.name, value - now), UDim2.fromOffset(104, 24), nil, {
				align = Enum.TextXAlignment.Center,
				color = badge.color,
				font = Theme.FontBold,
				textSize = 13,
				backgroundTransparency = 0.25,
				backgroundColor = Theme.Panel,
				layoutOrder = index,
			})
			UIKit.Corner(label, 6)
		end
	end
end

local function updatePerFrame(deltaTime)
	local character = localPlayer.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")

	-- Vie
	local healthRatio = 0
	if humanoid and humanoid.MaxHealth > 0 then
		healthRatio = humanoid.Health / humanoid.MaxHealth
	end
	ui.healthFill.Size = UDim2.fromScale(math.clamp(healthRatio, 0, 1), 1)
	ui.healthFill.BackgroundColor3 = healthRatio > 0.5 and Theme.Good
		or (healthRatio > 0.25 and Theme.Warn or Theme.Bad)
	ui.healthText.Text = tostring(math.max(0, math.floor((humanoid and humanoid.Health or 0) + 0.5)))

	-- Endurance
	local stamina = character and character:GetAttribute("Stamina")
	local staminaRatio = type(stamina) == "number" and stamina / GameConfig.StaminaMax or 1
	ui.staminaFill.Size = UDim2.fromScale(math.clamp(staminaRatio, 0, 1), 1)

	-- Viseur : s'ouvre quand on bouge et selon la dispersion de l'arme.
	local weapon = ClientState.GetEquippedWeapon()
	local baseGap = 6
	if weapon then
		baseGap = 5 + weapon.spread * 1.6
	end
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local speed = root and (root :: BasePart).AssemblyLinearVelocity.Magnitude or 0
	local target = baseGap + math.min(18, speed * 0.45)
	if WeaponController.IsAiming() then
		target = target * 0.55
	end
	crosshairSpread = crosshairSpread + (target - crosshairSpread) * math.min(1, deltaTime * 10)
	for _, line in ipairs(ui.crossLines) do
		if line.axis == "y" then
			line.frame.Position = UDim2.new(0.5, 0, 0.5, line.sign * crosshairSpread)
		else
			line.frame.Position = UDim2.new(0.5, line.sign * crosshairSpread, 0.5, 0)
		end
	end
	ui.crosshair.Visible = humanoid ~= nil and humanoid.Health > 0

	-- Charge
	local charge = WeaponController.GetCharge()
	ui.chargeBack.Visible = charge > 0.02
	ui.chargeFill.Size = UDim2.fromScale(charge, 1)
	ui.chargeFill.BackgroundColor3 = charge >= 0.99 and Theme.Good or Theme.Warn

	-- Marqueur de touche et vignette de degats
	local now = os.clock()
	ui.hitMarker.Visible = now < hitMarkerUntil
	local flash = math.max(0, damageFlashUntil - now)
	ui.damageFlash.BackgroundTransparency = 1 - math.min(0.35, flash * 0.9)

	-- Ecran de reapparition
	if respawnAt > now and (not humanoid or humanoid.Health <= 0) then
		ui.overlay.Visible = true
		ui.overlayTitle.Text = "Vous etes trempe !"
		ui.overlaySubtitle.Text = string.format("Reapparition dans %.0f s", respawnAt - now)
	elseif respawnAt > 0 and now >= respawnAt then
		respawnAt = 0
		refreshMatch()
	end
end

function HudController.Start()
	local screen = UIKit.Screen("WaterWarsHud", 2)
	buildTopBar(screen)
	buildVitals(screen)
	buildWeaponPanel(screen)
	buildCrosshair(screen)
	buildFeeds(screen)
	buildOverlay(screen)

	ClientState.MatchChanged:Connect(refreshMatch)
	ClientState.AmmoChanged:Connect(refreshAmmo)
	refreshMatch()
	refreshAmmo()

	Net.Event("MatchState").OnClientEvent:Connect(ClientState.SetMatch)
	Net.Event("Scoreboard").OnClientEvent:Connect(ClientState.SetScoreboard)
	Net.Event("ProfileUpdate").OnClientEvent:Connect(ClientState.SetProfile)
	Net.Event("MapVote").OnClientEvent:Connect(ClientState.SetVote)
	Net.Event("Notify").OnClientEvent:Connect(pushNotification)
	Net.Event("KillFeed").OnClientEvent:Connect(pushKillFeed)

	Net.Event("HitMarker").OnClientEvent:Connect(function(_damage, killed)
		hitMarkerUntil = os.clock() + (killed and 0.35 or 0.16)
	end)

	Net.Event("Damaged").OnClientEvent:Connect(function()
		damageFlashUntil = os.clock() + 0.4
	end)

	Net.Event("MapReady").OnClientEvent:Connect(function(map)
		if type(map) == "table" and map.name then
			pushNotification(string.format("%s - %s", map.name, map.theme or ""), "info")
		end
	end)

	-- Detecte la mort pour afficher le compte a rebours de reapparition.
	local function watchCharacter(character)
		local humanoid = character:WaitForChild("Humanoid", 10)
		if humanoid and humanoid:IsA("Humanoid") then
			humanoid.Died:Connect(function()
				respawnAt = os.clock() + GameConfig.RespawnTime
			end)
		end
		-- Le changement d'arme met le panneau a jour.
		character.ChildAdded:Connect(function(child)
			if child:IsA("Tool") then
				task.defer(refreshAmmo)
			end
		end)
		character.ChildRemoved:Connect(function(child)
			if child:IsA("Tool") then
				task.defer(refreshAmmo)
			end
		end)
	end

	if localPlayer.Character then
		task.spawn(watchCharacter, localPlayer.Character)
	end
	localPlayer.CharacterAdded:Connect(function(character)
		respawnAt = 0
		task.spawn(watchCharacter, character)
	end)

	local effectAccumulator = 0
	RunService.RenderStepped:Connect(function(deltaTime)
		local ok, err = pcall(updatePerFrame, math.min(deltaTime, 0.1))
		if not ok then
			warn("[WaterWars] Erreur du HUD : " .. tostring(err))
		end
		effectAccumulator = effectAccumulator + deltaTime
		if effectAccumulator >= 0.4 then
			effectAccumulator = 0
			pcall(refreshEffects)
		end
	end)

	-- Le chronometre descend entre deux messages du serveur.
	task.spawn(function()
		while true do
			task.wait(0.25)
			local match = ClientState.match
			if type(match.timeLeft) == "number" and match.timeLeft > 0 then
				match.timeLeft = math.max(0, match.timeLeft - 0.25)
				ui.timer.Text = Util.FormatTime(match.timeLeft)
			end
		end
	end)
end

return HudController
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="21">
        <Properties>
          <string name="Name">ScoreboardController</string>
          <string name="Source"><![CDATA[--[[
	ScoreboardController
	Tableau des scores affiche tant que la touche Tab est maintenue.
	Les joueurs sont regroupes par equipe en mode par equipes, et classes par
	score en chacun pour soi.
]]

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local WaterWars = ReplicatedStorage:WaitForChild("WaterWars")
local GameConfig = require(WaterWars:WaitForChild("Config"):WaitForChild("GameConfig"))

local ClientState = require(script.Parent:WaitForChild("ClientState"))
local UIKit = require(script.Parent:WaitForChild("UIKit"))

local ScoreboardController = {}

local Theme = UIKit.Theme
local localPlayer = Players.LocalPlayer

local screen = nil
local rowsHolder = nil
local headerLabel = nil
local rowFrames = {}

local function teamColor(teamId)
	for _, definition in ipairs(GameConfig.Teams) do
		if definition.id == teamId then
			return definition.color
		end
	end
	return Theme.TextDim
end

local function clearRows()
	for _, frame in ipairs(rowFrames) do
		frame:Destroy()
	end
	table.clear(rowFrames)
end

local function addHeaderRow(text, color, order)
	local frame = Instance.new("Frame")
	frame.Size = UDim2.new(1, 0, 0, 26)
	frame.BackgroundTransparency = 1
	frame.LayoutOrder = order
	frame.Parent = rowsHolder
	UIKit.Label(frame, text, UDim2.new(1, 0, 1, 0), nil, {
		font = Theme.FontBold, textSize = 16, color = color,
	})
	table.insert(rowFrames, frame)
end

local function addPlayerRow(row, order)
	local frame = Instance.new("Frame")
	frame.Size = UDim2.new(1, 0, 0, 28)
	frame.BackgroundColor3 = row.userId == localPlayer.UserId and Theme.AccentDark or Theme.Panel
	frame.BackgroundTransparency = row.userId == localPlayer.UserId and 0.25 or 0.55
	frame.BorderSizePixel = 0
	frame.LayoutOrder = order
	frame.Parent = rowsHolder
	UIKit.Corner(frame, 6)

	UIKit.Label(frame, row.name, UDim2.new(0.45, 0, 1, 0), UDim2.fromOffset(12, 0), {
		textSize = 15, color = teamColor(row.team),
	})
	local columns = {
		{ value = row.score, width = 0.16 },
		{ value = row.kills, width = 0.13 },
		{ value = row.assists, width = 0.13 },
		{ value = row.deaths, width = 0.13 },
	}
	local offset = 0.45
	for _, column in ipairs(columns) do
		UIKit.Label(frame, tostring(column.value or 0), UDim2.new(column.width, 0, 1, 0), UDim2.fromScale(offset, 0), {
			textSize = 15, align = Enum.TextXAlignment.Center, font = Theme.FontBold,
		})
		offset = offset + column.width
	end
	table.insert(rowFrames, frame)
end

local function refresh()
	if not screen or not screen.Enabled then
		return
	end
	clearRows()

	local match = ClientState.match
	local rows = ClientState.scoreboard
	headerLabel.Text = string.format(
		"%s  -  %s",
		match.mode and match.mode.name or "",
		match.map and match.map.name or "Vestiaire"
	)

	local order = 0
	if match.mode and match.mode.teamBased then
		for _, definition in ipairs(GameConfig.Teams) do
			local teamRows = {}
			for _, row in ipairs(rows) do
				if row.team == definition.id then
					table.insert(teamRows, row)
				end
			end
			order = order + 1
			addHeaderRow(
				string.format("%s  -  %d", definition.name, (match.scores and match.scores[definition.id]) or 0),
				definition.color,
				order
			)
			for _, row in ipairs(teamRows) do
				order = order + 1
				addPlayerRow(row, order)
			end
		end
		-- Joueurs sans equipe (viennent de se connecter).
		local neutral = {}
		for _, row in ipairs(rows) do
			if row.team == nil then
				table.insert(neutral, row)
			end
		end
		if #neutral > 0 then
			order = order + 1
			addHeaderRow("Spectateurs", Theme.TextDim, order)
			for _, row in ipairs(neutral) do
				order = order + 1
				addPlayerRow(row, order)
			end
		end
	else
		order = order + 1
		addHeaderRow("Classement", Theme.Accent, order)
		for _, row in ipairs(rows) do
			order = order + 1
			addPlayerRow(row, order)
		end
	end
end

local function build()
	screen = UIKit.Screen("WaterWarsScoreboard", 4)
	screen.Enabled = false

	local panel = UIKit.Panel(screen, UDim2.fromOffset(660, 480), UDim2.fromScale(0.5, 0.5), Vector2.new(0.5, 0.5))

	UIKit.Label(panel, "TABLEAU DES SCORES", UDim2.new(1, -24, 0, 26), UDim2.fromOffset(16, 12), {
		font = Theme.FontBold, textSize = 22,
	})
	headerLabel = UIKit.Label(panel, "", UDim2.new(1, -24, 0, 18), UDim2.fromOffset(16, 38), {
		textSize = 14, color = Theme.TextDim,
	})

	local columns = Instance.new("Frame")
	columns.Size = UDim2.new(1, -24, 0, 18)
	columns.Position = UDim2.fromOffset(12, 62)
	columns.BackgroundTransparency = 1
	columns.Parent = panel
	UIKit.Label(columns, "JOUEUR", UDim2.new(0.45, 0, 1, 0), UDim2.fromOffset(12, 0), {
		textSize = 12, color = Theme.TextDim, font = Theme.FontBold,
	})
	local headers = { "SCORE", "ELIM.", "ASSIST.", "MORTS" }
	local widths = { 0.16, 0.13, 0.13, 0.13 }
	local offset = 0.45
	for index, title in ipairs(headers) do
		UIKit.Label(columns, title, UDim2.new(widths[index], 0, 1, 0), UDim2.fromScale(offset, 0), {
			textSize = 12, color = Theme.TextDim, align = Enum.TextXAlignment.Center, font = Theme.FontBold,
		})
		offset = offset + widths[index]
	end

	local scroll = Instance.new("ScrollingFrame")
	scroll.Size = UDim2.new(1, -24, 1, -100)
	scroll.Position = UDim2.fromOffset(12, 86)
	scroll.BackgroundTransparency = 1
	scroll.BorderSizePixel = 0
	scroll.ScrollBarThickness = 4
	scroll.ScrollBarImageColor3 = Theme.Accent
	scroll.CanvasSize = UDim2.new()
	scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
	scroll.Parent = panel
	UIKit.ListLayout(scroll, 4)
	rowsHolder = scroll
end

function ScoreboardController.SetVisible(visible)
	if screen then
		screen.Enabled = visible
		if visible then
			refresh()
		end
	end
end

function ScoreboardController.Start()
	build()

	ClientState.ScoreboardChanged:Connect(refresh)
	ClientState.MatchChanged:Connect(refresh)

	UserInputService.InputBegan:Connect(function(input, processed)
		if not processed and input.KeyCode == GameConfig.Keys.Scoreboard then
			ScoreboardController.SetVisible(true)
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.KeyCode == GameConfig.Keys.Scoreboard then
			ScoreboardController.SetVisible(false)
		end
	end)
end

return ScoreboardController
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="22">
        <Properties>
          <string name="Name">ShopController</string>
          <string name="Source"><![CDATA[--[[
	ShopController
	Boutique et vestiaire : parcourir les 25 armes par categorie, consulter
	leurs statistiques, les acheter avec les pieces gagnees en jeu, puis les
	equiper en arme principale ou secondaire.

	Touche par defaut : B (voir GameConfig.Keys.Shop).
]]

local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local WaterWars = ReplicatedStorage:WaitForChild("WaterWars")
local Config = WaterWars:WaitForChild("Config")
local Shared = WaterWars:WaitForChild("Shared")

local GameConfig = require(Config:WaitForChild("GameConfig"))
local Weapons = require(Config:WaitForChild("Weapons"))
local Net = require(Shared:WaitForChild("Net"))
local Util = require(Shared:WaitForChild("Util"))

local ClientState = require(script.Parent:WaitForChild("ClientState"))
local UIKit = require(script.Parent:WaitForChild("UIKit"))

local ShopController = {}

local Theme = UIKit.Theme

local screen = nil
local root = nil
local isOpen = false
local selectedCategory = Weapons.CategoryOrder[1]
local selectedWeapon = nil

-- Références vers les éléments d'interface, remplies à la construction.
local ui: { [string]: any } = {}
local categoryButtons = {}
local weaponButtons = {}

-- Bornes utilisees pour dessiner les barres de statistiques.
local STAT_RANGES = {
	{ key = "damage", label = "Degats", max = 60 },
	{ key = "fireRate", label = "Cadence", max = 20 },
	{ key = "dps", label = "Degats / s", max = 220 },
	{ key = "tankSize", label = "Reservoir", max = 300 },
	{ key = "speed", label = "Vitesse", max = 520 },
	{ key = "reloadTime", label = "Rechargement", max = 4.5, invert = true },
}

local function isOwned(weaponId)
	return ClientState.profile.owned[weaponId] == true
end

local function equippedSlot(weaponId)
	local loadout = ClientState.profile.loadout
	if loadout.primary == weaponId then
		return "primary"
	elseif loadout.secondary == weaponId then
		return "secondary"
	end
	return nil
end

-- ----------------------------------------------------------- construction

local function buildStatRow(parent, definition, order)
	local holder = Instance.new("Frame")
	holder.Size = UDim2.new(1, 0, 0, 30)
	holder.BackgroundTransparency = 1
	holder.LayoutOrder = order
	holder.Parent = parent

	UIKit.Label(holder, definition.label, UDim2.fromOffset(120, 14), UDim2.fromOffset(0, 0), {
		color = Theme.TextDim, textSize = 12,
	})
	local valueLabel = UIKit.Label(holder, "", UDim2.fromOffset(90, 14), UDim2.new(1, -90, 0, 0), {
		color = Theme.Text, textSize = 12, align = Enum.TextXAlignment.Right, font = Theme.FontBold,
	})
	local _, fill = UIKit.Bar(holder, UDim2.new(1, 0, 0, 8), UDim2.fromOffset(0, 18), Theme.Accent, { radius = 4 })
	return { value = valueLabel, fill = fill }
end

local function buildDetails(parent)
	local panel = Instance.new("Frame")
	panel.Size = UDim2.new(0, 330, 1, -16)
	panel.Position = UDim2.new(1, -8, 0, 8)
	panel.AnchorPoint = Vector2.new(1, 0)
	panel.BackgroundColor3 = Theme.PanelLight
	panel.BackgroundTransparency = 0.25
	panel.BorderSizePixel = 0
	panel.Parent = parent
	UIKit.Corner(panel, 10)
	ui.details = panel

	ui.detailName = UIKit.Label(panel, "", UDim2.new(1, -24, 0, 26), UDim2.fromOffset(12, 12), {
		font = Theme.FontBold, textSize = 22,
	})
	ui.detailRarity = UIKit.Label(panel, "", UDim2.new(1, -24, 0, 16), UDim2.fromOffset(12, 38), {
		textSize = 13, color = Theme.TextDim,
	})
	ui.detailDesc = UIKit.Label(panel, "", UDim2.new(1, -24, 0, 54), UDim2.fromOffset(12, 58), {
		textSize = 13, color = Theme.TextDim, alignY = Enum.TextYAlignment.Top,
	})
	ui.detailDesc.TextWrapped = true

	local stats = Instance.new("Frame")
	stats.Size = UDim2.new(1, -24, 0, 190)
	stats.Position = UDim2.fromOffset(12, 116)
	stats.BackgroundTransparency = 1
	stats.Parent = panel
	UIKit.ListLayout(stats, 4)

	ui.statRows = {}
	for index, definition in ipairs(STAT_RANGES) do
		ui.statRows[definition.key] = buildStatRow(stats, definition, index)
	end

	ui.buyButton = UIKit.Button(panel, "ACHETER", UDim2.new(1, -24, 0, 38), UDim2.new(0, 12, 1, -100), {
		color = Theme.AccentDark, textSize = 16,
	})
	ui.equipPrimary = UIKit.Button(panel, "PRINCIPALE", UDim2.new(0.5, -16, 0, 34), UDim2.new(0, 12, 1, -56), {
		color = Theme.Panel, textSize = 14,
	})
	ui.equipSecondary = UIKit.Button(panel, "SECONDAIRE", UDim2.new(0.5, -16, 0, 34), UDim2.new(1, -12, 1, -56), {
		anchor = Vector2.new(1, 0), color = Theme.Panel, textSize = 14,
	})
end

local function refreshDetails()
	local weapon = selectedWeapon
	if not weapon then
		ui.details.Visible = false
		return
	end
	ui.details.Visible = true
	ui.detailName.Text = weapon.name
	ui.detailName.TextColor3 = weapon.rarityColor
	ui.detailRarity.Text = string.format(
		"%s  -  %s",
		weapon.rarityName,
		Weapons.CategoryNames[weapon.category] or weapon.category
	)
	ui.detailDesc.Text = weapon.desc

	for _, definition in ipairs(STAT_RANGES) do
		local row = ui.statRows[definition.key]
		local value = weapon[definition.key] or 0
		local ratio = math.clamp(value / definition.max, 0, 1)
		if definition.invert then
			ratio = 1 - ratio
		end
		row.fill.Size = UDim2.fromScale(math.max(0.03, ratio), 1)
		row.fill.BackgroundColor3 = ratio > 0.66 and Theme.Good or (ratio > 0.33 and Theme.Warn or Theme.Bad)
		if definition.key == "reloadTime" then
			row.value.Text = string.format("%.1f s", value)
		elseif definition.key == "fireRate" then
			row.value.Text = string.format("%.1f /s", value)
		else
			row.value.Text = Util.FormatNumber(value)
		end
	end

	local owned = isOwned(weapon.id)
	local slot = equippedSlot(weapon.id)

	if owned then
		ui.buyButton.Text = "DEJA DEBLOQUEE"
		ui.buyButton.BackgroundColor3 = Theme.Panel
		ui.buyButton.TextColor3 = Theme.TextDim
	else
		local affordable = ClientState.profile.coins >= weapon.price
		ui.buyButton.Text = string.format("ACHETER  -  %s pieces", Util.FormatNumber(weapon.price))
		ui.buyButton.BackgroundColor3 = affordable and Theme.AccentDark or Theme.Panel
		ui.buyButton.TextColor3 = affordable and Theme.Text or Theme.Bad
	end

	ui.equipPrimary.Visible = owned
	ui.equipSecondary.Visible = owned
	ui.equipPrimary.BackgroundColor3 = slot == "primary" and Theme.AccentDark or Theme.Panel
	ui.equipSecondary.BackgroundColor3 = slot == "secondary" and Theme.AccentDark or Theme.Panel
	ui.equipPrimary.Text = slot == "primary" and "PRINCIPALE OK" or "PRINCIPALE"
	ui.equipSecondary.Text = slot == "secondary" and "SECONDAIRE OK" or "SECONDAIRE"
end

local function refreshWeaponList()
	for _, button in ipairs(weaponButtons) do
		button:Destroy()
	end
	table.clear(weaponButtons)

	local list = Weapons.ByCategory(selectedCategory)
	for index, weapon in ipairs(list) do
		local owned = isOwned(weapon.id)
		local slot = equippedSlot(weapon.id)
		local button = UIKit.Button(ui.weaponList, "", UDim2.new(1, -12, 0, 54), nil, {
			color = Theme.Panel,
			stroke = false,
			layoutOrder = index,
		})
		button.AutoButtonColor = true

		UIKit.Label(button, weapon.name, UDim2.new(1, -110, 0, 20), UDim2.fromOffset(10, 7), {
			font = Theme.FontBold, textSize = 16, color = weapon.rarityColor,
		})
		local subtitle = string.format("%d degats  -  %.1f tirs/s  -  %d DPS", weapon.damage, weapon.fireRate, weapon.dps)
		UIKit.Label(button, subtitle, UDim2.new(1, -110, 0, 16), UDim2.fromOffset(10, 28), {
			textSize = 12, color = Theme.TextDim,
		})

		local statusText, statusColor
		if slot then
			statusText = slot == "primary" and "EQUIPEE 1" or "EQUIPEE 2"
			statusColor = Theme.Good
		elseif owned then
			statusText = "POSSEDEE"
			statusColor = Theme.Accent
		else
			statusText = Util.FormatNumber(weapon.price)
			statusColor = ClientState.profile.coins >= weapon.price and Theme.Warn or Theme.Bad
		end
		UIKit.Label(button, statusText, UDim2.fromOffset(96, 20), UDim2.new(1, -104, 0, 17), {
			textSize = 13, color = statusColor, align = Enum.TextXAlignment.Right, font = Theme.FontBold,
		})

		local stripe = Instance.new("Frame")
		stripe.Size = UDim2.fromOffset(4, 54)
		stripe.Position = UDim2.fromOffset(0, 0)
		stripe.BackgroundColor3 = weapon.rarityColor
		stripe.BorderSizePixel = 0
		stripe.Parent = button

		button.Activated:Connect(function()
			selectedWeapon = weapon
			refreshDetails()
		end)

		table.insert(weaponButtons, button)
	end

	if not selectedWeapon or selectedWeapon.category ~= selectedCategory then
		selectedWeapon = list[1]
	end
	refreshDetails()
end

local function refreshCategories()
	for id, button in pairs(categoryButtons) do
		local selected = id == selectedCategory
		button.BackgroundColor3 = selected and Theme.AccentDark or Theme.Panel
		button.TextColor3 = selected and Theme.Text or Theme.TextDim
	end
end

local function refreshAll()
	ui.coins.Text = string.format("%s pieces", Util.FormatNumber(ClientState.profile.coins))
	refreshCategories()
	refreshWeaponList()
end

local function build()
	screen = UIKit.Screen("WaterWarsShop", 6)
	screen.Enabled = false

	local backdrop = Instance.new("Frame")
	backdrop.Size = UDim2.fromScale(1, 1)
	backdrop.BackgroundColor3 = Color3.fromRGB(2, 5, 10)
	backdrop.BackgroundTransparency = 0.45
	backdrop.BorderSizePixel = 0
	backdrop.Parent = screen

	root = UIKit.Panel(screen, UDim2.fromOffset(900, 540), UDim2.fromScale(0.5, 0.5), Vector2.new(0.5, 0.5))
	root.BackgroundTransparency = 0.02

	UIKit.Label(root, "ARSENAL", UDim2.fromOffset(260, 30), UDim2.fromOffset(18, 14), {
		font = Theme.FontBold, textSize = 26,
	})
	ui.coins = UIKit.Label(root, "0 pieces", UDim2.fromOffset(280, 24), UDim2.new(1, -60, 0, 18), {
		anchor = Vector2.new(1, 0), align = Enum.TextXAlignment.Right,
		font = Theme.FontBold, textSize = 18, color = Theme.Warn,
	})
	local close = UIKit.Button(root, "X", UDim2.fromOffset(34, 30), UDim2.new(1, -14, 0, 14), {
		anchor = Vector2.new(1, 0), color = Theme.Panel, textSize = 16,
	})
	close.Activated:Connect(function()
		ShopController.SetOpen(false)
	end)

	local body = Instance.new("Frame")
	body.Size = UDim2.new(1, -24, 1, -70)
	body.Position = UDim2.fromOffset(12, 58)
	body.BackgroundTransparency = 1
	body.Parent = root

	-- Colonne des categories
	local categories = Instance.new("Frame")
	categories.Size = UDim2.new(0, 150, 1, -16)
	categories.Position = UDim2.fromOffset(8, 8)
	categories.BackgroundTransparency = 1
	categories.Parent = body
	UIKit.ListLayout(categories, 6)

	for index, id in ipairs(Weapons.CategoryOrder) do
		local button = UIKit.Button(categories, Weapons.CategoryNames[id] or id, UDim2.new(1, 0, 0, 38), nil, {
			color = Theme.Panel, textSize = 13, stroke = false, layoutOrder = index,
		})
		button.Activated:Connect(function()
			selectedCategory = id
			selectedWeapon = nil
			refreshCategories()
			refreshWeaponList()
		end)
		categoryButtons[id] = button
	end

	-- Liste des armes
	local list = Instance.new("ScrollingFrame")
	list.Size = UDim2.new(1, -520, 1, -16)
	list.Position = UDim2.fromOffset(166, 8)
	list.BackgroundColor3 = Theme.Panel
	list.BackgroundTransparency = 0.5
	list.BorderSizePixel = 0
	list.ScrollBarThickness = 5
	list.ScrollBarImageColor3 = Theme.Accent
	list.CanvasSize = UDim2.new()
	list.AutomaticCanvasSize = Enum.AutomaticSize.Y
	list.Parent = body
	UIKit.Corner(list, 10)
	local listLayout = UIKit.ListLayout(list, 6)
	listLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	local listPadding = Instance.new("UIPadding")
	listPadding.PaddingTop = UDim.new(0, 6)
	listPadding.PaddingBottom = UDim.new(0, 6)
	listPadding.Parent = list
	ui.weaponList = list

	buildDetails(body)

	ui.buyButton.Activated:Connect(function()
		if selectedWeapon and not isOwned(selectedWeapon.id) then
			Net.Event("RequestPurchase"):FireServer(selectedWeapon.id)
		end
	end)
	ui.equipPrimary.Activated:Connect(function()
		if selectedWeapon and isOwned(selectedWeapon.id) then
			Net.Event("RequestEquip"):FireServer("primary", selectedWeapon.id)
		end
	end)
	ui.equipSecondary.Activated:Connect(function()
		if selectedWeapon and isOwned(selectedWeapon.id) then
			Net.Event("RequestEquip"):FireServer("secondary", selectedWeapon.id)
		end
	end)
end

--- Le curseur n'est affiche que lorsqu'il y a quelque chose a cliquer :
--- boutique ouverte, ou entre deux manches (ecran de vote).
local function updateMouseIcon()
	local state = ClientState.match.state
	UserInputService.MouseIconEnabled = isOpen or state ~= "Active"
end

function ShopController.SetOpen(open)
	isOpen = open
	if screen then
		screen.Enabled = open
	end
	updateMouseIcon()
	if open then
		refreshAll()
	end
end

function ShopController.IsOpen()
	return isOpen
end

function ShopController.Start()
	build()

	ClientState.ProfileChanged:Connect(function()
		if isOpen then
			refreshAll()
		end
	end)
	ClientState.MatchChanged:Connect(updateMouseIcon)
	updateMouseIcon()

	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then
			return
		end
		if input.KeyCode == GameConfig.Keys.Shop then
			ShopController.SetOpen(not isOpen)
		elseif input.KeyCode == Enum.KeyCode.Escape and isOpen then
			ShopController.SetOpen(false)
		end
	end)

	-- Premier chargement du profil.
	task.spawn(function()
		local ok, profile = pcall(function()
			return Net.Function("GetProfile"):InvokeServer()
		end)
		if ok and type(profile) == "table" then
			ClientState.SetProfile(profile)
		end
	end)
end

return ShopController
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="23">
        <Properties>
          <string name="Name">SoundController</string>
          <string name="Source"><![CDATA[--[[
	SoundController
	Habillage sonore. On n'utilise que des sons livres avec le client Roblox
	(rbxasset://...) : aucun upload, aucun ID a moderer. Pour mettre vos
	propres sons, remplacez simplement les valeurs de GameConfig.Sounds.
]]

local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local SoundService = game:GetService("SoundService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local WaterWars = ReplicatedStorage:WaitForChild("WaterWars")
local Config = WaterWars:WaitForChild("Config")
local Shared = WaterWars:WaitForChild("Shared")

local GameConfig = require(Config:WaitForChild("GameConfig"))
local Weapons = require(Config:WaitForChild("Weapons"))
local Net = require(Shared:WaitForChild("Net"))

local SoundController = {}

local localPlayer = Players.LocalPlayer
local MAX_DISTANCE = 220

--- Son non positionnel (interface, marqueur de touche).
local function play2D(assetId, volume, pitch)
	if type(assetId) ~= "string" or #assetId == 0 then
		return
	end
	local sound = Instance.new("Sound")
	sound.SoundId = assetId
	sound.Volume = volume or 0.5
	sound.PlaybackSpeed = pitch or 1
	sound.Parent = SoundService
	sound:Play()
	Debris:AddItem(sound, 4)
end

--- Son positionne dans le monde.
local function play3D(assetId, position, volume, pitch)
	if type(assetId) ~= "string" or #assetId == 0 then
		return
	end
	local camera = workspace.CurrentCamera
	if camera and (camera.CFrame.Position - position).Magnitude > MAX_DISTANCE then
		return
	end
	local anchor = Instance.new("Part")
	anchor.Size = Vector3.new(0.2, 0.2, 0.2)
	anchor.CFrame = CFrame.new(position)
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanQuery = false
	anchor.CanTouch = false
	anchor.CastShadow = false
	anchor.Transparency = 1
	anchor.Parent = workspace

	local sound = Instance.new("Sound")
	sound.SoundId = assetId
	sound.Volume = volume or 0.5
	sound.PlaybackSpeed = pitch or 1
	sound.RollOffMaxDistance = MAX_DISTANCE
	sound.RollOffMinDistance = 12
	sound.Parent = anchor
	sound:Play()
	Debris:AddItem(anchor, 4)
end

function SoundController.Start()
	local sounds = GameConfig.Sounds

	Net.Event("ProjectileSpawned").OnClientEvent:Connect(function(shooter, weaponId, origin)
		local weapon = Weapons.Get(weaponId)
		if not weapon or typeof(origin) ~= "Vector3" then
			return
		end
		-- Les armes tres rapides ne jouent qu'un son sur trois : sinon le
		-- melange sature des qu'un minigun tire.
		if weapon.fireRate > 10 and math.random() > 0.34 then
			return
		end
		local pitch = 0.85 + math.random() * 0.3
		if shooter == localPlayer then
			play2D(sounds.Shoot, 0.35, pitch)
		else
			play3D(sounds.Shoot, origin, 0.5, pitch)
		end
	end)

	Net.Event("ImpactEffect").OnClientEvent:Connect(function(position, _normal, weaponId, hitCharacter)
		local weapon = Weapons.Get(weaponId)
		if not weapon or typeof(position) ~= "Vector3" then
			return
		end
		if not hitCharacter and math.random() > 0.3 then
			return
		end
		play3D(sounds.Splash, position, hitCharacter and 0.55 or 0.3, 1 + math.random() * 0.25)
	end)

	Net.Event("HitMarker").OnClientEvent:Connect(function(_damage, killed)
		if killed then
			play2D(sounds.Eliminate, 0.55, 1)
		else
			play2D(sounds.Hit, 0.3, 1.5)
		end
	end)

	Net.Event("AmmoUpdate").OnClientEvent:Connect(function(_weaponId, _current, _max, reloading)
		if reloading then
			play2D(sounds.Reload, 0.4, 1)
		end
	end)

	Net.Event("MapReady").OnClientEvent:Connect(function()
		play2D(sounds.RoundStart, 0.5, 1)
	end)
end

return SoundController
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="24">
        <Properties>
          <string name="Name">UIKit</string>
          <string name="Source"><![CDATA[--[[
	UIKit
	Petits assistants pour construire l'interface en code. Aucune image n'est
	utilisee : tout le HUD est fait de Frames, de coins arrondis et de degrades,
	ce qui garantit qu'il s'affiche correctement sans aucun asset a uploader.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local GameConfig = require(ReplicatedStorage:WaitForChild("WaterWars"):WaitForChild("Config"):WaitForChild("GameConfig"))

local UIKit = {}

UIKit.Theme = GameConfig.UI

function UIKit.Corner(parent, radius)
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, radius or 8)
	corner.Parent = parent
	return corner
end

function UIKit.Stroke(parent, color, thickness, transparency)
	local stroke = Instance.new("UIStroke")
	stroke.Color = color or UIKit.Theme.Accent
	stroke.Thickness = thickness or 1
	stroke.Transparency = transparency or 0.4
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Parent = parent
	return stroke
end

function UIKit.Padding(parent, amount)
	local padding = Instance.new("UIPadding")
	local offset = UDim.new(0, amount or 8)
	padding.PaddingTop = offset
	padding.PaddingBottom = offset
	padding.PaddingLeft = offset
	padding.PaddingRight = offset
	padding.Parent = parent
	return padding
end

function UIKit.ListLayout(parent, padding, direction)
	local layout = Instance.new("UIListLayout")
	layout.Padding = UDim.new(0, padding or 6)
	layout.FillDirection = direction or Enum.FillDirection.Vertical
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = parent
	return layout
end

--- Panneau de fond standard du HUD.
function UIKit.Panel(parent, size, position, anchor)
	local frame = Instance.new("Frame")
	frame.Size = size
	frame.Position = position
	frame.AnchorPoint = anchor or Vector2.new(0, 0)
	frame.BackgroundColor3 = UIKit.Theme.Panel
	frame.BackgroundTransparency = 0.18
	frame.BorderSizePixel = 0
	frame.Parent = parent
	UIKit.Corner(frame, 10)
	UIKit.Stroke(frame, UIKit.Theme.AccentDark, 1.5, 0.35)
	return frame
end

function UIKit.Label(parent, text, size, position, options)
	options = options or {}
	local label = Instance.new("TextLabel")
	label.Size = size
	label.Position = position or UDim2.fromOffset(0, 0)
	label.AnchorPoint = options.anchor or Vector2.new(0, 0)
	label.BackgroundTransparency = options.backgroundTransparency or 1
	label.BackgroundColor3 = options.backgroundColor or UIKit.Theme.PanelLight
	label.BorderSizePixel = 0
	label.Text = text
	label.TextColor3 = options.color or UIKit.Theme.Text
	label.Font = options.font or UIKit.Theme.Font
	label.TextSize = options.textSize or 16
	label.TextScaled = options.scaled or false
	label.TextXAlignment = options.align or Enum.TextXAlignment.Left
	label.TextYAlignment = options.alignY or Enum.TextYAlignment.Center
	label.TextTransparency = options.transparency or 0
	label.RichText = options.richText or false
	label.LayoutOrder = options.layoutOrder or 0
	label.Parent = parent
	if options.stroke then
		local stroke = Instance.new("UIStroke")
		stroke.Color = Color3.fromRGB(0, 0, 0)
		stroke.Thickness = 1.5
		stroke.Transparency = 0.45
		stroke.Parent = label
	end
	return label
end

function UIKit.Button(parent, text, size, position, options)
	options = options or {}
	local button = Instance.new("TextButton")
	button.Size = size
	button.Position = position or UDim2.fromOffset(0, 0)
	button.AnchorPoint = options.anchor or Vector2.new(0, 0)
	button.BackgroundColor3 = options.color or UIKit.Theme.PanelLight
	button.BackgroundTransparency = options.transparency or 0
	button.BorderSizePixel = 0
	button.AutoButtonColor = true
	button.Text = text
	button.TextColor3 = options.textColor or UIKit.Theme.Text
	button.Font = options.font or UIKit.Theme.FontBold
	button.TextSize = options.textSize or 16
	button.TextScaled = options.scaled or false
	button.LayoutOrder = options.layoutOrder or 0
	button.Parent = parent
	UIKit.Corner(button, options.radius or 8)
	if options.stroke ~= false then
		UIKit.Stroke(button, options.strokeColor or UIKit.Theme.Accent, 1.2, 0.55)
	end
	return button
end

--- Barre de progression (vie, eau, endurance).
function UIKit.Bar(parent, size, position, color, options)
	options = options or {}
	local background = Instance.new("Frame")
	background.Size = size
	background.Position = position
	background.AnchorPoint = options.anchor or Vector2.new(0, 0)
	background.BackgroundColor3 = options.backgroundColor or Color3.fromRGB(12, 16, 24)
	background.BackgroundTransparency = 0.25
	background.BorderSizePixel = 0
	background.Parent = parent
	UIKit.Corner(background, options.radius or 6)

	local fill = Instance.new("Frame")
	fill.Name = "Fill"
	fill.Size = UDim2.fromScale(1, 1)
	fill.BackgroundColor3 = color
	fill.BorderSizePixel = 0
	fill.Parent = background
	UIKit.Corner(fill, options.radius or 6)

	local gradient = Instance.new("UIGradient")
	gradient.Color = ColorSequence.new(color, color:Lerp(Color3.new(1, 1, 1), 0.35))
	gradient.Rotation = 90
	gradient.Parent = fill

	return background, fill
end

--- Cree le ScreenGui racine d'un controleur.
function UIKit.Screen(name, displayOrder)
	local player = game:GetService("Players").LocalPlayer
	local playerGui = player:WaitForChild("PlayerGui")
	local existing = playerGui:FindFirstChild(name)
	if existing then
		existing:Destroy()
	end
	local screen = Instance.new("ScreenGui")
	screen.Name = name
	screen.ResetOnSpawn = false
	screen.IgnoreGuiInset = true
	screen.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	screen.DisplayOrder = displayOrder or 1
	screen.Parent = playerGui
	return screen
end

return UIKit
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="25">
        <Properties>
          <string name="Name">VoteController</string>
          <string name="Source"><![CDATA[--[[
	VoteController
	Ecran de vote entre les manches : trois terrains proposes, un clic pour
	voter, le nombre de voix se met a jour en direct.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local WaterWars = ReplicatedStorage:WaitForChild("WaterWars")
local Shared = WaterWars:WaitForChild("Shared")
local Net = require(Shared:WaitForChild("Net"))

local ClientState = require(script.Parent:WaitForChild("ClientState"))
local UIKit = require(script.Parent:WaitForChild("UIKit"))

local VoteController = {}

local Theme = UIKit.Theme

local screen = nil
local cardsHolder = nil
local titleLabel = nil
local cards = {}
local lastRevision = nil

local CARD_COLORS = {
	Color3.fromRGB(46, 120, 200),
	Color3.fromRGB(180, 90, 200),
	Color3.fromRGB(210, 130, 60),
}

local function clearCards()
	for _, card in ipairs(cards) do
		card.frame:Destroy()
	end
	table.clear(cards)
end

local function refreshVotes()
	local counts = ClientState.vote.votes or {}
	for _, card in ipairs(cards) do
		local count = counts[card.id] or 0
		card.votes.Text = count == 1 and "1 voix" or string.format("%d voix", count)
		local chosen = ClientState.vote.choice == card.id
		card.frame.BackgroundTransparency = chosen and 0.05 or 0.3
		card.stroke.Transparency = chosen and 0 or 0.6
		card.stroke.Color = chosen and Theme.Good or Theme.Accent
	end
end

local function buildCards()
	clearCards()
	local options = ClientState.vote.options or {}
	for index, map in ipairs(options) do
		local frame = Instance.new("TextButton")
		frame.Size = UDim2.new(0, 250, 1, 0)
		frame.BackgroundColor3 = Theme.Panel
		frame.BackgroundTransparency = 0.3
		frame.BorderSizePixel = 0
		frame.Text = ""
		frame.AutoButtonColor = false
		frame.LayoutOrder = index
		frame.Parent = cardsHolder
		UIKit.Corner(frame, 12)
		local stroke = UIKit.Stroke(frame, Theme.Accent, 2, 0.6)

		local banner = Instance.new("Frame")
		banner.Size = UDim2.new(1, 0, 0, 96)
		banner.BackgroundColor3 = CARD_COLORS[((index - 1) % #CARD_COLORS) + 1]
		banner.BorderSizePixel = 0
		banner.Parent = frame
		UIKit.Corner(banner, 12)
		local gradient = Instance.new("UIGradient")
		gradient.Color = ColorSequence.new(
			banner.BackgroundColor3,
			banner.BackgroundColor3:Lerp(Color3.new(0, 0, 0), 0.55)
		)
		gradient.Rotation = 90
		gradient.Parent = banner

		UIKit.Label(banner, map.theme or "", UDim2.new(1, -20, 0, 20), UDim2.new(0, 10, 1, -26), {
			textSize = 13, color = Color3.fromRGB(240, 245, 255),
		})
		UIKit.Label(frame, map.name or "", UDim2.new(1, -20, 0, 26), UDim2.fromOffset(10, 104), {
			font = Theme.FontBold, textSize = 20,
		})
		local description = UIKit.Label(frame, map.description or "", UDim2.new(1, -20, 0, 70), UDim2.fromOffset(10, 132), {
			textSize = 13, color = Theme.TextDim, alignY = Enum.TextYAlignment.Top,
		})
		description.TextWrapped = true

		local votes = UIKit.Label(frame, "0 voix", UDim2.new(1, -20, 0, 22), UDim2.new(0, 10, 1, -30), {
			font = Theme.FontBold, textSize = 16, color = Theme.Warn,
		})

		frame.Activated:Connect(function()
			ClientState.vote.choice = map.id
			Net.Event("CastMapVote"):FireServer(map.id)
			refreshVotes()
		end)

		table.insert(cards, { id = map.id, frame = frame, votes = votes, stroke = stroke })
	end
	refreshVotes()
end

local function refresh()
	local vote = ClientState.vote
	local match = ClientState.match
	local shouldShow = vote.open and match.state == "Vote"
	screen.Enabled = shouldShow
	if shouldShow then
		titleLabel.Text = string.format("VOTEZ POUR LE PROCHAIN TERRAIN  -  %d s", math.ceil(match.timeLeft or 0))
	end
end

function VoteController.Start()
	screen = UIKit.Screen("WaterWarsVote", 3)
	screen.Enabled = false

	local panel = UIKit.Panel(screen, UDim2.fromOffset(820, 330), UDim2.new(0.5, 0, 1, -40), Vector2.new(0.5, 1))

	titleLabel = UIKit.Label(panel, "", UDim2.new(1, -24, 0, 26), UDim2.fromOffset(12, 10), {
		font = Theme.FontBold, textSize = 20, align = Enum.TextXAlignment.Center,
	})

	local holder = Instance.new("Frame")
	holder.Size = UDim2.new(1, -24, 1, -52)
	holder.Position = UDim2.fromOffset(12, 42)
	holder.BackgroundTransparency = 1
	holder.Parent = panel
	cardsHolder = holder
	local layout = UIKit.ListLayout(holder, 12, Enum.FillDirection.Horizontal)
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center

	ClientState.VoteChanged:Connect(function(vote)
		-- Chaque nouveau vote porte un numero : sans cela, deux votes
		-- successifs a trois terrains garderaient les anciennes cartes.
		if vote.open and vote.revision ~= lastRevision then
			lastRevision = vote.revision
			buildCards()
		else
			refreshVotes()
		end
		refresh()
	end)
	ClientState.MatchChanged:Connect(refresh)
end

return VoteController
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="26">
        <Properties>
          <string name="Name">WeaponController</string>
          <string name="Source"><![CDATA[--[[
	WeaponController
	Entrees de combat : tir, rafale automatique, charge, visee, rechargement
	et course. Le client ne fait que declarer une intention de tir ; le serveur
	verifie la cadence, les munitions et applique les degats.

	La prediction locale (munitions, gouttes, recul) rend le tir instantane a
	l'ecran malgre la latence.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local WaterWars = ReplicatedStorage:WaitForChild("WaterWars")
local Config = WaterWars:WaitForChild("Config")
local Shared = WaterWars:WaitForChild("Shared")

local GameConfig = require(Config:WaitForChild("GameConfig"))
local Net = require(Shared:WaitForChild("Net"))

local ClientState = require(script.Parent:WaitForChild("ClientState"))
local EffectsController = require(script.Parent:WaitForChild("EffectsController"))

local WeaponController = {}

local localPlayer = Players.LocalPlayer
local DEFAULT_FOV = 70
local AIM_DISTANCE = 1200

local triggerHeld = false
local chargeStart = 0
local lastShot = 0
local aiming = false
local sprintHeld = false
local recoil = 0

local fireRemote = nil
local aimParams = RaycastParams.new()

--- Point vise par le joueur au centre de l'ecran.
local function getAimPoint(camera)
	local origin = camera.CFrame.Position
	local look = camera.CFrame.LookVector
	local character = localPlayer.Character
	aimParams.FilterType = Enum.RaycastFilterType.Exclude
	aimParams.FilterDescendantsInstances = {
		character,
		workspace:FindFirstChild("WaterWarsEffects"),
	}
	aimParams.IgnoreWater = true
	local result = workspace:Raycast(origin, look * AIM_DISTANCE, aimParams)
	if result then
		return result.Position
	end
	return origin + look * AIM_DISTANCE
end

--- Position de sortie d'eau : la buse si elle existe, sinon la camera.
local function getMuzzlePosition(tool, camera)
	local handle = tool and tool:FindFirstChild("Handle")
	if handle then
		local muzzle = handle:FindFirstChild("Muzzle")
		if muzzle and muzzle:IsA("Attachment") then
			return muzzle.WorldPosition
		end
		return (handle :: BasePart).Position
	end
	return camera.CFrame.Position
end

local function canFire(weapon)
	if not weapon then
		return false
	end
	local ammo = ClientState.ammo
	if ammo.reloading then
		return false
	end
	if ammo.weaponId == weapon.id and ammo.current < weapon.tankCost * weapon.burst then
		return false
	end
	return os.clock() - lastShot >= 1 / weapon.fireRate
end

local function applyRecoil(weapon)
	local kick = math.min(3.2, weapon.damage * weapon.pellets * 0.012 + 0.25)
	recoil = math.min(6, recoil + kick)
end

local function doFire(weapon, tool)
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	local character = localPlayer.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return
	end

	local chargeRatio = 0
	if weapon.chargeTime > 0 then
		chargeRatio = math.clamp((os.clock() - chargeStart) / weapon.chargeTime, 0, 1)
	end

	local muzzle = getMuzzlePosition(tool, camera)
	local target = getAimPoint(camera)
	local direction = target - muzzle
	if direction.Magnitude < 0.05 then
		direction = camera.CFrame.LookVector
	end
	direction = direction.Unit

	lastShot = os.clock()

	-- Prediction locale : munitions et visuel immediats.
	local ammo = ClientState.ammo
	if ammo.weaponId == weapon.id then
		ClientState.SetAmmo(
			ammo.weaponId,
			math.max(0, ammo.current - weapon.tankCost * weapon.burst),
			ammo.max,
			ammo.reloading
		)
	end

	for shot = 1, weapon.burst do
		if shot == 1 then
			EffectsController.SpawnVolley(weapon, muzzle, direction, chargeRatio)
			EffectsController.MuzzleFlash(tool, weapon)
		else
			task.delay((shot - 1) * 0.07, function()
				EffectsController.SpawnVolley(weapon, getMuzzlePosition(tool, camera), direction, chargeRatio)
				EffectsController.MuzzleFlash(tool, weapon)
			end)
		end
	end

	applyRecoil(weapon)
	if fireRemote then
		fireRemote:FireServer(muzzle, direction, chargeRatio)
	end
end

--- Appelee a chaque frame : gere la rafale et les armes a charge.
local function updateFiring()
	local weapon, tool = ClientState.GetEquippedWeapon()
	if not weapon or not tool then
		return
	end

	if weapon.chargeTime > 0 then
		-- Arme a charge : le tir part au relachement.
		return
	end
	if not triggerHeld then
		return
	end
	if not weapon.autoFire and lastShot > chargeStart then
		-- Semi-automatique : un seul tir par appui.
		return
	end
	if canFire(weapon) then
		doFire(weapon, tool)
	end
end

--- Visee : reduit le champ de vision des armes qui le permettent.
local function updateAim(deltaTime)
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	local weapon = ClientState.GetEquippedWeapon()
	local targetFov = DEFAULT_FOV
	if aiming and weapon and weapon.zoom > 0 then
		targetFov = weapon.zoom
	end
	camera.FieldOfView = camera.FieldOfView + (targetFov - camera.FieldOfView) * math.min(1, deltaTime * 12)

	-- Recul : petit coup de camera vers le haut qui retombe.
	recoil = math.max(0, recoil - deltaTime * 14)
	local character = localPlayer.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.CameraOffset = humanoid.CameraOffset:Lerp(Vector3.new(0, recoil * 0.06, recoil * 0.05), 0.35)
	end
end

local function setSprint(enabled)
	if sprintHeld == enabled then
		return
	end
	sprintHeld = enabled
	Net.Event("SetSprint"):FireServer(enabled)
end

function WeaponController.IsAiming()
	return aiming
end

--- Ratio de charge en cours (0..1), utilise par le HUD.
function WeaponController.GetCharge()
	local weapon = ClientState.GetEquippedWeapon()
	if not weapon or weapon.chargeTime <= 0 or not triggerHeld then
		return 0
	end
	return math.clamp((os.clock() - chargeStart) / weapon.chargeTime, 0, 1)
end

function WeaponController.Start()
	fireRemote = Net.Event("FireWeapon")

	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			triggerHeld = true
			chargeStart = os.clock()
			local weapon, tool = ClientState.GetEquippedWeapon()
			if weapon and tool and weapon.chargeTime <= 0 and canFire(weapon) then
				doFire(weapon, tool)
			end
		elseif input.UserInputType == Enum.UserInputType.MouseButton2 then
			aiming = true
		elseif input.KeyCode == GameConfig.Keys.Reload then
			Net.Event("RequestReload"):FireServer()
		elseif input.KeyCode == GameConfig.Keys.Sprint then
			setSprint(true)
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			-- Relachement : c'est ici que partent les tirs charges.
			local weapon, tool = ClientState.GetEquippedWeapon()
			if triggerHeld and weapon and tool and weapon.chargeTime > 0 and canFire(weapon) then
				doFire(weapon, tool)
			end
			triggerHeld = false
		elseif input.UserInputType == Enum.UserInputType.MouseButton2 then
			aiming = false
		elseif input.KeyCode == GameConfig.Keys.Sprint then
			setSprint(false)
		end
	end)

	-- Perte de focus : on relache tout pour ne pas rester bloque en tir.
	UserInputService.WindowFocusReleased:Connect(function()
		triggerHeld = false
		aiming = false
		setSprint(false)
	end)

	Net.Event("AmmoUpdate").OnClientEvent:Connect(function(weaponId, current, max, reloading)
		ClientState.SetAmmo(weaponId, current, max, reloading)
	end)

	RunService.RenderStepped:Connect(function(deltaTime)
		local ok, err = pcall(function()
			updateFiring()
			updateAim(math.min(deltaTime, 0.1))
		end)
		if not ok then
			warn("[WaterWars] Erreur du controleur d'arme : " .. tostring(err))
		end
	end)
end

return WeaponController
]]></string>
        </Properties>
      </Item>
    </Item>
    <Item class="Script" referent="27">
      <Properties>
        <string name="Name">WaterWarsServer</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--[[
	Water Wars - point d'entree serveur

	Ce script est volontairement tolerant sur l'installation : que le contenu
	ait ete ouvert comme une place complete ou insere n'importe ou comme un
	modele, il retrouve ses morceaux et les remet a leur place tout seul.

	Regle de conduite : on n'attend jamais indefiniment en silence. Si quelque
	chose manque, on le dit clairement dans la fenetre Output.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")
local ServerStorage = game:GetService("ServerStorage")
local StarterGui = game:GetService("StarterGui")
local StarterPack = game:GetService("StarterPack")
local StarterPlayer = game:GetService("StarterPlayer")

local SHARED_NAME = "WaterWars"
local CLIENT_NAME = "WaterWarsClient"

--- Endroits ou le contenu peut avoir ete depose par erreur.
local function searchRoots()
	return { workspace, ServerScriptService, ServerStorage, StarterPlayer, StarterGui, StarterPack, ReplicatedStorage }
end

local function findDescendant(root, predicate)
	for _, descendant in ipairs(root:GetDescendants()) do
		if predicate(descendant) then
			return descendant
		end
	end
	return nil
end

--- Retrouve le dossier partage et le replace dans ReplicatedStorage.
local function ensureSharedFolder()
	local existing = ReplicatedStorage:FindFirstChild(SHARED_NAME)
	if existing and existing:FindFirstChild("Config") then
		return existing
	end

	for _, root in ipairs(searchRoots()) do
		local found = findDescendant(root, function(instance)
			return instance.Name == SHARED_NAME
				and instance:IsA("Folder")
				and instance:FindFirstChild("Config") ~= nil
				and instance:FindFirstChild("Shared") ~= nil
		end)
		if found then
			found.Parent = ReplicatedStorage
			warn(string.format(
				"[WaterWars] Le dossier partage etait dans %s : il a ete deplace vers ReplicatedStorage.",
				root.Name
			))
			return found
		end
	end
	return nil
end

--- Replace le script client dans StarterPlayerScripts (sans quoi il ne
--- s'execute jamais : un LocalScript ne tourne que dans certains conteneurs).
local function ensureClientScript()
	local starterScripts = StarterPlayer:FindFirstChildOfClass("StarterPlayerScripts")
	if not starterScripts then
		warn("[WaterWars] StarterPlayerScripts est introuvable : l'interface ne pourra pas demarrer.")
		return
	end
	if starterScripts:FindFirstChild(CLIENT_NAME) then
		return
	end

	local found = nil
	for _, root in ipairs(searchRoots()) do
		found = findDescendant(root, function(instance)
			return instance.Name == CLIENT_NAME and instance:IsA("LocalScript")
		end)
		if found then
			break
		end
	end
	if not found then
		warn(string.format(
			"[WaterWars] Le script client '%s' est introuvable : le jeu tournera sans interface.",
			CLIENT_NAME
		))
		return
	end

	found.Parent = starterScripts
	warn("[WaterWars] Le script client a ete deplace vers StarterPlayer.StarterPlayerScripts.")

	-- Les joueurs deja connectes ont recu leur copie de StarterPlayerScripts
	-- avant ce deplacement : on leur injecte le script a la main.
	for _, player in ipairs(Players:GetPlayers()) do
		pcall(function()
			local playerScripts = player:FindFirstChild("PlayerScripts")
			if playerScripts and not playerScripts:FindFirstChild(CLIENT_NAME) then
				local copy = found:Clone()
				copy.Parent = playerScripts
			end
		end)
	end
end

--- Si le script a ete insere dans Workspace avec le modele, il se range.
local function tidySelf()
	if script.Parent == ServerScriptService then
		return
	end
	local installer = script.Parent
	pcall(function()
		script.Parent = ServerScriptService
	end)
	-- Le dossier d'installation vide n'a plus de raison d'exister.
	if installer and installer ~= ServerScriptService and #installer:GetChildren() == 0 then
		pcall(function()
			installer:Destroy()
		end)
	end
end

-- ========================== installation ==================================

if not ensureSharedFolder() then
	error(
		"[WaterWars] Installation incomplete : le dossier 'WaterWars' (avec Config et Shared) est introuvable.\n"
			.. "  - Si vous avez ouvert WaterWars.rbxlx : utilisez Fichier > Ouvrir, pas 'Insert from File'.\n"
			.. "  - Si vous avez insere WaterWars.rbxmx : verifiez que le dossier insere est complet.",
		0
	)
end

ensureClientScript()
tidySelf()

-- ========================== demarrage des services ========================

-- A ce stade le dossier est garanti present dans ReplicatedStorage : on y
-- accede par son chemin litteral, ce qui permet aussi aux outils d'analyse
-- de resoudre les modules.
local WaterWars = ReplicatedStorage:WaitForChild("WaterWars")
local Config = WaterWars:WaitForChild("Config")
local Shared = WaterWars:WaitForChild("Shared")

local GameConfig = require(Config:WaitForChild("GameConfig"))
local Maps = require(Config:WaitForChild("Maps"))
local Weapons = require(Config:WaitForChild("Weapons"))
local Net = require(Shared:WaitForChild("Net"))

-- Les remotes doivent exister avant que le moindre client ne les attende.
Net.Init()

local CombatService = require(script:WaitForChild("CombatService"))
local DataService = require(script:WaitForChild("DataService"))
local MatchService = require(script:WaitForChild("MatchService"))
local PickupService = require(script:WaitForChild("PickupService"))
local PlayerService = require(script:WaitForChild("PlayerService"))
local TeamService = require(script:WaitForChild("TeamService"))
local WeaponService = require(script:WaitForChild("WeaponService"))

Players.RespawnTime = GameConfig.RespawnTime
workspace.FallenPartsDestroyHeight = -500

local START_ORDER = {
	{ name = "DataService", service = DataService },
	{ name = "TeamService", service = TeamService },
	{ name = "WeaponService", service = WeaponService },
	{ name = "PlayerService", service = PlayerService },
	{ name = "CombatService", service = CombatService },
	{ name = "PickupService", service = PickupService },
	{ name = "MatchService", service = MatchService },
}

local failures = 0
for _, entry in ipairs(START_ORDER) do
	local ok, err = pcall(entry.service.Start)
	if not ok then
		failures = failures + 1
		warn(string.format("[WaterWars] Echec du demarrage de %s : %s", entry.name, tostring(err)))
	end
end

if failures > 0 then
	warn(string.format("[WaterWars] %d service(s) n'ont pas demarre : le jeu sera degrade.", failures))
end

print(string.format(
	"[WaterWars] Serveur pret - %d armes, %d maps, %d joueurs max.",
	Weapons.Count,
	Maps.Count,
	GameConfig.MaxPlayers
))
]]></string>
      </Properties>
      <Item class="ModuleScript" referent="28">
        <Properties>
          <string name="Name">CombatService</string>
          <string name="Source"><![CDATA[--[[
	CombatService
	Simulation des projectiles et application des degats, entierement cote
	serveur : le client n'envoie qu'une intention de tir (origine + direction).

	Consequences :
	  - impossible de tricher sur les degats, la cadence ou la portee ;
	  - tous les joueurs voient la meme trajectoire ;
	  - le client se contente d'afficher une goutte purement decorative.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local WaterWars = ReplicatedStorage:WaitForChild("WaterWars")
local Config = WaterWars:WaitForChild("Config")
local Shared = WaterWars:WaitForChild("Shared")

local GameConfig = require(Config:WaitForChild("GameConfig"))
local Net = require(Shared:WaitForChild("Net"))
local Util = require(Shared:WaitForChild("Util"))

local ServerEvents = require(script.Parent:WaitForChild("ServerEvents"))
local TeamService = require(script.Parent:WaitForChild("TeamService"))
local WeaponService = require(script.Parent:WaitForChild("WeaponService"))
local DataService = require(script.Parent:WaitForChild("DataService"))

local CombatService = {}

local GRAVITY = 196.2 -- gravite Roblox par defaut (studs/s^2)

local projectiles = {}
local roundActive = false
local rng = Random.new(os.time())

-- ------------------------------------------------------------- utilitaires

local function getHumanoid(character)
	return character and character:FindFirstChildOfClass("Humanoid") or nil
end

local function isAlive(player)
	local humanoid = getHumanoid(player.Character)
	return humanoid ~= nil and humanoid.Health > 0
end

local function now()
	return os.clock()
end

--- true si le personnage est encore protege par son apparition.
local function isProtected(character)
	if not character then
		return false
	end
	local until_ = character:GetAttribute("ProtectedUntil")
	return type(until_) == "number" and until_ > now()
end

local function damageMultiplierFor(character)
	if not character then
		return 1
	end
	local until_ = character:GetAttribute("DamageBoostUntil")
	if type(until_) == "number" and until_ > now() then
		return GameConfig.PowerupDamageMultiplier
	end
	return 1
end

local function shieldMultiplierFor(character)
	if not character then
		return 1
	end
	local until_ = character:GetAttribute("ShieldUntil")
	if type(until_) == "number" and until_ > now() then
		return GameConfig.PowerupShieldReduction
	end
	return 1
end

-- ----------------------------------------------------------------- degats

--- Applique des degats a une victime. Gere protection, bouclier et elimination.
function CombatService.ApplyDamage(victimPlayer, victimCharacter, attacker, amount, isHead, weapon)
	local humanoid = getHumanoid(victimCharacter)
	if not humanoid or humanoid.Health <= 0 then
		return 0
	end
	if isProtected(victimCharacter) then
		return 0
	end

	local final = amount * shieldMultiplierFor(victimCharacter)
	if attacker then
		final = final * damageMultiplierFor(attacker.Character)
	end
	final = math.max(1, math.floor(final + 0.5))

	humanoid.Health = math.max(0, humanoid.Health - final)
	victimCharacter:SetAttribute("LastHitAt", now())
	-- Memorise le dernier agresseur : PlayerService s'en sert au moment du
	-- deces pour attribuer l'elimination (y compris apres une chute).
	if attacker then
		victimCharacter:SetAttribute("LastAttackerUserId", attacker.UserId)
		victimCharacter:SetAttribute("LastAttackerAt", now())
		victimCharacter:SetAttribute("LastWeaponId", weapon and weapon.id or nil)
	end

	if victimPlayer then
		local origin = attacker and attacker.Character and attacker.Character:FindFirstChild("HumanoidRootPart")
		Net.Event("Damaged"):FireClient(
			victimPlayer,
			final,
			origin and (origin :: BasePart).Position or nil,
			attacker and attacker.Name or nil
		)
		ServerEvents.PlayerDamaged:Fire(victimPlayer, attacker, final, isHead)
	end

	if attacker and attacker ~= victimPlayer then
		Net.Event("HitMarker"):FireClient(attacker, final, humanoid.Health <= 0, isHead)
		DataService.AddStat(attacker, "hits", 1)
	end

	return final
end

--- Ralentit temporairement un personnage (Rayon Glace, Lance a incendie).
local function applySlow(character, amount, duration)
	local humanoid = getHumanoid(character)
	if not humanoid or amount <= 0 or duration <= 0 then
		return
	end
	local baseSpeed = character:GetAttribute("BaseWalkSpeed")
	if type(baseSpeed) ~= "number" then
		baseSpeed = GameConfig.WalkSpeed
	end
	local until_ = now() + duration
	character:SetAttribute("SlowUntil", until_)
	character:SetAttribute("SlowFactor", 1 - math.clamp(amount, 0, 0.8))
	humanoid.WalkSpeed = baseSpeed * (1 - math.clamp(amount, 0, 0.8))

	task.delay(duration, function()
		if character.Parent and character:GetAttribute("SlowUntil") == until_ then
			character:SetAttribute("SlowUntil", nil)
			character:SetAttribute("SlowFactor", nil)
			local currentHumanoid = getHumanoid(character)
			if currentHumanoid and currentHumanoid.Health > 0 then
				local restore = character:GetAttribute("BaseWalkSpeed")
				currentHumanoid.WalkSpeed = type(restore) == "number" and restore or GameConfig.WalkSpeed
			end
		end
	end)
end

--- Degats de zone avec attenuation et verification de la ligne de vue.
local function applySplash(position, weapon, attacker, damageScale)
	if weapon.splashRadius <= 0 then
		return
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.IgnoreWater = true

	for _, player in ipairs(Players:GetPlayers()) do
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if root and isAlive(player) then
			local rootPart = root :: BasePart
			local offset = rootPart.Position - position
			local distance = offset.Magnitude
			if distance <= weapon.splashRadius then
				local allied = attacker ~= nil and TeamService.AreAllies(attacker, player)
				if not allied or weapon.heal > 0 then
					-- Ligne de vue : une explosion ne traverse pas un mur.
					params.FilterDescendantsInstances = { character }
					local blocked = false
					if distance > 1 then
						local hit = workspace:Raycast(position, offset, params)
						blocked = hit ~= nil
					end
					if not blocked then
						local falloff = 1 - (distance / weapon.splashRadius) * 0.75
						if allied and weapon.heal > 0 then
							local humanoid = getHumanoid(character)
							if humanoid then
								humanoid.Health = math.min(humanoid.MaxHealth, humanoid.Health + weapon.heal * falloff)
							end
						elseif not allied then
							CombatService.ApplyDamage(
								player,
								character,
								attacker,
								weapon.splashDamage * falloff * damageScale,
								false,
								weapon
							)
						end
					end
				end
			end
		end
	end
end

-- ------------------------------------------------------------ projectiles

local function spawnProjectile(player, weapon, origin, direction, damageScale)
	if #projectiles >= GameConfig.MaxActiveProjectiles then
		return
	end
	local character = player.Character
	table.insert(projectiles, {
		position = origin,
		velocity = direction * weapon.speed,
		weapon = weapon,
		owner = player,
		ownerCharacter = character,
		damageScale = damageScale,
		expires = now() + weapon.lifetime,
	})
end

--- Resout l'impact d'un projectile.
local function resolveHit(projectile, result)
	local weapon = projectile.weapon
	local attacker = projectile.owner
	local position = result.Position

	local character, humanoid = Util.GetCharacterFromPart(result.Instance)
	local hitCharacter = false

	if character and humanoid and humanoid.Health > 0 then
		local victim = Players:GetPlayerFromCharacter(character)
		local allied = victim ~= nil and attacker ~= nil and TeamService.AreAllies(attacker, victim)

		if allied and weapon.heal > 0 then
			humanoid.Health = math.min(humanoid.MaxHealth, humanoid.Health + weapon.heal)
			hitCharacter = true
		elseif not allied and character ~= projectile.ownerCharacter then
			local isHead = result.Instance.Name == "Head"
			local damage = weapon.damage * projectile.damageScale
			if isHead then
				damage = damage * weapon.headshot
			end
			CombatService.ApplyDamage(victim, character, attacker, damage, isHead, weapon)
			if weapon.slow > 0 then
				applySlow(character, weapon.slow, weapon.slowTime)
			end
			hitCharacter = true
		end
	end

	applySplash(position, weapon, attacker, projectile.damageScale)

	Net.Event("ImpactEffect"):FireAllClients(position, result.Normal, weapon.id, hitCharacter)
end

local function stepProjectiles(deltaTime)
	if #projectiles == 0 then
		return
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.IgnoreWater = true

	local currentTime = now()
	local index = 1
	while index <= #projectiles do
		local projectile = projectiles[index]
		local weapon = projectile.weapon
		local remove = false

		projectile.velocity = projectile.velocity - Vector3.new(0, GRAVITY * weapon.gravity * deltaTime, 0)
		local nextPosition = projectile.position + projectile.velocity * deltaTime

		params.FilterDescendantsInstances = { projectile.ownerCharacter }
		local result = workspace:Raycast(projectile.position, nextPosition - projectile.position, params)
		if result then
			resolveHit(projectile, result)
			remove = true
		else
			projectile.position = nextPosition
			if currentTime >= projectile.expires or nextPosition.Y < -500 then
				remove = true
			end
		end

		if remove then
			-- Suppression en O(1) : on remplace par le dernier element.
			projectiles[index] = projectiles[#projectiles]
			projectiles[#projectiles] = nil
		else
			index = index + 1
		end
	end
end

-- ------------------------------------------------------------------- tir

local function handleFire(player, origin, direction, charge)
	if not roundActive or not isAlive(player) then
		return
	end
	if typeof(origin) ~= "Vector3" or typeof(direction) ~= "Vector3" then
		return
	end
	if direction.Magnitude < 0.01 or origin.Magnitude > 100000 then
		return
	end

	local weapon = WeaponService.GetEquipped(player)
	if not weapon then
		return
	end

	-- Anti-triche : l'origine declaree doit rester pres du personnage.
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root then
		return
	end
	if ((root :: BasePart).Position - origin).Magnitude > GameConfig.MaxFireOriginDistance then
		return
	end

	local allowed = WeaponService.TryConsume(player, weapon)
	if not allowed then
		return
	end

	-- Tirer annule la protection d'apparition : on ne tire pas depuis un abri.
	if character and isProtected(character) then
		character:SetAttribute("ProtectedUntil", nil)
	end

	local chargeRatio = 0
	if weapon.chargeTime > 0 and type(charge) == "number" then
		chargeRatio = math.clamp(charge, 0, 1)
	end
	local damageScale = 1 + (weapon.chargeBonus - 1) * chargeRatio

	DataService.AddStat(player, "shots", 1)

	local unit = direction.Unit
	local function volley()
		for _ = 1, weapon.pellets do
			local spread = Util.ApplySpread(unit, weapon.spread, rng)
			spawnProjectile(player, weapon, origin, spread, damageScale)
		end
		Net.Event("ProjectileSpawned"):FireAllClients(
			player,
			weapon.id,
			origin,
			unit,
			chargeRatio
		)
	end

	volley()
	-- Rafales : les coups suivants partent du meme point, sans nouvel envoi client.
	for shot = 2, weapon.burst do
		task.delay((shot - 1) * 0.07, function()
			if roundActive and isAlive(player) then
				volley()
			end
		end)
	end
end

-- ----------------------------------------------------------------- cycle

function CombatService.SetRoundActive(active)
	roundActive = active
	if not active then
		table.clear(projectiles)
	end
end

function CombatService.GetProjectileCount()
	return #projectiles
end

function CombatService.Start()
	Net.Event("FireWeapon").OnServerEvent:Connect(function(player, origin, direction, charge)
		local ok, err = pcall(handleFire, player, origin, direction, charge)
		if not ok then
			warn("[WaterWars] Erreur de tir : " .. tostring(err))
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		for index = #projectiles, 1, -1 do
			if projectiles[index].owner == player then
				projectiles[index] = projectiles[#projectiles]
				projectiles[#projectiles] = nil
			end
		end
	end)

	RunService.Heartbeat:Connect(function(deltaTime)
		local ok, err = pcall(stepProjectiles, math.min(deltaTime, 0.1))
		if not ok then
			warn("[WaterWars] Erreur de simulation : " .. tostring(err))
		end
	end)
end

return CombatService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="29">
        <Properties>
          <string name="Name">DataService</string>
          <string name="Source"><![CDATA[--[[
	DataService
	Sauvegarde persistante : pieces, armes debloquees, equipement, statistiques.

	Tout passe par pcall : si les DataStore sont indisponibles (Studio sans
	acces API, coupure Roblox), le jeu continue avec un profil en memoire au
	lieu de planter. C'est le comportement attendu d'un jeu en production.
]]

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local WaterWars = ReplicatedStorage:WaitForChild("WaterWars")
local Config = WaterWars:WaitForChild("Config")
local Shared = WaterWars:WaitForChild("Shared")

local GameConfig = require(Config:WaitForChild("GameConfig"))
local Weapons = require(Config:WaitForChild("Weapons"))
local Net = require(Shared:WaitForChild("Net"))
local Signal = require(Shared:WaitForChild("Signal"))
local Util = require(Shared:WaitForChild("Util"))

local DataService = {}

DataService.ProfileChanged = Signal.new("ProfileChanged")

local profiles = {}
local store = nil
local storeAvailable = false

local SAVE_RETRIES = 3

local function defaultProfile()
	local owned = {}
	for _, id in ipairs(Weapons.StarterIds) do
		owned[id] = true
	end
	return {
		version = 1,
		coins = GameConfig.Rewards.StartingCoins,
		owned = owned,
		loadout = {
			primary = Weapons.DefaultPrimary,
			secondary = Weapons.DefaultSecondary,
		},
		stats = {
			kills = 0,
			deaths = 0,
			wins = 0,
			rounds = 0,
			shots = 0,
			hits = 0,
			bestStreak = 0,
		},
	}
end

--- Repare un profil charge depuis le DataStore (migration douce).
local function sanitize(profile)
	local base = defaultProfile()
	if type(profile) ~= "table" then
		return base
	end
	profile.version = 1
	profile.coins = math.max(0, math.floor(tonumber(profile.coins) or base.coins))

	if type(profile.owned) ~= "table" then
		profile.owned = base.owned
	end
	-- On retire les armes qui n'existent plus et on garantit les armes de depart.
	for id in pairs(profile.owned) do
		if not Weapons.Exists(id) then
			profile.owned[id] = nil
		end
	end
	for _, id in ipairs(Weapons.StarterIds) do
		profile.owned[id] = true
	end

	if type(profile.loadout) ~= "table" then
		profile.loadout = base.loadout
	end
	for slot, fallback in pairs(base.loadout) do
		local current = profile.loadout[slot]
		if type(current) ~= "string" or not Weapons.Exists(current) or not profile.owned[current] then
			profile.loadout[slot] = fallback
		end
	end

	if type(profile.stats) ~= "table" then
		profile.stats = base.stats
	end
	for key, fallback in pairs(base.stats) do
		profile.stats[key] = math.max(0, math.floor(tonumber(profile.stats[key]) or fallback))
	end
	return profile
end

local function keyFor(player)
	return "player_" .. tostring(player.UserId)
end

local function loadProfile(player)
	if not storeAvailable or not store then
		return defaultProfile()
	end
	for attempt = 1, SAVE_RETRIES do
		local ok, result = pcall(function()
			return store:GetAsync(keyFor(player))
		end)
		if ok then
			if result == nil then
				return defaultProfile()
			end
			return sanitize(result)
		end
		warn(string.format("[WaterWars] Lecture du profil de %s echouee (essai %d) : %s", player.Name, attempt, tostring(result)))
		task.wait(attempt * 0.8)
	end
	return defaultProfile()
end

local function saveProfile(player, profile)
	if not storeAvailable or not store or profile == nil then
		return false
	end
	for attempt = 1, SAVE_RETRIES do
		local ok, err = pcall(function()
			store:SetAsync(keyFor(player), profile)
		end)
		if ok then
			return true
		end
		warn(string.format("[WaterWars] Sauvegarde du profil de %s echouee (essai %d) : %s", player.Name, attempt, tostring(err)))
		task.wait(attempt * 0.8)
	end
	return false
end

--- Envoie le profil au client concerne.
function DataService.Push(player)
	local profile = profiles[player]
	if not profile then
		return
	end
	Net.Event("ProfileUpdate"):FireClient(player, {
		coins = profile.coins,
		owned = profile.owned,
		loadout = profile.loadout,
		stats = profile.stats,
	})
end

function DataService.Get(player)
	return profiles[player]
end

--- Ajoute (ou retire) des pieces, puis previent le client.
function DataService.AddCoins(player, amount)
	local profile = profiles[player]
	if not profile then
		return 0
	end
	profile.coins = math.max(0, profile.coins + math.floor(amount))
	DataService.Push(player)
	return profile.coins
end

function DataService.Owns(player, weaponId)
	local profile = profiles[player]
	return profile ~= nil and profile.owned[weaponId] == true
end

--- Tente l'achat d'une arme. Renvoie (succes, message).
function DataService.Purchase(player, weaponId)
	local profile = profiles[player]
	if not profile then
		return false, "Profil indisponible"
	end
	local weapon = Weapons.Get(weaponId)
	if not weapon then
		return false, "Arme inconnue"
	end
	if profile.owned[weaponId] then
		return false, "Vous possedez deja cette arme"
	end
	if profile.coins < weapon.price then
		return false, string.format("Il vous manque %s pieces", Util.FormatNumber(weapon.price - profile.coins))
	end
	profile.coins = profile.coins - weapon.price
	profile.owned[weaponId] = true
	DataService.Push(player)
	DataService.ProfileChanged:Fire(player, profile)
	return true, string.format("%s debloque !", weapon.name)
end

--- Change une arme d'equipement. Renvoie (succes, message).
function DataService.SetLoadout(player, slot, weaponId)
	local profile = profiles[player]
	if not profile then
		return false, "Profil indisponible"
	end
	if slot ~= "primary" and slot ~= "secondary" then
		return false, "Emplacement invalide"
	end
	if not Weapons.Exists(weaponId) then
		return false, "Arme inconnue"
	end
	if not profile.owned[weaponId] then
		return false, "Arme non debloquee"
	end
	profile.loadout[slot] = weaponId
	DataService.Push(player)
	DataService.ProfileChanged:Fire(player, profile)
	return true, string.format("%s equipe", Weapons.Get(weaponId).name)
end

function DataService.AddStat(player, key, amount)
	local profile = profiles[player]
	if not profile or profile.stats[key] == nil then
		return
	end
	profile.stats[key] = profile.stats[key] + (amount or 1)
end

function DataService.SetBestStreak(player, streak)
	local profile = profiles[player]
	if profile and streak > profile.stats.bestStreak then
		profile.stats.bestStreak = streak
	end
end

local function onPlayerAdded(player)
	local profile = loadProfile(player)
	-- Le joueur a pu partir pendant le chargement.
	if not player.Parent then
		return
	end
	profiles[player] = profile
	DataService.Push(player)
	DataService.ProfileChanged:Fire(player, profile)
end

local function onPlayerRemoving(player)
	local profile = profiles[player]
	profiles[player] = nil
	if profile then
		saveProfile(player, profile)
	end
end

function DataService.Start()
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(GameConfig.DataStoreName)
	end)
	if ok and result then
		store = result
		-- On teste l'acces reel : en Studio sans "API Services", GetAsync echoue.
		local testOk = pcall(function()
			store:GetAsync("__connectivity_probe__")
		end)
		storeAvailable = testOk
	end
	if not storeAvailable then
		warn("[WaterWars] DataStore indisponible : les profils ne seront pas sauvegardes (normal en Studio sans acces API).")
	end

	Players.PlayerAdded:Connect(function(player)
		task.spawn(onPlayerAdded, player)
	end)
	for _, player in ipairs(Players:GetPlayers()) do
		task.spawn(onPlayerAdded, player)
	end
	Players.PlayerRemoving:Connect(onPlayerRemoving)

	game:BindToClose(function()
		for player, profile in pairs(profiles) do
			saveProfile(player, profile)
		end
		if not RunService:IsStudio() then
			task.wait(1)
		end
	end)

	-- Sauvegarde periodique : on ne perd jamais plus d'une poignee de minutes.
	task.spawn(function()
		while true do
			task.wait(GameConfig.AutosaveInterval)
			for player, profile in pairs(profiles) do
				saveProfile(player, profile)
			end
		end
	end)

	Net.Function("GetProfile").OnServerInvoke = function(player)
		local profile = profiles[player]
		if not profile then
			return nil
		end
		return {
			coins = profile.coins,
			owned = profile.owned,
			loadout = profile.loadout,
			stats = profile.stats,
		}
	end

	Net.Event("RequestPurchase").OnServerEvent:Connect(function(player, weaponId)
		if type(weaponId) ~= "string" then
			return
		end
		local success, message = DataService.Purchase(player, weaponId)
		Net.Event("Notify"):FireClient(player, message, success and "good" or "bad")
	end)
end

return DataService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="30">
        <Properties>
          <string name="Name">MapService</string>
          <string name="Source"><![CDATA[--[[
	MapService
	Construit et detruit les terrains, applique l'ambiance lumineuse, et
	fabrique les elements de jeu propres a la map : stations de recharge,
	zone de controle, points d'apparition.

	Toute la geometrie vit dans un seul Model (workspace.CurrentMap) : le
	nettoyage de fin de manche est donc instantane et ne laisse rien derriere.
]]

local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local WaterWars = ReplicatedStorage:WaitForChild("WaterWars")
local Config = WaterWars:WaitForChild("Config")
local Shared = WaterWars:WaitForChild("Shared")

local GameConfig = require(Config:WaitForChild("GameConfig"))
local Maps = require(Config:WaitForChild("Maps"))
local MapBuilder = require(Shared:WaitForChild("MapBuilder"))

local MapService = {}

local currentMap = nil
local currentModel = nil
local refillParts = {}
local hillPart = nil

local MAP_MODEL_NAME = "CurrentMap"

--- Ambiance par defaut, restauree si aucune map n'est chargee.
local function applyLighting(settings)
	Lighting.ClockTime = settings.ClockTime or 14
	Lighting.Brightness = settings.Brightness or 2.5
	Lighting.Ambient = settings.Ambient or Color3.fromRGB(120, 120, 120)
	Lighting.OutdoorAmbient = settings.OutdoorAmbient or Color3.fromRGB(150, 150, 150)
	Lighting.FogColor = settings.FogColor or Color3.fromRGB(200, 220, 240)
	Lighting.FogStart = settings.FogStart or 200
	Lighting.FogEnd = settings.FogEnd or 800
	Lighting.ColorShift_Top = settings.ColorShift_Top or Color3.fromRGB(255, 255, 255)
	Lighting.GlobalShadows = true
	Lighting.EnvironmentDiffuseScale = 0.6
	Lighting.EnvironmentSpecularScale = 0.6

	local atmosphere = Lighting:FindFirstChildOfClass("Atmosphere")
	if not atmosphere then
		atmosphere = Instance.new("Atmosphere")
		atmosphere.Parent = Lighting
	end
	atmosphere.Density = settings.Density or 0.3
	atmosphere.Haze = settings.Haze or 1.2
	atmosphere.Glare = 0.2
	atmosphere.Color = settings.FogColor or Color3.fromRGB(200, 220, 240)
	atmosphere.Decay = settings.ColorShift_Top or Color3.fromRGB(180, 200, 220)
end

--- Station de recharge : une plaque lumineuse avec un bidon qui tourne.
local function createRefillStation(parent, position, index)
	local station = Instance.new("Model")
	station.Name = "RefillStation" .. index

	local pad = Instance.new("Part")
	pad.Name = "Pad"
	pad.Shape = Enum.PartType.Cylinder
	pad.Size = Vector3.new(1, GameConfig.RefillRadius * 2, GameConfig.RefillRadius * 2)
	pad.CFrame = CFrame.new(position + Vector3.new(0, 0.5, 0)) * CFrame.Angles(0, 0, math.rad(90))
	pad.Anchored = true
	pad.CanCollide = false
	pad.CanQuery = false
	pad.CanTouch = false
	pad.Material = Enum.Material.Neon
	pad.Color = Color3.fromRGB(70, 200, 255)
	pad.Transparency = 0.55
	pad.CastShadow = false
	pad.Parent = station

	local tank = Instance.new("Part")
	tank.Name = "Tank"
	tank.Shape = Enum.PartType.Cylinder
	tank.Size = Vector3.new(7, 5, 5)
	tank.CFrame = CFrame.new(position + Vector3.new(0, 4.5, 0)) * CFrame.Angles(0, 0, math.rad(90))
	tank.Anchored = true
	tank.CanCollide = true
	tank.Material = Enum.Material.SmoothPlastic
	tank.Color = Color3.fromRGB(40, 130, 200)
	tank.Parent = station

	local light = Instance.new("PointLight")
	light.Brightness = 2
	light.Range = 22
	light.Color = Color3.fromRGB(90, 200, 255)
	light.Parent = tank

	local billboard = Instance.new("BillboardGui")
	billboard.Name = "Label"
	billboard.Size = UDim2.fromOffset(180, 46)
	billboard.StudsOffsetWorldSpace = Vector3.new(0, 5, 0)
	billboard.AlwaysOnTop = false
	billboard.MaxDistance = 140
	billboard.Parent = tank

	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = "RECHARGE"
	label.TextColor3 = Color3.fromRGB(180, 240, 255)
	label.TextStrokeTransparency = 0.4
	label.Font = Enum.Font.GothamBold
	label.TextScaled = true
	label.Parent = billboard

	station.Parent = parent
	return station
end

--- Marqueur de la zone de controle (mode Roi de la piscine).
local function createHill(parent, position)
	local zone = Instance.new("Part")
	zone.Name = "HillZone"
	zone.Shape = Enum.PartType.Cylinder
	zone.Size = Vector3.new(60, GameConfig.HillRadius * 2, GameConfig.HillRadius * 2)
	zone.CFrame = CFrame.new(position) * CFrame.Angles(0, 0, math.rad(90))
	zone.Anchored = true
	zone.CanCollide = false
	zone.CanQuery = false
	zone.CanTouch = false
	zone.Material = Enum.Material.Neon
	zone.Color = Color3.fromRGB(230, 230, 230)
	zone.Transparency = 0.86
	zone.CastShadow = false
	zone.Parent = parent
	return zone
end

--- Detruit la map courante et remet le monde a plat.
function MapService.Unload()
	if currentModel then
		currentModel:Destroy()
	end
	currentModel = nil
	currentMap = nil
	refillParts = {}
	hillPart = nil
end

--- Construit `map` dans le workspace. Renvoie le Model cree.
function MapService.Load(map)
	assert(map, "MapService.Load : map manquante")
	MapService.Unload()

	local model = Instance.new("Model")
	model.Name = MAP_MODEL_NAME

	local geometry = Instance.new("Folder")
	geometry.Name = "Geometry"
	geometry.Parent = model

	local builder = MapBuilder.new(geometry, 20240900 + (map.order or 1))
	map.build(builder)

	local props = Instance.new("Folder")
	props.Name = "Props"
	props.Parent = model

	refillParts = {}
	for index, position in ipairs(map.refillStations) do
		local station = createRefillStation(props, position, index)
		table.insert(refillParts, { position = position, model = station })
	end

	hillPart = createHill(props, map.controlPoint)

	model.Parent = workspace
	currentModel = model
	currentMap = map

	applyLighting(map.lighting)
	workspace.FallenPartsDestroyHeight = (map.killY or -50) - 200

	print(string.format(
		"[WaterWars] Terrain construit : %s (%d pieces) -> workspace.%s",
		map.name,
		builder.count,
		MAP_MODEL_NAME
	))

	return model
end

function MapService.GetCurrentMap()
	return currentMap
end

function MapService.GetModel()
	return currentModel
end

function MapService.GetRefillStations()
	return refillParts
end

function MapService.GetHillPart()
	return hillPart
end

--- Colore la zone de controle selon l'equipe qui la tient.
function MapService.SetHillColor(color, transparency)
	if hillPart then
		hillPart.Color = color
		hillPart.Transparency = transparency or 0.86
	end
end

--- Renvoie une liste de points d'apparition pour un camp donne.
--- `teamId` vaut "Blue", "Red" ou nil (chacun pour soi).
function MapService.GetSpawnList(teamId)
	if not currentMap then
		return {}
	end
	local spawns = currentMap.spawns
	if teamId and spawns[teamId] then
		return spawns[teamId]
	end
	return spawns.FFA
end

--- CFrame d'apparition, orientee vers le centre du terrain.
function MapService.GetSpawnCFrame(teamId, index)
	local list = MapService.GetSpawnList(teamId)
	if #list == 0 then
		return CFrame.new(0, 20, 0)
	end
	local position = list[((index - 1) % #list) + 1]
	local target = currentMap and currentMap.controlPoint or Vector3.new(0, position.Y, 0)
	local flatTarget = Vector3.new(target.X, position.Y, target.Z)
	if (flatTarget - position).Magnitude < 1 then
		return CFrame.new(position)
	end
	return CFrame.lookAt(position, flatTarget)
end

--- Hauteur en dessous de laquelle un joueur est considere comme tombe.
function MapService.GetKillY()
	return currentMap and currentMap.killY or -100
end

--- Donnees envoyees au client pour l'ecran de vote et le HUD.
function MapService.Describe(map)
	return {
		id = map.id,
		name = map.name,
		theme = map.theme,
		description = map.description,
	}
end

function MapService.GetAll()
	return Maps.List
end

function MapService.PickRandom(count, excludeId, rng)
	return Maps.PickRandom(count, excludeId, rng)
end

function MapService.GetById(id)
	return Maps.Get(id)
end

return MapService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="31">
        <Properties>
          <string name="Name">MatchService</string>
          <string name="Source"><![CDATA[--[[
	MatchService
	Chef d'orchestre de la partie : vote de map, lancement de la manche,
	decompte, scores, eliminations, fin de manche et recompenses.

	Cycle : Attente -> Vote -> Chargement -> Manche -> Resultats -> Vote ...
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local WaterWars = ReplicatedStorage:WaitForChild("WaterWars")
local Config = WaterWars:WaitForChild("Config")
local Shared = WaterWars:WaitForChild("Shared")

local GameConfig = require(Config:WaitForChild("GameConfig"))
local Weapons = require(Config:WaitForChild("Weapons"))
local Net = require(Shared:WaitForChild("Net"))
local Util = require(Shared:WaitForChild("Util"))

local ServerEvents = require(script.Parent:WaitForChild("ServerEvents"))
local CombatService = require(script.Parent:WaitForChild("CombatService"))
local DataService = require(script.Parent:WaitForChild("DataService"))
local MapService = require(script.Parent:WaitForChild("MapService"))
local PickupService = require(script.Parent:WaitForChild("PickupService"))
local PlayerService = require(script.Parent:WaitForChild("PlayerService"))
local TeamService = require(script.Parent:WaitForChild("TeamService"))

local MatchService = {}

local STATE = {
	Waiting = "Waiting",
	Vote = "Vote",
	Loading = "Loading",
	Active = "Active",
	Results = "Results",
}

local state = STATE.Waiting
local stateEndsAt = 0
local currentMode = GameConfig.GameModes[1]
local currentMap = nil
local modeIndex = 0
local lastMapId = nil

local teamScores = { Blue = 0, Red = 0 }
local roundStats = {}
local damageLog = {} -- damageLog[victim] = { [attacker] = degats }

local voteOptions = {}
local votes = {}

local rng = Random.new(os.time() + 11)
local hillAccumulator = 0
local scoreboardAccumulator = 0
local lastResult = nil

-- ------------------------------------------------------------- utilitaires

local function statsFor(player)
	local stats = roundStats[player]
	if not stats then
		stats = { kills = 0, deaths = 0, score = 0, streak = 0, assists = 0 }
		roundStats[player] = stats
	end
	return stats
end

local function modeById(id)
	for _, mode in ipairs(GameConfig.GameModes) do
		if mode.id == id then
			return mode
		end
	end
	return GameConfig.GameModes[1]
end

local function scoreLimit()
	return GameConfig.ScoreLimit[currentMode.id] or 50
end

local function timeLeft()
	return math.max(0, stateEndsAt - os.clock())
end

--- Vue envoyee au client a chaque changement d'etat et chaque seconde.
local function buildStatePayload()
	return {
		state = state,
		timeLeft = timeLeft(),
		mode = {
			id = currentMode.id,
			name = currentMode.name,
			description = currentMode.description,
			teamBased = currentMode.teamBased,
		},
		map = currentMap and MapService.Describe(currentMap) or nil,
		scores = { Blue = teamScores.Blue, Red = teamScores.Red },
		scoreLimit = scoreLimit(),
		playerCount = #Players:GetPlayers(),
		minPlayers = GameConfig.MinPlayersToStart,
		result = lastResult,
	}
end

local function broadcastState()
	Net.Event("MatchState"):FireAllClients(buildStatePayload())
end

local function broadcastScoreboard()
	local rows = {}
	for _, player in ipairs(Players:GetPlayers()) do
		local stats = statsFor(player)
		table.insert(rows, {
			userId = player.UserId,
			name = player.DisplayName,
			team = TeamService.GetTeamId(player),
			kills = stats.kills,
			deaths = stats.deaths,
			assists = stats.assists,
			score = stats.score,
			streak = stats.streak,
		})
	end
	table.sort(rows, function(a, b)
		if a.score == b.score then
			return a.kills > b.kills
		end
		return a.score > b.score
	end)
	Net.Event("Scoreboard"):FireAllClients(rows)
end

local function setState(newState, duration)
	state = newState
	stateEndsAt = os.clock() + duration
	broadcastState()
end

local function notifyAll(message, kind)
	Net.Event("Notify"):FireAllClients(message, kind or "info")
end

-- ------------------------------------------------------------------ vote

local function startVote()
	currentMap = nil
	lastResult = nil
	table.clear(votes)
	voteOptions = MapService.PickRandom(GameConfig.MapVoteChoices, lastMapId, rng)

	modeIndex = modeIndex + 1
	local rotation = GameConfig.ModeRotation
	currentMode = modeById(rotation[((modeIndex - 1) % #rotation) + 1])

	local payload = {}
	for _, map in ipairs(voteOptions) do
		table.insert(payload, MapService.Describe(map))
	end

	setState(STATE.Vote, GameConfig.MapVoteTime)
	Net.Event("MapVote"):FireAllClients({
		phase = "open",
		options = payload,
		duration = GameConfig.MapVoteTime,
		votes = {},
		mode = currentMode.name,
	})
end

local function broadcastVotes()
	local counts = {}
	for _, mapId in pairs(votes) do
		counts[mapId] = (counts[mapId] or 0) + 1
	end
	Net.Event("MapVote"):FireAllClients({ phase = "update", votes = counts })
end

local function resolveVote()
	local counts = {}
	for _, mapId in pairs(votes) do
		counts[mapId] = (counts[mapId] or 0) + 1
	end
	local bestMap, bestCount = nil, -1
	for _, map in ipairs(voteOptions) do
		local count = counts[map.id] or 0
		if count > bestCount then
			bestMap, bestCount = map, count
		end
	end
	if not bestMap then
		bestMap = Util.Pick(MapService.GetAll(), rng)
	end
	return bestMap
end

-- ------------------------------------------------------------- manche

local function resetRound()
	teamScores.Blue = 0
	teamScores.Red = 0
	table.clear(roundStats)
	table.clear(damageLog)
	for _, player in ipairs(Players:GetPlayers()) do
		statsFor(player)
	end
end

local function startRound(map)
	currentMap = map
	lastMapId = map.id
	resetRound()

	setState(STATE.Loading, 3)
	CombatService.SetRoundActive(false)
	PlayerService.SetRespawnEnabled(false)
	MapService.Load(map)
	PickupService.Setup(map)
	TeamService.SetTeamMode(currentMode.teamBased)
	Net.Event("MapReady"):FireAllClients(MapService.Describe(map))

	task.wait(2)

	PlayerService.SetRespawnEnabled(true)
	PlayerService.SpawnAll()
	CombatService.SetRoundActive(true)

	setState(STATE.Active, GameConfig.RoundTime)
	notifyAll(string.format("%s - %s", currentMode.name, map.name), "good")
	broadcastScoreboard()
	ServerEvents.RoundStarted:Fire(map, currentMode)
end

local function winnerText()
	if currentMode.teamBased then
		if teamScores.Blue == teamScores.Red then
			return "Egalite parfaite !", nil
		end
		local winnerId = teamScores.Blue > teamScores.Red and "Blue" or "Red"
		for _, definition in ipairs(GameConfig.Teams) do
			if definition.id == winnerId then
				return definition.name .. " remporte la manche !", winnerId
			end
		end
	end

	local bestPlayer, bestScore = nil, -1
	for player, stats in pairs(roundStats) do
		if stats.score > bestScore then
			bestPlayer, bestScore = player, stats.score
		end
	end
	if bestPlayer then
		return string.format("%s remporte la manche avec %d points !", bestPlayer.DisplayName, bestScore), nil
	end
	return "Manche terminee", nil
end

local function payRewards(winnerTeamId)
	for _, player in ipairs(Players:GetPlayers()) do
		local stats = statsFor(player)
		local reward = 0
		if currentMode.teamBased then
			local teamId = TeamService.GetTeamId(player)
			if winnerTeamId and teamId == winnerTeamId then
				reward = GameConfig.Rewards.RoundWin
				DataService.AddStat(player, "wins", 1)
			else
				reward = GameConfig.Rewards.RoundLoss
			end
		else
			reward = GameConfig.Rewards.RoundLoss + stats.score
		end
		DataService.AddStat(player, "rounds", 1)
		if reward > 0 then
			DataService.AddCoins(player, reward)
		end
	end
end

local function endRound()
	CombatService.SetRoundActive(false)
	PlayerService.SetRespawnEnabled(false)

	local message, winnerTeamId = winnerText()
	payRewards(winnerTeamId)

	local ranking = {}
	for player, stats in pairs(roundStats) do
		table.insert(ranking, {
			name = player.DisplayName,
			kills = stats.kills,
			deaths = stats.deaths,
			score = stats.score,
			team = TeamService.GetTeamId(player),
		})
	end
	table.sort(ranking, function(a, b)
		return a.score > b.score
	end)

	lastResult = {
		message = message,
		winner = winnerTeamId,
		scores = { Blue = teamScores.Blue, Red = teamScores.Red },
		ranking = ranking,
		mapName = currentMap and currentMap.name or "",
	}

	setState(STATE.Results, GameConfig.PostRoundTime)
	notifyAll(message, "good")
	broadcastScoreboard()
	ServerEvents.RoundEnded:Fire(lastResult)

	task.wait(GameConfig.PostRoundTime)

	-- La map reste chargee : entre deux manches les joueurs continuent de
	-- s'echauffer dessus au lieu de fixer un ecran vide. Elle sera remplacee
	-- par MapService.Load() au debut de la manche suivante.
	PickupService.Clear()
end

-- --------------------------------------------------------- roi de la piscine

local function updateHill(deltaTime)
	if currentMode.id ~= "KingOfTheHill" or not currentMap then
		return
	end
	hillAccumulator = hillAccumulator + deltaTime
	if hillAccumulator < GameConfig.HillTickRate then
		return
	end
	hillAccumulator = 0

	local center = currentMap.controlPoint
	local counts = { Blue = 0, Red = 0 }
	for _, player in ipairs(Players:GetPlayers()) do
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if root and humanoid and humanoid.Health > 0 then
			if ((root :: BasePart).Position - center).Magnitude <= GameConfig.HillRadius then
				local teamId = TeamService.GetTeamId(player)
				if teamId and counts[teamId] then
					counts[teamId] = counts[teamId] + 1
				end
			end
		end
	end

	local holder = nil
	if counts.Blue >= GameConfig.HillContestedNeeded and counts.Blue > counts.Red then
		holder = "Blue"
	elseif counts.Red >= GameConfig.HillContestedNeeded and counts.Red > counts.Blue then
		holder = "Red"
	end

	if holder then
		teamScores[holder] = teamScores[holder] + GameConfig.HillPointsPerTick
		MapService.SetHillColor(TeamService.GetTeamColor(holder), 0.72)
		for _, player in ipairs(Players:GetPlayers()) do
			local character = player.Character
			local root = character and character:FindFirstChild("HumanoidRootPart")
			if root and TeamService.GetTeamId(player) == holder then
				if ((root :: BasePart).Position - center).Magnitude <= GameConfig.HillRadius then
					statsFor(player).score = statsFor(player).score + GameConfig.HillPointsPerTick
					DataService.AddCoins(player, GameConfig.Rewards.CaptureTick)
				end
			end
		end
	elseif counts.Blue > 0 and counts.Red > 0 then
		MapService.SetHillColor(Color3.fromRGB(255, 220, 90), 0.72) -- zone disputee
	else
		MapService.SetHillColor(Color3.fromRGB(230, 230, 230), 0.86)
	end
end

-- ------------------------------------------------------------ eliminations

local function onPlayerKilled(victim, killer, weaponId)
	if state ~= STATE.Active then
		return
	end
	local victimStats = statsFor(victim)
	victimStats.deaths = victimStats.deaths + 1
	victimStats.streak = 0
	DataService.AddStat(victim, "deaths", 1)

	local weapon = weaponId and Weapons.Get(weaponId) or nil

	if killer and killer ~= victim then
		local killerStats = statsFor(killer)
		killerStats.kills = killerStats.kills + 1
		killerStats.streak = killerStats.streak + 1
		killerStats.score = killerStats.score + GameConfig.Rewards.Splash
		DataService.AddStat(killer, "kills", 1)
		DataService.SetBestStreak(killer, killerStats.streak)

		local coins = GameConfig.Rewards.Kill
		local bonus = GameConfig.KillstreakBonus[killerStats.streak]
		if bonus then
			coins = coins + bonus
			Net.Event("Notify"):FireClient(killer, string.format("Serie de %d ! +%d pieces", killerStats.streak, bonus), "good")
		end
		DataService.AddCoins(killer, coins)

		if currentMode.teamBased then
			local teamId = TeamService.GetTeamId(killer)
			if teamId and teamScores[teamId] then
				teamScores[teamId] = teamScores[teamId] + GameConfig.Rewards.Splash
			end
		end
	end

	-- Assistances : tout joueur ayant inflige au moins 25 degats a la victime.
	local log = damageLog[victim]
	if log then
		for attacker, amount in pairs(log) do
			if attacker ~= killer and attacker ~= victim and amount >= 25 and attacker.Parent then
				local assistStats = statsFor(attacker)
				assistStats.assists = assistStats.assists + 1
				assistStats.score = assistStats.score + 1
				DataService.AddCoins(attacker, GameConfig.Rewards.Assist)
			end
		end
		damageLog[victim] = nil
	end

	Net.Event("KillFeed"):FireAllClients({
		killer = killer and killer.DisplayName or nil,
		killerTeam = killer and TeamService.GetTeamId(killer) or nil,
		victim = victim.DisplayName,
		victimTeam = TeamService.GetTeamId(victim),
		weapon = weapon and weapon.name or nil,
	})
	broadcastState()
	broadcastScoreboard()
end

local function onPlayerDamaged(victim, attacker, amount)
	if not attacker or attacker == victim then
		return
	end
	local log = damageLog[victim]
	if not log then
		log = {}
		damageLog[victim] = log
	end
	log[attacker] = (log[attacker] or 0) + amount
end

-- --------------------------------------------------------- fin de manche ?

local function shouldEndRound()
	if timeLeft() <= 0 then
		return true
	end
	local limit = scoreLimit()
	if currentMode.teamBased then
		return teamScores.Blue >= limit or teamScores.Red >= limit
	end
	for _, stats in pairs(roundStats) do
		if stats.kills >= limit then
			return true
		end
	end
	return false
end

-- ------------------------------------------------------------ boucle

local function gameLoop()
	-- Un terrain est charge des le demarrage du serveur : les premiers joueurs
	-- arrivent dans un decor, pas dans le vide.
	if not MapService.GetCurrentMap() then
		local first = Util.Pick(MapService.GetAll(), rng)
		local ok, err = pcall(MapService.Load, first)
		if not ok then
			-- Sans ce message, un terrain qui ne se construit pas donnerait un
			-- monde vide sans la moindre explication dans la console.
			warn("[WaterWars] Chargement du terrain de depart impossible : " .. tostring(err))
		end
	end

	while true do
		if #Players:GetPlayers() < GameConfig.MinPlayersToStart then
			setState(STATE.Waiting, 1)
			PlayerService.SetRespawnEnabled(true)
			PlayerService.SpawnAll()
			repeat
				task.wait(1)
				broadcastState()
			until #Players:GetPlayers() >= GameConfig.MinPlayersToStart
		end

		-- Echauffement : tout le monde est vivant et peut tirer, mais rien
		-- n'est compte au score (voir onPlayerKilled).
		PlayerService.SetRespawnEnabled(true)
		CombatService.SetRoundActive(true)
		PlayerService.SpawnAll()

		startVote()
		local voteEnd = os.clock() + GameConfig.MapVoteTime
		while os.clock() < voteEnd do
			task.wait(1)
			broadcastState()
		end

		local map = resolveVote()
		Net.Event("MapVote"):FireAllClients({ phase = "closed", chosen = MapService.Describe(map) })

		local ok, err = pcall(startRound, map)
		if not ok then
			warn("[WaterWars] Impossible de demarrer la manche : " .. tostring(err))
			MapService.Unload()
			task.wait(3)
		else
			while state == STATE.Active and not shouldEndRound() do
				task.wait(0.5)
				broadcastState()
			end
			local endedOk, endErr = pcall(endRound)
			if not endedOk then
				warn("[WaterWars] Erreur de fin de manche : " .. tostring(endErr))
				PlayerService.DespawnAll()
				PickupService.Clear()
				MapService.Unload()
			end
		end
	end
end

-- ------------------------------------------------------------ interface

function MatchService.GetState()
	return state
end

function MatchService.IsRoundActive()
	return state == STATE.Active
end

function MatchService.Start()
	ServerEvents.PlayerKilled:Connect(onPlayerKilled)
	ServerEvents.PlayerDamaged:Connect(onPlayerDamaged)

	ServerEvents.CharacterSpawned:Connect(function(player)
		damageLog[player] = nil
	end)

	Net.Event("CastMapVote").OnServerEvent:Connect(function(player, mapId)
		if state ~= STATE.Vote or type(mapId) ~= "string" then
			return
		end
		for _, map in ipairs(voteOptions) do
			if map.id == mapId then
				votes[player] = mapId
				broadcastVotes()
				return
			end
		end
	end)

	Players.PlayerAdded:Connect(function(player)
		statsFor(player)
		TeamService.Assign(player)
		task.wait(0.5)
		broadcastState()
		broadcastScoreboard()
		-- Un joueur qui arrive entre directement en jeu, sauf pendant le
		-- chargement d'un terrain (il apparaitrait dans le vide).
		if state ~= STATE.Loading then
			task.spawn(PlayerService.Spawn, player)
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		roundStats[player] = nil
		damageLog[player] = nil
		votes[player] = nil
		broadcastScoreboard()
	end)

	for _, player in ipairs(Players:GetPlayers()) do
		statsFor(player)
		TeamService.Assign(player)
	end

	RunService.Heartbeat:Connect(function(deltaTime)
		if state ~= STATE.Active then
			return
		end
		local ok, err = pcall(updateHill, deltaTime)
		if not ok then
			warn("[WaterWars] Erreur de la zone de controle : " .. tostring(err))
		end
		scoreboardAccumulator = scoreboardAccumulator + deltaTime
		if scoreboardAccumulator >= 3 then
			scoreboardAccumulator = 0
			broadcastScoreboard()
		end
	end)

	task.spawn(function()
		local ok, err = pcall(gameLoop)
		if not ok then
			warn("[WaterWars] La boucle de partie s'est arretee : " .. tostring(err))
		end
	end)
end

return MatchService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="32">
        <Properties>
          <string name="Name">PickupService</string>
          <string name="Source"><![CDATA[--[[
	PickupService
	Bonus au sol : turbo, haute pression, impermeable et citerne.
	Les plaques apparaissent aux emplacements definis par la map, se
	reactivent apres un delai, et sont ramassees par simple proximite (plus
	fiable que Touched, qui rate des collisions a grande vitesse).
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local WaterWars = ReplicatedStorage:WaitForChild("WaterWars")
local Config = WaterWars:WaitForChild("Config")
local Shared = WaterWars:WaitForChild("Shared")

local GameConfig = require(Config:WaitForChild("GameConfig"))
local Net = require(Shared:WaitForChild("Net"))
local Util = require(Shared:WaitForChild("Util"))

local WeaponService = require(script.Parent:WaitForChild("WeaponService"))

local PickupService = {}

local PICKUP_RADIUS = 7
local CHECK_INTERVAL = 0.15

local pads = {}
local container = nil
local accumulator = 0
local spin = 0

local function powerupById(id)
	for _, definition in ipairs(GameConfig.Powerups) do
		if definition.id == id then
			return definition
		end
	end
	return GameConfig.Powerups[1]
end

local function buildPad(position, definition)
	local model = Instance.new("Model")
	model.Name = "Powerup_" .. definition.id

	local base = Instance.new("Part")
	base.Name = "Base"
	base.Shape = Enum.PartType.Cylinder
	base.Size = Vector3.new(0.6, 9, 9)
	base.CFrame = CFrame.new(position) * CFrame.Angles(0, 0, math.rad(90))
	base.Anchored = true
	base.CanCollide = false
	base.CanQuery = false
	base.CanTouch = false
	base.CastShadow = false
	base.Material = Enum.Material.Neon
	base.Color = definition.color
	base.Transparency = 0.5
	base.Parent = model

	local core = Instance.new("Part")
	core.Name = "Core"
	core.Size = Vector3.new(3.4, 3.4, 3.4)
	core.CFrame = CFrame.new(position + Vector3.new(0, 4, 0))
	core.Anchored = true
	core.CanCollide = false
	core.CanQuery = false
	core.CanTouch = false
	core.Material = Enum.Material.Neon
	core.Color = definition.color
	core.Parent = model

	local light = Instance.new("PointLight")
	light.Color = definition.color
	light.Brightness = 3
	light.Range = 20
	light.Parent = core

	local billboard = Instance.new("BillboardGui")
	billboard.Size = UDim2.fromOffset(190, 40)
	billboard.StudsOffsetWorldSpace = Vector3.new(0, 4, 0)
	billboard.MaxDistance = 130
	billboard.Parent = core

	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = string.upper(definition.name)
	label.TextColor3 = definition.color
	label.TextStrokeTransparency = 0.35
	label.Font = Enum.Font.GothamBold
	label.TextScaled = true
	label.Parent = billboard

	model.Parent = container
	return model, core
end

local function setPadVisible(pad, visible)
	pad.active = visible
	pad.model.Parent = visible and container or nil
end

--- Applique l'effet d'un bonus au joueur.
local function grant(player, definition)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not character or not humanoid then
		return false
	end

	if definition.id == "Refill" then
		WeaponService.RefillAll(player)
		humanoid.Health = math.min(humanoid.MaxHealth, humanoid.Health + 25)
	elseif definition.id == "Speed" then
		character:SetAttribute("SpeedBoostUntil", os.clock() + definition.duration)
	elseif definition.id == "Damage" then
		character:SetAttribute("DamageBoostUntil", os.clock() + definition.duration)
	elseif definition.id == "Shield" then
		character:SetAttribute("ShieldUntil", os.clock() + definition.duration)
		local existing = character:FindFirstChildOfClass("ForceField")
		if existing then
			existing:Destroy()
		end
		local field = Instance.new("ForceField")
		field.Visible = true
		field.Parent = character
		Util.DestroyAfter(field, definition.duration)
	end

	Net.Event("Notify"):FireClient(player, definition.name .. " recupere !", "good")
	Net.Event("EffectState"):FireClient(player, definition.id, definition.duration)
	return true
end

local function step(deltaTime)
	spin = spin + deltaTime * 2
	for _, pad in ipairs(pads) do
		if pad.active and pad.core.Parent then
			pad.core.CFrame = CFrame.new(pad.position + Vector3.new(0, 4 + math.sin(spin * 1.5) * 0.7, 0))
				* CFrame.Angles(spin, spin * 0.8, 0)
		end
	end

	accumulator = accumulator + deltaTime
	if accumulator < CHECK_INTERVAL then
		return
	end
	accumulator = 0

	for _, pad in ipairs(pads) do
		if pad.active then
			for _, player in ipairs(Players:GetPlayers()) do
				local character = player.Character
				local root = character and character:FindFirstChild("HumanoidRootPart")
				local humanoid = character and character:FindFirstChildOfClass("Humanoid")
				if root and humanoid and humanoid.Health > 0 then
					if ((root :: BasePart).Position - pad.position).Magnitude <= PICKUP_RADIUS then
						if grant(player, pad.definition) then
							setPadVisible(pad, false)
							task.delay(GameConfig.PowerupRespawn, function()
								if pad.model.Parent ~= nil or container ~= nil then
									-- Nouveau bonus tire au sort a la reapparition.
									setPadVisible(pad, true)
								end
							end)
						end
						break
					end
				end
			end
		end
	end
end

--- (Re)cree les plaques de bonus pour la map courante.
function PickupService.Setup(map)
	PickupService.Clear()
	container = Instance.new("Folder")
	container.Name = "Powerups"
	container.Parent = workspace

	for index, position in ipairs(map.powerupSpots) do
		-- Un bonus different a chaque emplacement, dans l'ordre de la config.
		local definition = GameConfig.Powerups[((index - 1) % #GameConfig.Powerups) + 1]
		if index == 1 then
			-- L'emplacement central est toujours un bonus offensif.
			definition = powerupById("Damage")
		end
		local model, core = buildPad(position, definition)
		table.insert(pads, {
			position = position,
			definition = definition,
			model = model,
			core = core,
			active = true,
		})
	end
end

function PickupService.Clear()
	for _, pad in ipairs(pads) do
		pad.model:Destroy()
	end
	table.clear(pads)
	if container then
		container:Destroy()
		container = nil
	end
end

function PickupService.Start()
	RunService.Heartbeat:Connect(function(deltaTime)
		if #pads == 0 then
			return
		end
		local ok, err = pcall(step, deltaTime)
		if not ok then
			warn("[WaterWars] Erreur des bonus : " .. tostring(err))
		end
	end)
end

return PickupService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="33">
        <Properties>
          <string name="Name">PlayerService</string>
          <string name="Source"><![CDATA[--[[
	PlayerService
	Tout ce qui concerne le personnage en jeu :
	  - apparition sur un point de la map avec protection temporaire ;
	  - course (sprint) et endurance ;
	  - regeneration hors combat ;
	  - rechargement aux stations d'eau ;
	  - chute hors de la map ;
	  - file de reapparition.

	Les valeurs affichees par le HUD (endurance, bonus actifs) passent par des
	attributs du personnage : ils se repliquent tout seuls vers le client, ce
	qui evite une vingtaine de RemoteEvents par seconde.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local WaterWars = ReplicatedStorage:WaitForChild("WaterWars")
local Config = WaterWars:WaitForChild("Config")
local Shared = WaterWars:WaitForChild("Shared")

local GameConfig = require(Config:WaitForChild("GameConfig"))
local Net = require(Shared:WaitForChild("Net"))

local ServerEvents = require(script.Parent:WaitForChild("ServerEvents"))
local MapService = require(script.Parent:WaitForChild("MapService"))
local TeamService = require(script.Parent:WaitForChild("TeamService"))
local WeaponService = require(script.Parent:WaitForChild("WeaponService"))

local PlayerService = {}

local respawnEnabled = false
local spawnCounters = { Blue = 0, Red = 0, FFA = 0 }
local sprinting = {}
local pendingRespawn = {}
local refillAccumulator = 0

local function now()
	return os.clock()
end

local function nextSpawnIndex(key)
	spawnCounters[key] = (spawnCounters[key] or 0) + 1
	return spawnCounters[key]
end

--- Fait apparaitre le joueur sur un point de la map courante.
function PlayerService.Spawn(player)
	if not player.Parent then
		return
	end
	pendingRespawn[player] = nil

	-- Sans terrain, faire apparaitre le joueur le ferait tomber dans le vide
	-- indefiniment. Mieux vaut ne pas l'incarner et le dire clairement.
	if not MapService.GetCurrentMap() then
		warn("[WaterWars] Apparition annulee : aucun terrain n'est charge.")
		return
	end

	local teamId = TeamService.IsTeamMode() and TeamService.GetTeamId(player) or nil
	local key = teamId or "FFA"
	local spawnCFrame = MapService.GetSpawnCFrame(teamId, nextSpawnIndex(key))

	player:LoadCharacter()

	local character = player.Character
	if not character then
		return
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local root = character:FindFirstChild("HumanoidRootPart")
	if not humanoid or not root then
		return
	end

	character:PivotTo(spawnCFrame + Vector3.new(0, 3.5, 0))

	humanoid.MaxHealth = GameConfig.MaxHealth
	humanoid.Health = GameConfig.MaxHealth
	humanoid.UseJumpPower = true
	humanoid.JumpPower = GameConfig.JumpPower
	humanoid.WalkSpeed = GameConfig.WalkSpeed
	humanoid.BreakJointsOnDeath = false
	humanoid.NameDisplayDistance = 90
	humanoid.HealthDisplayDistance = 90

	character:SetAttribute("BaseWalkSpeed", GameConfig.WalkSpeed)
	character:SetAttribute("Stamina", GameConfig.StaminaMax)
	character:SetAttribute("ProtectedUntil", now() + GameConfig.SpawnProtectionTime)
	character:SetAttribute("LastHitAt", 0)
	character:SetAttribute("LastAttackerUserId", nil)
	character:SetAttribute("LastWeaponId", nil)
	sprinting[player] = false

	-- Bouclier visuel pendant la protection d'apparition.
	local field = Instance.new("ForceField")
	field.Visible = true
	field.Parent = character
	task.delay(GameConfig.SpawnProtectionTime, function()
		if field.Parent then
			field:Destroy()
		end
	end)

	WeaponService.GiveLoadout(player)

	humanoid.Died:Connect(function()
		PlayerService.HandleDeath(player, character)
	end)

	ServerEvents.CharacterSpawned:Fire(player, character)
end

--- Gere un deces : attribution de l'elimination puis file de reapparition.
function PlayerService.HandleDeath(player, character)
	if character:GetAttribute("DeathHandled") then
		return
	end
	character:SetAttribute("DeathHandled", true)

	local killer = nil
	local attackerId = character:GetAttribute("LastAttackerUserId")
	local attackerAt = character:GetAttribute("LastAttackerAt")
	-- On n'attribue l'elimination que si le dernier coup est recent (10 s).
	if type(attackerId) == "number" and type(attackerAt) == "number" and now() - attackerAt < 10 then
		local candidate = Players:GetPlayerByUserId(attackerId)
		if candidate and candidate ~= player then
			killer = candidate
		end
	end
	local weaponId = character:GetAttribute("LastWeaponId")

	ServerEvents.PlayerKilled:Fire(player, killer, type(weaponId) == "string" and weaponId or nil)

	if respawnEnabled then
		pendingRespawn[player] = now() + GameConfig.RespawnTime
		Net.Event("Notify"):FireClient(player, string.format("Reapparition dans %d s", GameConfig.RespawnTime), "info")
	end
end

function PlayerService.SetRespawnEnabled(enabled)
	respawnEnabled = enabled
	if not enabled then
		table.clear(pendingRespawn)
	end
end

--- Fait apparaitre tout le monde (debut de manche).
function PlayerService.SpawnAll()
	spawnCounters.Blue = 0
	spawnCounters.Red = 0
	spawnCounters.FFA = 0
	for _, player in ipairs(Players:GetPlayers()) do
		task.spawn(PlayerService.Spawn, player)
	end
end

--- Renvoie tout le monde au vestiaire (fin de manche).
function PlayerService.DespawnAll()
	table.clear(pendingRespawn)
	for _, player in ipairs(Players:GetPlayers()) do
		WeaponService.ClearTools(player)
		if player.Character then
			local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
			if humanoid then
				humanoid.WalkSpeed = GameConfig.WalkSpeed
			end
		end
	end
end

-- ------------------------------------------------------- boucle par frame

local function updateCharacter(player, deltaTime)
	local character = player.Character
	if not character then
		return
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local root = character:FindFirstChild("HumanoidRootPart")
	if not humanoid or not root or humanoid.Health <= 0 then
		return
	end
	local rootPart = root :: BasePart
	local currentTime = now()

	-- ------------------------------------------------------- endurance
	local stamina = character:GetAttribute("Stamina")
	if type(stamina) ~= "number" then
		stamina = GameConfig.StaminaMax
	end
	local wantsSprint = sprinting[player] == true
	local moving = rootPart.AssemblyLinearVelocity.Magnitude > 4
	local isSprinting = wantsSprint and moving and stamina > 0

	if isSprinting then
		stamina = math.max(0, stamina - GameConfig.StaminaDrain * deltaTime)
		if stamina <= 0 then
			sprinting[player] = false
		end
	else
		stamina = math.min(GameConfig.StaminaMax, stamina + GameConfig.StaminaRegen * deltaTime)
	end
	character:SetAttribute("Stamina", stamina)

	-- ------------------------------------------------ vitesse effective
	local weapon = WeaponService.GetEquipped(player)
	local base = isSprinting and GameConfig.SprintSpeed or GameConfig.WalkSpeed
	if weapon then
		base = base * weapon.walkSpeedMul
	end
	character:SetAttribute("BaseWalkSpeed", base)

	local multiplier = 1
	local slowUntil = character:GetAttribute("SlowUntil")
	if type(slowUntil) == "number" and slowUntil > currentTime then
		local factor = character:GetAttribute("SlowFactor")
		multiplier = multiplier * (type(factor) == "number" and factor or 1)
	end
	local speedUntil = character:GetAttribute("SpeedBoostUntil")
	if type(speedUntil) == "number" and speedUntil > currentTime then
		multiplier = multiplier * GameConfig.PowerupSpeedMultiplier
	end
	humanoid.WalkSpeed = base * multiplier

	-- ------------------------------------------------- regeneration
	local lastHit = character:GetAttribute("LastHitAt")
	if type(lastHit) == "number" and currentTime - lastHit > GameConfig.RegenDelay then
		if humanoid.Health < humanoid.MaxHealth then
			humanoid.Health = math.min(humanoid.MaxHealth, humanoid.Health + GameConfig.RegenRate * deltaTime)
		end
	end

	-- --------------------------------------------------------- chute
	if rootPart.Position.Y < MapService.GetKillY() then
		humanoid.Health = 0
	end
end

local function updateRefills(deltaTime)
	local stations = MapService.GetRefillStations()
	if #stations == 0 then
		return
	end
	for _, player in ipairs(Players:GetPlayers()) do
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if root and humanoid and humanoid.Health > 0 then
			local position = (root :: BasePart).Position
			for _, station in ipairs(stations) do
				if (position - station.position).Magnitude <= GameConfig.RefillRadius then
					WeaponService.AddWater(player, GameConfig.RefillRate * deltaTime)
					humanoid.Health = math.min(
						humanoid.MaxHealth,
						humanoid.Health + GameConfig.RefillHealRate * deltaTime
					)
					break
				end
			end
		end
	end
end

local function step(deltaTime)
	local currentTime = now()
	for _, player in ipairs(Players:GetPlayers()) do
		updateCharacter(player, deltaTime)
	end

	refillAccumulator = refillAccumulator + deltaTime
	if refillAccumulator >= 0.2 then
		updateRefills(refillAccumulator)
		refillAccumulator = 0
	end

	for player, readyAt in pairs(pendingRespawn) do
		if currentTime >= readyAt then
			pendingRespawn[player] = nil
			if respawnEnabled and player.Parent then
				task.spawn(PlayerService.Spawn, player)
			end
		end
	end
end

function PlayerService.Start()
	Players.CharacterAutoLoads = false

	Net.Event("SetSprint").OnServerEvent:Connect(function(player, wants)
		sprinting[player] = wants == true
	end)

	Players.PlayerRemoving:Connect(function(player)
		sprinting[player] = nil
		pendingRespawn[player] = nil
	end)

	RunService.Heartbeat:Connect(function(deltaTime)
		local ok, err = pcall(step, math.min(deltaTime, 0.25))
		if not ok then
			warn("[WaterWars] Erreur de mise a jour joueur : " .. tostring(err))
		end
	end)
end

return PlayerService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="34">
        <Properties>
          <string name="Name">ServerEvents</string>
          <string name="Source"><![CDATA[--[[
	ServerEvents
	Bus d'evenements interne au serveur. Il evite les dependances circulaires
	entre les services : personne n'a besoin de connaitre MatchService pour lui
	signaler une elimination.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("WaterWars"):WaitForChild("Shared")
local Signal = require(Shared:WaitForChild("Signal"))

local ServerEvents = {}

-- (victime, tueur | nil, arme | nil)
ServerEvents.PlayerKilled = Signal.new("PlayerKilled")
-- (victime, attaquant | nil, degats, estTeteTouchee)
ServerEvents.PlayerDamaged = Signal.new("PlayerDamaged")
-- (joueur, personnage)
ServerEvents.CharacterSpawned = Signal.new("CharacterSpawned")
-- (map, mode)
ServerEvents.RoundStarted = Signal.new("RoundStarted")
-- (resultat)
ServerEvents.RoundEnded = Signal.new("RoundEnded")
-- (joueur, points)
ServerEvents.ScoreChanged = Signal.new("ScoreChanged")

return ServerEvents
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="35">
        <Properties>
          <string name="Name">TeamService</string>
          <string name="Source"><![CDATA[--[[
	TeamService
	Creation des equipes et repartition equilibree des 20 joueurs.
	En mode "chacun pour soi" les equipes sont videes et tout le monde devient
	neutre, ce qui desactive automatiquement la protection alliee.
]]

local Players = game:GetService("Players")
local Teams = game:GetService("Teams")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local WaterWars = ReplicatedStorage:WaitForChild("WaterWars")
local GameConfig = require(WaterWars:WaitForChild("Config"):WaitForChild("GameConfig"))

local TeamService = {}

local teamInstances = {}
local teamEnabled = true

function TeamService.Start()
	for _, definition in ipairs(GameConfig.Teams) do
		local existing = Teams:FindFirstChild(definition.name)
		local team
		if existing and existing:IsA("Team") then
			team = existing
		else
			team = Instance.new("Team")
			team.Name = definition.name
			team.Parent = Teams
		end
		team.TeamColor = definition.brickColor
		team.AutoAssignable = false
		teamInstances[definition.id] = team
	end
end

function TeamService.GetTeam(teamId)
	return teamInstances[teamId]
end

--- Identifiant logique ("Blue" / "Red") de l'equipe d'un joueur, ou nil.
function TeamService.GetTeamId(player)
	if player.Neutral or not player.Team then
		return nil
	end
	for id, team in pairs(teamInstances) do
		if team == player.Team then
			return id
		end
	end
	return nil
end

function TeamService.CountPlayers(teamId)
	local team = teamInstances[teamId]
	if not team then
		return 0
	end
	local count = 0
	for _, player in ipairs(Players:GetPlayers()) do
		if player.Team == team then
			count = count + 1
		end
	end
	return count
end

--- Place un joueur dans l'equipe la moins remplie.
function TeamService.Assign(player)
	if not teamEnabled then
		player.Neutral = true
		player.Team = nil
		return nil
	end
	local bestId, bestCount = nil, math.huge
	for _, definition in ipairs(GameConfig.Teams) do
		local count = TeamService.CountPlayers(definition.id)
		if count < bestCount then
			bestId, bestCount = definition.id, count
		end
	end
	if bestId then
		player.Neutral = false
		player.Team = teamInstances[bestId]
	end
	return bestId
end

--- Active ou desactive le jeu en equipes (selon le mode de la manche).
function TeamService.SetTeamMode(enabled)
	teamEnabled = enabled
	if not enabled then
		for _, player in ipairs(Players:GetPlayers()) do
			player.Neutral = true
			player.Team = nil
		end
		return
	end
	-- Reequilibrage complet : on vide puis on redistribue en alternance.
	local players = Players:GetPlayers()
	table.sort(players, function(a, b)
		return a.UserId < b.UserId
	end)
	for index, player in ipairs(players) do
		local definition = GameConfig.Teams[((index - 1) % #GameConfig.Teams) + 1]
		player.Neutral = false
		player.Team = teamInstances[definition.id]
	end
end

--- true si `a` et `b` sont dans la meme equipe (jamais en mode neutre).
function TeamService.AreAllies(a, b)
	if not teamEnabled then
		return false
	end
	if a == b then
		return true
	end
	local teamA = TeamService.GetTeamId(a)
	local teamB = TeamService.GetTeamId(b)
	return teamA ~= nil and teamA == teamB
end

function TeamService.IsTeamMode()
	return teamEnabled
end

function TeamService.GetTeamColor(teamId)
	for _, definition in ipairs(GameConfig.Teams) do
		if definition.id == teamId then
			return definition.color
		end
	end
	return Color3.fromRGB(200, 200, 200)
end

return TeamService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="36">
        <Properties>
          <string name="Name">WeaponService</string>
          <string name="Source"><![CDATA[--[[
	WeaponService
	Fabrique les 25 armes sous forme de Tool entierement procedural (aucun
	asset a uploader), distribue l'equipement et fait autorite sur les
	munitions : reservoir, cadence et rechargement sont valides cote serveur.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local WaterWars = ReplicatedStorage:WaitForChild("WaterWars")
local Config = WaterWars:WaitForChild("Config")
local Shared = WaterWars:WaitForChild("Shared")

local GameConfig = require(Config:WaitForChild("GameConfig"))
local Weapons = require(Config:WaitForChild("Weapons"))
local Net = require(Shared:WaitForChild("Net"))

local DataService = require(script.Parent:WaitForChild("DataService"))

local WeaponService = {}

-- ammoState[player] = { [weaponId] = { ammo, reloading, lastShot, reloadToken } }
local ammoState = {}

-- ------------------------------------------------------------------ modele

local function weld(part, handle)
	local constraint = Instance.new("WeldConstraint")
	constraint.Part0 = handle
	constraint.Part1 = part
	constraint.Parent = part
end

local function makePart(name, size, cframe, color, material, parent)
	local part = Instance.new("Part")
	part.Name = name
	part.Size = size
	part.CFrame = cframe
	part.Color = color
	part.Material = material
	part.Anchored = false
	part.CanCollide = false
	part.CanQuery = false
	part.Massless = true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Parent = parent
	return part
end

--- Assemble le modele 3D d'une arme a partir de ses dimensions.
function WeaponService.BuildTool(weapon)
	local model = weapon.model
	local barrelLength = model.barrel
	local thickness = model.thick
	local tankScale = model.tank

	local tool = Instance.new("Tool")
	tool.Name = weapon.name
	tool.RequiresHandle = true
	tool.CanBeDropped = false
	tool.ToolTip = weapon.desc
	tool:SetAttribute("WeaponId", weapon.id)
	tool:SetAttribute("Category", weapon.category)
	-- Position de l'arme dans la main droite.
	tool.Grip = CFrame.new(0, -0.25, 0.35) * CFrame.Angles(math.rad(-6), 0, 0)

	-- La poignee : c'est elle qui est tenue par le personnage.
	local handle = Instance.new("Part")
	handle.Name = "Handle"
	handle.Size = Vector3.new(thickness * 1.1, 1.5, thickness * 1.2)
	handle.CFrame = CFrame.new(0, 0, 0)
	handle.Color = Color3.fromRGB(45, 48, 56)
	handle.Material = Enum.Material.SmoothPlastic
	handle.Anchored = false
	handle.CanCollide = false
	handle.CanQuery = false
	handle.Massless = true
	handle.TopSurface = Enum.SurfaceType.Smooth
	handle.BottomSurface = Enum.SurfaceType.Smooth
	handle.Parent = tool

	-- Corps principal, aligne sur -Z (la direction dans laquelle l'arme pointe).
	local body = makePart(
		"Body",
		Vector3.new(thickness * 1.25, thickness * 1.35, barrelLength * 0.62),
		CFrame.new(0, 0.95, -barrelLength * 0.2),
		weapon.color,
		Enum.Material.SmoothPlastic,
		tool
	)
	weld(body, handle)

	-- Canon.
	local barrel = makePart(
		"Barrel",
		Vector3.new(barrelLength * 0.78, thickness * 0.78, thickness * 0.78),
		CFrame.new(0, 1.0, -barrelLength * 0.62) * CFrame.Angles(0, math.rad(90), math.rad(90)),
		weapon.accent,
		Enum.Material.Metal,
		tool
	)
	barrel.Shape = Enum.PartType.Cylinder
	weld(barrel, handle)

	-- Buse lumineuse : repere visuel de la sortie d'eau.
	local nozzle = makePart(
		"Nozzle",
		Vector3.new(thickness * 0.5, thickness * 0.95, thickness * 0.95),
		CFrame.new(0, 1.0, -barrelLength * 1.0) * CFrame.Angles(0, math.rad(90), math.rad(90)),
		weapon.trail,
		Enum.Material.Neon,
		tool
	)
	nozzle.Shape = Enum.PartType.Cylinder
	nozzle.CastShadow = false
	weld(nozzle, handle)

	-- Reservoir d'eau, monte sur le dessus.
	local tank = makePart(
		"Tank",
		Vector3.new(barrelLength * 0.42 * tankScale, thickness * 1.5 * tankScale, thickness * 1.5 * tankScale),
		CFrame.new(0, 1.05 + thickness * 1.1, barrelLength * 0.12) * CFrame.Angles(0, math.rad(90), math.rad(90)),
		Color3.fromRGB(150, 225, 255),
		Enum.Material.Glass,
		tool
	)
	tank.Shape = Enum.PartType.Cylinder
	tank.Transparency = 0.35
	weld(tank, handle)

	local water = makePart(
		"TankWater",
		Vector3.new(barrelLength * 0.38 * tankScale, thickness * 1.15 * tankScale, thickness * 1.15 * tankScale),
		tank.CFrame,
		Color3.fromRGB(60, 170, 235),
		Enum.Material.SmoothPlastic,
		tool
	)
	water.Shape = Enum.PartType.Cylinder
	water.Transparency = 0.15
	weld(water, handle)

	-- Garde et crosse pour donner du volume.
	local guard = makePart(
		"Guard",
		Vector3.new(thickness * 0.4, 0.55, thickness * 1.3),
		CFrame.new(0, 0.35, -thickness * 0.5),
		Color3.fromRGB(38, 40, 48),
		Enum.Material.SmoothPlastic,
		tool
	)
	weld(guard, handle)

	if weapon.category == "Sniper" then
		local scope = makePart(
			"Scope",
			Vector3.new(barrelLength * 0.3, thickness * 0.55, thickness * 0.55),
			CFrame.new(0, 1.05 + thickness * 1.9, -barrelLength * 0.1) * CFrame.Angles(0, math.rad(90), math.rad(90)),
			Color3.fromRGB(28, 30, 36),
			Enum.Material.Metal,
			tool
		)
		scope.Shape = Enum.PartType.Cylinder
		weld(scope, handle)
	elseif weapon.category == "Heavy" then
		local shroud = makePart(
			"Shroud",
			Vector3.new(thickness * 1.9, thickness * 1.9, barrelLength * 0.35),
			CFrame.new(0, 1.0, -barrelLength * 0.5),
			Color3.fromRGB(70, 74, 84),
			Enum.Material.DiamondPlate,
			tool
		)
		weld(shroud, handle)
	elseif weapon.category == "Launcher" then
		local drum = makePart(
			"Drum",
			Vector3.new(thickness * 1.6, thickness * 2.1, thickness * 2.1),
			CFrame.new(0, 1.0, barrelLength * 0.05) * CFrame.Angles(0, math.rad(90), math.rad(90)),
			weapon.color,
			Enum.Material.SmoothPlastic,
			tool
		)
		drum.Shape = Enum.PartType.Cylinder
		weld(drum, handle)
	end

	-- Point de sortie des projectiles, lu par le client pour les effets.
	local muzzle = Instance.new("Attachment")
	muzzle.Name = "Muzzle"
	muzzle.CFrame = CFrame.new(0, 1.0, -barrelLength * 1.05)
	muzzle.Parent = handle

	return tool
end

-- ----------------------------------------------------------------- etat

local function stateFor(player)
	local state = ammoState[player]
	if not state then
		state = {}
		ammoState[player] = state
	end
	return state
end

local function entryFor(player, weapon)
	local state = stateFor(player)
	local entry = state[weapon.id]
	if not entry then
		entry = { ammo = weapon.tankSize, reloading = false, lastShot = 0, reloadToken = 0 }
		state[weapon.id] = entry
	end
	return entry
end

--- Envoie l'etat des munitions de l'arme tenue au client.
function WeaponService.PushAmmo(player)
	local weapon = WeaponService.GetEquipped(player)
	if not weapon then
		Net.Event("AmmoUpdate"):FireClient(player, nil, 0, 0, false)
		return
	end
	local entry = entryFor(player, weapon)
	Net.Event("AmmoUpdate"):FireClient(player, weapon.id, entry.ammo, weapon.tankSize, entry.reloading)
end

--- Arme actuellement tenue par le joueur, ou nil.
function WeaponService.GetEquipped(player)
	local character = player.Character
	if not character then
		return nil
	end
	local tool = character:FindFirstChildOfClass("Tool")
	if not tool then
		return nil
	end
	local id = tool:GetAttribute("WeaponId")
	if type(id) ~= "string" then
		return nil
	end
	return Weapons.Get(id)
end

function WeaponService.GetAmmo(player, weapon)
	return entryFor(player, weapon).ammo
end

function WeaponService.IsReloading(player, weapon)
	return entryFor(player, weapon).reloading
end

--- Lance un rechargement. Renvoie true s'il a effectivement demarre.
function WeaponService.Reload(player, weapon)
	local entry = entryFor(player, weapon)
	if entry.reloading or entry.ammo >= weapon.tankSize then
		return false
	end
	entry.reloading = true
	entry.reloadToken = entry.reloadToken + 1
	local token = entry.reloadToken
	WeaponService.PushAmmo(player)

	task.delay(weapon.reloadTime, function()
		-- Un changement d'arme ou une mort annule le rechargement en cours.
		if entry.reloadToken ~= token then
			return
		end
		entry.reloading = false
		entry.ammo = weapon.tankSize
		if player.Parent then
			WeaponService.PushAmmo(player)
		end
	end)
	return true
end

--- Verifie cadence + munitions et consomme l'eau. Renvoie (autorise, raison).
function WeaponService.TryConsume(player, weapon)
	local entry = entryFor(player, weapon)
	if entry.reloading then
		return false, "reloading"
	end

	local now = os.clock()
	local minimumDelay = (1 / weapon.fireRate) * GameConfig.FireRateTolerance
	if now - entry.lastShot < minimumDelay then
		return false, "ratelimit"
	end

	local cost = weapon.tankCost * weapon.burst
	if entry.ammo < cost then
		WeaponService.Reload(player, weapon)
		return false, "empty"
	end

	entry.lastShot = now
	entry.ammo = entry.ammo - cost
	if entry.ammo < cost then
		-- Rechargement automatique des que le reservoir ne suffit plus.
		WeaponService.Reload(player, weapon)
	else
		WeaponService.PushAmmo(player)
	end
	return true, nil
end

--- Remet tous les reservoirs a plein (apparition, station de recharge).
function WeaponService.RefillAll(player)
	local state = stateFor(player)
	for id, entry in pairs(state) do
		local weapon = Weapons.Get(id)
		if weapon then
			entry.ammo = weapon.tankSize
			entry.reloading = false
			entry.reloadToken = entry.reloadToken + 1
		end
	end
	WeaponService.PushAmmo(player)
end

--- Recharge progressive pres d'une station. Renvoie true si de l'eau a ete ajoutee.
function WeaponService.AddWater(player, amount)
	local weapon = WeaponService.GetEquipped(player)
	if not weapon then
		return false
	end
	local entry = entryFor(player, weapon)
	if entry.ammo >= weapon.tankSize then
		return false
	end
	entry.ammo = math.min(weapon.tankSize, entry.ammo + amount)
	entry.reloading = false
	entry.reloadToken = entry.reloadToken + 1
	WeaponService.PushAmmo(player)
	return true
end

--- Vide le sac et la main du joueur.
function WeaponService.ClearTools(player)
	local backpack = player:FindFirstChildOfClass("Backpack")
	if backpack then
		for _, child in ipairs(backpack:GetChildren()) do
			if child:IsA("Tool") then
				child:Destroy()
			end
		end
	end
	local character = player.Character
	if character then
		for _, child in ipairs(character:GetChildren()) do
			if child:IsA("Tool") then
				child:Destroy()
			end
		end
	end
end

--- Donne au joueur les deux armes de son equipement et remplit les reservoirs.
function WeaponService.GiveLoadout(player)
	local profile = DataService.Get(player)
	local backpack = player:FindFirstChildOfClass("Backpack")
	if not profile or not backpack then
		return
	end

	WeaponService.ClearTools(player)
	ammoState[player] = {}

	local order = { profile.loadout.primary, profile.loadout.secondary }
	local firstTool = nil
	for _, id in ipairs(order) do
		local weapon = Weapons.Get(id)
		if weapon then
			local tool = WeaponService.BuildTool(weapon)
			tool.Parent = backpack
			entryFor(player, weapon)
			if not firstTool then
				firstTool = tool
			end
		end
	end

	-- L'arme principale est mise en main : le joueur peut tirer immediatement.
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if firstTool and humanoid and humanoid.Health > 0 then
		humanoid:EquipTool(firstTool)
	end

	WeaponService.PushAmmo(player)
end

function WeaponService.Start()
	Net.Event("RequestReload").OnServerEvent:Connect(function(player)
		local weapon = WeaponService.GetEquipped(player)
		if weapon then
			WeaponService.Reload(player, weapon)
		end
	end)

	Net.Event("RequestEquip").OnServerEvent:Connect(function(player, slot, weaponId)
		if type(slot) ~= "string" or type(weaponId) ~= "string" then
			return
		end
		local success, message = DataService.SetLoadout(player, slot, weaponId)
		Net.Event("Notify"):FireClient(player, message, success and "good" or "bad")
		if success then
			-- Applique immediatement si le joueur est vivant.
			local character = player.Character
			local humanoid = character and character:FindFirstChildOfClass("Humanoid")
			if humanoid and humanoid.Health > 0 then
				WeaponService.GiveLoadout(player)
			end
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		ammoState[player] = nil
	end)
end

return WeaponService
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
</roblox>