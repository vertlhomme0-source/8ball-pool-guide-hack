# Copier ce fichier en ".env" puis remplir les valeurs.

# --- Application ---
SECRET_KEY=change-moi-par-une-longue-chaine-aleatoire
DATABASE_PATH=heures.db
TIMEZONE=America/Toronto
COMPANY_NAME=Mon Entreprise

# --- Rapport automatique ---
# Heure d'envoi quotidienne (HH:MM, fuseau TIMEZONE)
REPORT_TIME=18:00
# Destinataire(s) du rapport, séparés par des virgules
REPORT_RECIPIENTS=vous@exemple.com
# Mettre à false pour désactiver l'envoi automatique
SCHEDULER_ENABLED=true

# --- Serveur SMTP (exemple Gmail : utiliser un "mot de passe d'application") ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=vous@gmail.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx
SMTP_USE_TLS=true
SMTP_FROM=Suivi des heures <vous@gmail.com>
